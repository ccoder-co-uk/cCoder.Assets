 solid 1px #ccc; }\n\t[name=newFundingRequestDialog] \u003E .value \u003E button { float: right; margin: 8px 10px; }\n\t.k-grid-content { overflow-x: hidden; }\n\t.company { min-width: 150px; }\n\t.fundingType {min-width: 150px; }\n\u003C/style\u003E",
