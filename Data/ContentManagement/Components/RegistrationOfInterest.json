  "Script": "api.addToMetaCache([\r\n    {\r\n        Name: \u0022AppSecurity\u0022,\r\n        Types: [\r\n            [meta[AppSecurity/User]]\r\n        ]\r\n    },\r\n    {\r\n        Name: \u0022ContentManagement\u0022,\r\n        Types: [\r\n            [meta[ContentManagement/Submission]]\r\n        ]\r\n    }\r\n]);\r\nRegistrationOfInterest = {\n\tstates: {\n\t\t\u0022New\u0022: \u0022[resource_displayname[New]]\u0022,\n\t\t\u0022Rejected\u0022: \u0022[resource_displayname[rejected]]\u0022,\n\t\t\u0022AdminRejected\u0022: \u0022[resource_displayname[adminRejected]]\u0022,\n\t\t\u0022Accepted\u0022: \u0022[resource_displayname[accepted]]\u0022\n\t},\n\n\tinit: async function (app, container) {\n\t\tvar meta = [\n\t\t\t{\n\t\t\t\t\u0022Name\u0022: \u0022Core\u0022,\n\t\t\t\t\u0022Types\u0022: [\n\t\t\t\t\t[meta[ContentManagement/Submission]]\n\t\t\t\t]\n\t\t\t}\n\t\t];\n\t\tvar config = { endpoint: \u0022ContentManagement/Submission\u0022, odataAppend: \u0022?$filter=SourceComponent eq \u0027RegistrationOfInterest\u0027  and CreatedBy eq \u0027\u0022 \u002B session.user \u002B \u0022\u0027 and AppId eq \u0022 \u002B app.Id };\n\t\tvar ds = await model.getDatasource(config);\n\t\tvar roiGrid = await [script[RoiGrid]]({element: $(\u0022[name=roiGrid]\u0022, container), data: ds});\n\t\tawait roiGrid.init();\n\t\t$(\u0022[name=addROI]\u0022).on(\u0022click\u0022, function (e) { e.preventDefault(); RegistrationOfInterest.createROI(container, roiGrid, app); });\n\t},\n\n\tcreateROI: async function (container, widget, app) {\n\t\tvar d = new Dialog({ title: \u0022[resource_displayname[newAccessRequest]]\u0022, width: 1000 });\n\t\tvar user = await api.get(\u0022AppSecurity/User/Me()\u0022);\n\t\tvar model = kendo.observable({\n\t\t\t0: {firstname: user.DisplayName. split(\u0027 \u0027)[0], lastname:user.DisplayName.split(\u0027 \u0027)[user.DisplayName.split(\u0027 \u0027).length - 1], email: user.Email, phone: null, jobtitle: null},\n\t\t\t1: {company: null, requestType: null, reference: null, contactName: null, contactEmail: null, contactPhone: null},\n\t\t\t2: {signatoryName: null, signatoryPosition: null, signarotyPhone: null, bankName: null, accountNo: null, sortCode: null},\n\t\t\t3: {signature: null, ident1: null, ident2: null, accounts: null, shareholderDetails: null, associationDetails: null, contract: null}\n\t\t});\n\t\td.template = \u0022\u003Cdiv name=\u0027newFundingRequestDialog\u0027\u003E\u0022 \u002B $(\u0022script[name=createRequest]\u0022, container).html() \u002B \u0022\u003C/div\u003E\u0022;\n\t\td.events.save = async function (e) {\n\t\t\tvar items = JSON.parse(JSON.stringify(model));\n\t\t\tvar submission = { SourceComponent: \u0022RegistrationOfInterest\u0022, State: \u0022New\u0022, DataJson: JSON.stringify({ \u0022fields\u0022: items }), AppId: app.Id };\n\t\t\tawait api.add(\u0022ContentManagement/Submission\u0022, submission);\n\t\t\tnotification.success(\u0022[resource_displayname[SubmissionSubmitted]]\u0022);\n\t\t\twidget.kendoObject.dataSource.read();\n\t\t\twidget.kendoObject.refresh();\n\t\t\td.events.close();\n\t\t};\n\t\td.init(async () =\u003E {\n\t\t\tvar dialog = d.element;\n\t\t\tawait api.get(\u0022B2B/Country\u0022).then((countries) =\u003E {\n\t\t\t\t$(\u0022input[name=country]\u0022, dialog).kendoDropDownList({\n\t\t\t\t\tdataSource: countries.value,\n\t\t\t\t\tdataValueField: \u0022Id\u0022,\n\t\t\t\t\tdataTextField: \u0022Name\u0022\n\t\t\t\t});\n\t\t\t});\n\t\t\t$(\u0022select\u0022, dialog).kendoDropDownList();\n\t\t\tkendo.bind(dialog, model);\n\t\t\t$(\u0022.partsList \u003E ul \u003E li\u0022, dialog).on(\u0022click\u0022, function(e) {\n\t\t\t\t$(\u0022.partsList \u003E ul \u003E li\u0022, dialog).removeClass(\u0022selected\u0022);\n\t\t\t\t$(\u0022.container\u0022, dialog).css(\u0022display\u0022, \u0022none\u0022);\n\t\t\t\t$(\u0022.container[name=\u0022 \u002B $(e.target).attr(\u0022data-container\u0022) \u002B \u0022]\u0022).css(\u0022display\u0022, \u0022inline-block\u0022);\n\t\t\t\t$(e.target).addClass(\u0022selected\u0022);\n\t\t\t});\n\t\t});\n\t}\n};",
  "Content": "\u003Ch3\u003E[resource_displayname[RegistrationOfInterest]]\u003C/h3\u003E\n\u003Cdiv name=\u0022roiGrid\u0022 role=\u0022ROIGrid\u0022\u003E\u003C/div\u003E\n\n\u003Cscript name=\u0022createRequest\u0022 type=\u0022template/text\u0022\u003E\n\u003Cdiv class=\u0022partsList\u0022\u003E\n\t\u003Cul\u003E\n\t\t\u003Cli class=\u0022selected\u0022 data-container=\u0022contactInfo\u0022\u003E[resource_displayname[contactInfo]]\u003C/li\u003E\n\t\t\u003Cli data-container=\u0022fundingNeeded\u0022\u003E[resource_displayname[fundingNeed]]\u003C/li\u003E\n\t\t\u003Cli data-container=\u0022auth\u0022\u003E[resource_displayname[Authorisation]]\u003C/li\u003E\n\t\t\u003Cli data-container=\u0022supportingDocs\u0022\u003E[resource_displayname[supportingdocs]]\u003C/li\u003E\n\t\t\u003Cli data-container=\u0022disclaimer\u0022\u003E[resource_displayname[disclaimer]]\u003C/li\u003E\n\t\u003C/ul\u003E\n\u003C/div\u003E\n\u003Cdiv name=\u0022contactInfo\u0022 class=\u0022wizardPart\u0022\u003E\n\u003Cul class=\u0022fieldList\u0022\u003E\n   \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[firstname]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022firstname\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].firstname\u0022 /\u003E\u003C/div \u003E\n\t\u003C/li\u003E\n\t\u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[surname]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022surname\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].surname\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[email]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022email\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].email\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[phone]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022phone\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].phone\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[jobtitle]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022jobtitle\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].jobtitle\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n \u003C/ul\u003E\n\u003C/div\u003E\n \u003Cdiv name=\u0022fundingNeeded\u0022 class=\u0022wizardPart\u0022 style=\u0022display: none;\u0022\u003E\n \u003Cul class=\u0022fieldList\u0022\u003E\n    \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[company]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value company\u0022\u003E\n              \u003Cselect name=\u0022company\u0022 data-bind=\u0022value: [1].company\u0022\u003E\n                   \u003Coption\u003E[resource_displayname[pleaseSelect]]\n              \u003C/select\u003E\n         \u003C/div\u003E\n\t\u003C/li\u003E\n   \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[fundingType]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value fundingType\u0022\u003E\n              \u003Cselect name=\u0022requestType\u0022 data-bind=\u0022value: [1].requestType\u0022\u003E\n                   \u003Coption\u003ESystematic\u003C/option\u003E\n\t\t\t\t   \u003Coption\u003EA La carte\u003C/option\u003E\n              \u003C/select\u003E\n         \u003C/div\u003E\n\t\u003C/li\u003E\n\t\u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[reference]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022reference\u0022 type=\u0022text\u0022 data-bind=\u0022value: [1].reference\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n         \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactname]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022contactName\u0022 type=\u0022text\u0022 data-bind=\u0022value: [1].contactName\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactEmail]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022contactEmail\u0022 type=\u0022text\u0022 data-bind=\u0022value: [1].contactEmail\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactPhone]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022contactPhone\u0022 type=\u0022text\u0022 data-bind=\u0022value: [1].contactPhone\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n \u003C/ul\u003E\n \u003C/div\u003E\n \u003Cdiv name=\u0022auth\u0022 class=\u0022wizardPart\u0022 style=\u0022display: none;\u0022\u003E\n \u003Cul class=\u0022fieldList\u0022\u003E\n    \u003Cli\u003E\n\t\t\u003Clabel style=\u0022font-weight: bold;\u0022\u003E[resource_displayname[signatory]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n    \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[SignatoryName]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022signatoryName\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].signatoryName\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n   \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[signatoryPosition]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022signatoryPosition\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].signatoryPosition\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n\t\u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[signatoryPhone]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022signatoryPhone\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].signatoryPhone\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n\t\u003Cli\u003E\n\t\t\u003Clabel