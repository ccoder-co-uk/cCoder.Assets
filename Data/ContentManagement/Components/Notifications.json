{
  "Name": "Notifications",
  "Key": "Theming",
  "ResourceKey": "CMS",
  "Script": "Notifications = {\n    init: async function(app, container, observable) {\n        app = app || session.app;\n        container = container || $(\u0022.component[name=Notifications]\u0022);\n\n        if(!observable)\n            return;\n\n        kendo.bind(container, observable);\n\n        $(\u0022[name=notifications-picker]\u0022, container).kendoColorPicker({\n            buttons: false,\n            views: [\u0022gradient\u0022],\n            change: (e) =\u003E e.preventDefault()\n        });\n    }\n}",
  "Content": "\u003Cdiv class=\u0022row\u0022\u003E\n    \u003Cdiv class=\u0022col-md-6\u0022\u003E\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsErrorText]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: colours.primary\u0022 /\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsWarningText]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.warning.text\u0022 /\u003E\n        \u003C/div\u003E\n        \n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsInfoText]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.info.text\u0022 /\u003E\n        \u003C/div\u003E\n        \n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsSuccessText]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.success.text\u0022 /\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n    \u003Cdiv class=\u0022col-md-6\u0022\u003E\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsErrorBackground]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.error.background\u0022 /\u003E\n        \u003C/div\u003E\n        \n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsWarningBackground]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.warning.background\u0022 /\u003E\n        \u003C/div\u003E\n        \n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsInfoBackground]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.info.background\u0022 /\u003E\n        \u003C/div\u003E\n        \n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[notificationsSuccessBackground]]\u003C/span\u003E\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022notifications-picker\u0022 data-bind=\u0022value: notifications.success.background\u0022 /\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E",
