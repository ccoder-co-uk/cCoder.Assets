{
  "Name": "Colours",
  "Key": "Theming",
  "ResourceKey": "CMS",
  "Script": "Colours = {\r\n    init: async function(app, container, observable) {\r\n        app = app || session.app;\r\n        container = container || $(\u0022.component[name=Colours]\u0022);\r\n        if(!observable)\r\n            return;\r\n        \r\n        $(\u0022[name=picker]\u0022, container).kendoColorPicker({\r\n            buttons: false,\r\n            views: [\u0022gradient\u0022],\r\n            change: (e) =\u003E e.preventDefault()\r\n        });\r\n\r\n        $(\u0022[name=marginSlider]\u0022, container).kendoSlider({ \r\n            min: 0, \r\n            max: 20, \r\n            smallStep: 1, \r\n            largeStep: 2, \r\n            value: parseFloat((observable.get(\u0022colours.margins\u0022) || \u00224px\u0022).replaceAll(\u0022px\u0022, \u0022\u0022)),\r\n            change: function(e) {\r\n                e.preventDefault();\r\n                observable.set(\u0022colours.margins\u0022, this.value() \u002B \u0022px\u0022);\r\n            }\r\n        });\r\n    }\r\n}",
  "Content": "\u003Cdiv class=\u0022row\u0022\u003E\r\n    \u003Cdiv class=\u0022col-md-6\u0022\u003E\r\n        \u003Ch4\u003E[resource_displayname[baseColours]]\u003C/h4\u003E\r\n        \r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[primary]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.primary\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[secondary]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.secondary\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[background]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.background\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[text]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.text\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[text2]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.text2\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[links]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.links\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[margins]]\u003C/span\u003E\r\n            \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 name=\u0022marginSlider\u0022 /\u003E\r\n        \u003C/div\u003E\r\n    \u003C/div\u003E\r\n    \u003Cdiv class=\u0022col-md-6\u0022\u003E\r\n        \u003Ch4\u003E[resource_displayname[chartColours]]\u003C/h4\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[colourone]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[0]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[colourtwo]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[1]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[colourthree]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[2]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[colourfour]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[3]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\t\t\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[colourfive]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[4]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n\r\n        \u003Cdiv class=\u0022input-group input-group-sm mb-1\u0022\u003E\r\n            \u003Cspan class=\u0022input-group-text\u0022\u003E[resource_displayname[coloursix]]\u003C/span\u003E\r\n            \u003Cinput class=\u0022form-control\u0022 name=\u0022picker\u0022 data-bind=\u0022value: colours.charts[5]\u0022 /\u003E\r\n        \u003C/div\u003E\r\n    \u003C/div\u003E\r\n\u003C/div\u003E",
