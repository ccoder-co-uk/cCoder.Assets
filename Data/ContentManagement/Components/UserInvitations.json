{
  "Name": "UserInvitations",
  "Key": "B2B Admin",
  "ResourceKey": "B2B",
  "Script": "UserInvitations = {\n    init: async function (app, container) {\n\t\tapp = app || session.app;\n        \n        api.addToMetaCache([\n            {\n                \u0022Name\u0022: \u0022B2B\u0022,\n                \u0022Types\u0022: [\n                    [meta[B2B/Company]]\n                ]\n            }\n        ]);\n\n\t\tcontainer = container || $(\u0022.component[name=UserInvitations]\u0022);\n        await this.initCompaniesGrid(app, container);\n\n        $(\u0027button[name=submitUserInvites]\u0027).on(\u0027click\u0027, await UserInvitations.sendUserInvites(app, container));\n    },\n\n    initCompaniesGrid: async function(app, container) {\n        var gridContainer = $(\u0027[name=companiesGridContainer\u0027, container);\n\n        var companiesDatasource = await model.getDatasource({\n            endpoint: \u0022B2B/Company\u0022,\n            odataAppend: \u0022?$filter=Buckets/any(b: startsWith(b/Bucket/Path, \u0027\u0022 \u002B app.Config.Deployment.TenantId \u002B \u0022/\u0027))\u0026$expand=Address,References,Buckets($expand=Bucket)\u0022,\n            sort: { field: \u0022Name\u0022, dir: \u0022asc\u0022}\n        });\n\n        var grid = new GridWidget(gridContainer, companiesDatasource);\n        grid.selectable = true;\n        grid.editable = false;\n        grid.searchable = true;\n\n        grid.search = {\n            fields: [\u0027Name\u0027]\n        };\n\n        grid.columns = [\n\t\t    { selectable: true, width: [theme[columns.checkbox]] },\n            { field: \u0022Name\u0022, title: \u0022[resource_displayname[name]]\u0022 },\n        ];\n\n        await grid.init();\n    },\n\n    sendUserInvites: async function(app, container) {\n\n    }\n}",
  "Content": "\u003Cdiv class=\u0022tab-control\u0022\u003E\n    \u003Cnav\u003E\n        \u003Cdiv class=\u0022nav nav-tabs\u0022 id=\u0022user-invitations-nav-tab\u0022 role=\u0022tablist\u0022\u003E\n            \u003Cbutton class=\u0022nav-link bg active\u0022 id=\u0022user-invitations-invite-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#user-invitations-invite\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022user-invitations-invite\u0022 aria-selected=\u0022true\u0022\u003E\n                \u003Cspan class=\u0022k-icon k-i-plus\u0022\u003E\u003C/span\u003E[resource_displayname[invite]]\n            \u003C/button\u003E\n            \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022user-invitations-pending-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#user-invitations-pending\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022user-invitations-pending\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n                \u003Cspan class=\u0022k-icon k-i-user\u0022\u003E\u003C/span\u003E[resource_displayname[pending]]\n            \u003C/button\u003E\n        \u003C/div\u003E\n    \u003C/nav\u003E\n\n    \u003Cdiv class=\u0022tab-content\u0022 id=\u0022user-invitations-nav-tabContent\u0022\u003E\n        \u003Cdiv class=\u0022tab-pane fade active show\u0022 id=\u0022user-invitations-invite\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022user-invitations-config-tab\u0022 name=\u0022invite\u0022\u003E\n            \u003Ch2\u003E\n                [resource_displayname[inviteusers]]\n            \u003C/h2\u003E\n\n            \u003Cdiv class=\u0022row\u0022\u003E\n                \u003Cdiv class=\u0022col-md-9\u0022\u003E\n                    \u003Ch3\u003E\n                        [resource_displayname[useremailaddresses]]\n                    \u003C/h3\u003E\n                    \u003Cdiv class=\u0022form\u0022\u003E\n                        \u003Cdiv class=\u0022input-group\u0022\u003E\n                            \u003Ctextarea class=\u0022form-control\u0022 aria-label=\u0022[resource_displayname[useremailaddresses]]\u0022 rows=5\u003E\u003C/textarea\u003E\n                        \u003C/div\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n                \u003Cdiv class=\u0022col-md-3\u0022\u003E\n                    \u003Ch3\u003E\n                        [resource_displayname[selectperspective]]\n                    \u003C/h3\u003E\n                    \u003Cdiv class=\u0022form\u0022\u003E\n                        \u003Cdiv class=\u0022input-group\u0022\u003E\n                            \u003Cselect class=\u0022form-select\u0022 name=\u0022[resource_displayname[perspective]]\u0022\u003E\n                                \u003Coption selected disabled\u003EChoose...\u003C/option\u003E\n                                \u003Coption value=\u0022buyer\u0022\u003E[resource_displayname[buyer]]\u003C/option\u003E\n                                \u003Coption value=\u0022supplier\u0022\u003E[resource_displayname[supplier]]\u003C/option\u003E\n                                \u003Coption value=\u0022funder\u0022\u003E[resource_displayname[funder]]\u003C/option\u003E\n                            \u003C/select\u003E\n                        \u003C/div\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n                \u003Cdiv class=\u0022col-md-12\u0022\u003E\n                    \u003Ch3\u003E\n                        [resource_displayname[selectacompany]]\n                    \u003C/h3\u003E\n                    \u003Cdiv name=\u0022companiesGridContainer\u0022\u003E\u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022row\u0022\u003E\n                \u003Cdiv class=\u0022col-md-3 offset-md-9\u0022\u003E\n                    \u003Cdiv class=\u0022btn-group btn-group-sm float-end\u0022\u003E\n                        \u003Cbutton class=\u0022btn btn-primary\u0022 name=\u0022submitUserInvites\u0022\u003E\n                            \u003Cspan class=\u0022k-icon k-i-plus\u0022\u003E\u003C/span\u003E [resource_displayname[invite]]\n                        \u003C/button\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022user-invitations-pending\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022user-invitations-pending-tab\u0022 name=\u0022pending\u0022\u003E\n            // Current invite progress grid.\n        \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E",
