  "Script": "PasswordReset = {\n  init: async function (app, container) {\n    app = app || session.app;\n    container = container || $(\".component[name=PasswordReset]\");\n    $(\"button[name=submitReset]\", container).on(\"click\", async function (event) { event.preventDefault(); await PasswordReset.confirm(app, container); });\n  },\n  confirm: async function (app, container) {\n    var url = new URL(window.location.href);\n    var resetRequest = { UserId: url.searchParams.get(\"uid\"), NewPassword: $(\"input[name=pass]\", container).val(), ConfirmPassword: $(\"input[name=confirm]\", container).val(), Token: url.searchParams.get(\"token\"), SourceAppId: app.Id };\n    var result = await api.post(\"Account/ConfirmForgotPassword\", resetRequest);\n    if (!(result || result === \"\")) { notification.error(\"[resource_description[ResetFailed]]\"); return; }\n    notification.success(\"[resource_description[ResetSuccess]]\");\n    var loginResult = await api.login(resetRequest.UserId, resetRequest.NewPassword, true);\n    if (loginResult) { window.location.href = \"/\"; return; }\n    notification.error(\"[resource_description[ResetLoginFailed]]\");\n  }\n};\n$(function () { PasswordReset.init(); });\n",
  "Content": "<style>\n.component[name=PasswordReset]{height:auto;border:0;box-shadow:none;background:transparent}\n.component[name=PasswordReset] .ccoder-code-form{width:min(100%,720px);margin:20px auto;padding:28px;border:1px solid #cfdee8;border-left:4px solid #142a48;border-radius:4px;background:#f8fbfd;box-shadow:0 12px 30px rgba(20,42,72,.08);color:#142a48;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}\n.component[name=PasswordReset] .ccoder-code-line{margin:0 0 10px}\n.component[name=PasswordReset] .ccoder-code-indent{padding-left:20px}\n.component[name=PasswordReset] .ccoder-keyword{color:#075ccc}\n.component[name=PasswordReset] .ccoder-type{color:#008575}\n.component[name=PasswordReset] .ccoder-punctuation{color:#16a7e0}\n.component[name=PasswordReset] .ccoder-code-fields{display:grid;gap:12px;margin:14px 0;padding:0 0 0 20px;list-style:none}\n.component[name=PasswordReset] .ccoder-field{display:grid;grid-template-columns:10rem minmax(0,1fr);align-items:center;gap:12px}\n.component[name=PasswordReset] .form-control{width:100%;padding:9px 11px;border:1px solid #cfdee8;border-radius:2px;background:#fff}\n.component[name=PasswordReset] .ccoder-code-actions{display:flex;justify-content:flex-end;margin:20px 0 8px}\n.component[name=PasswordReset] .ccoder-code-actions .btn{font-family:inherit}\n@media(max-width:620px){.component[name=PasswordReset] .ccoder-code-form{padding:20px}.component[name=PasswordReset] .ccoder-field{grid-template-columns:1fr;gap:5px}.component[name=PasswordReset] .ccoder-code-indent{padding-left:12px}}\n</style>\n<form class=\"ccoder-code-form\" autocomplete=\"off\">\n  <div class=\"ccoder-code-line\"><span class=\"ccoder-keyword\">void</span> ResetPassword()</div>\n  <div class=\"ccoder-code-line ccoder-punctuation\">{</div>\n  <div class=\"ccoder-code-indent\">\n    <div class=\"ccoder-code-line\"><span class=\"ccoder-keyword\">var</span> details = <span class=\"ccoder-keyword\">new</span> <span class=\"ccoder-type\">PasswordResetDetails</span>()</div>\n    <div class=\"ccoder-code-line ccoder-punctuation\">{</div>\n    <ul class=\"ccoder-code-fields ccoder-code-indent\">\n      <li class=\"ccoder-field\"><label for=\"password-reset-new\">[resource_displayname[Password]] =</label><input id=\"password-reset-new\" type=\"password\" name=\"pass\" required autocomplete=\"new-password\" class=\"form-control\" /></li>\n      <li class=\"ccoder-field\"><label for=\"password-reset-confirm\">[resource_displayname[ConfirmPassword]] =</label><input id=\"password-reset-confirm\" type=\"password\" name=\"confirm\" required autocomplete=\"new-password\" class=\"form-control\" /></li>\n    </ul>\n    <div class=\"ccoder-code-line ccoder-punctuation\">};</div>\n    <div class=\"ccoder-code-actions\"><button name=\"submitReset\" type=\"submit\" class=\"btn btn-primary\"><span class=\"k-icon k-i-play\"></span> Submit(details);</button></div>\n  </div>\n  <div class=\"ccoder-code-line ccoder-punctuation\">}</div>\n</form>",
