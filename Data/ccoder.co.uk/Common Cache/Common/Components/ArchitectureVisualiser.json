{
  "Name": "ArchitectureVisualiser",
  "Key": "Common",
  "ResourceKey": "Common",
  "Script": "[script[ArchitectureVisualiser]]",
  "Content": "<style>\n.arch-viz{--av-ink:#14213d;--av-muted:#687386;--av-line:#d9e0e8;--av-soft:#f5f7fa;--av-accent:#e87524;--av-blue:#193b68;width:100%;min-width:0;padding:0;color:var(--av-ink)}\n.arch-viz *{box-sizing:border-box}.arch-viz h3,.arch-viz p{margin-top:0}\n.av-controls{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(240px,1.2fr) minmax(180px,.7fr) auto;gap:10px;padding:14px;background:#fff;border:1px solid var(--av-line);box-shadow:0 7px 22px rgba(20,33,61,.06)}\n.av-field{display:flex;flex-direction:column;gap:5px}.av-field label{font-size:.78rem;font-weight:700;color:var(--av-muted);text-transform:uppercase;letter-spacing:.04em}.av-field select,.av-field input{height:42px;width:100%;padding:0 11px;border:1px solid #c7cfda;background:#fff;color:var(--av-ink);font:inherit}\n.av-source{align-self:end;height:42px;padding:0 16px;border:0;background:var(--av-blue);color:#fff;font:inherit;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.av-source[aria-disabled=true]{pointer-events:none;opacity:.45}\n.av-status{min-height:28px;margin:12px 0 0;padding:5px 0;color:var(--av-muted)}.av-status.is-error{color:#a13224}.av-summary{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 14px}.av-badge{padding:5px 9px;background:#eaf0f7;color:var(--av-blue);font-size:.82rem;font-weight:700}\n.av-surface{position:relative;width:100%;height:clamp(520px,calc(100vh - 310px),900px);min-height:520px;overflow:auto;border:1px solid var(--av-line);background:linear-gradient(#eef2f6 1px,transparent 1px),linear-gradient(90deg,#eef2f6 1px,transparent 1px),#fff;background-size:24px 24px}\n.av-links{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:visible}.av-links path{fill:none;stroke:#8296aa;stroke-width:1.6;opacity:.62}.av-board{position:relative;z-index:2;min-width:100%;min-height:100%;padding:0}.av-column-head{position:absolute;top:12px;width:260px;padding:8px 10px;border-bottom:3px solid var(--av-blue);background:rgba(255,255,255,.94);color:var(--av-blue);font-size:.78rem;font-weight:800;letter-spacing:.045em;text-align:center;text-transform:uppercase}.av-column-head{position:absolute;top:12px;width:260px;padding:8px 10px;border-bottom:3px solid var(--av-blue);background:rgba(255,255,255,.94);color:var(--av-blue);font-size:.78rem;font-weight:800;letter-spacing:.045em;text-align:center;text-transform:uppercase}.av-column-head{position:absolute;top:12px;width:260px;padding:8px 10px;border-bottom:3px solid var(--av-blue);background:rgba(255,255,255,.94);color:var(--av-blue);font-size:.78rem;font-weight:800;letter-spacing:.045em;text-align:center;text-transform:uppercase}.av-column-head{position:absolute;top:12px;width:260px;padding:8px 10px;border-bottom:3px solid var(--av-blue);background:rgba(255,255,255,.94);color:var(--av-blue);font-size:.78rem;font-weight:800;letter-spacing:.045em;text-align:center;text-transform:uppercase}\n.av-lane{width:255px;background:rgba(245,247,250,.94);border:1px solid var(--av-line)}.av-lane-head{position:sticky;top:0;z-index:3;padding:10px 12px;background:var(--av-blue);color:#fff;display:flex;justify-content:space-between;gap:8px;font-weight:700}.av-nodes{padding:9px}\n.av-node{position:absolute;width:260px;height:64px;margin:0;padding:10px;overflow:hidden;border:1px solid #ccd5df;border-left:4px solid var(--av-accent);background:#fff;text-align:left;color:var(--av-ink);cursor:pointer;box-shadow:0 2px 6px rgba(20,33,61,.05)}.av-node:hover,.av-node:focus{outline:2px solid rgba(232,117,36,.3);border-color:var(--av-accent)}.av-node.is-related{background:#fff4ea;border-color:var(--av-accent)}.av-node.is-invalid{border-color:#b42318;border-left-color:#b42318;background:#fff8f7}.av-node.is-invalid:after{content:\"!\";position:absolute;right:7px;top:6px;width:18px;height:18px;border-radius:50%;background:#b42318;color:#fff;font-size:.72rem;font-weight:800;line-height:18px;text-align:center}.av-node.has-property-violation .av-node-meta{color:#b42318;font-weight:700}.av-node-name{display:block;font-weight:700;overflow-wrap:anywhere}.av-node-meta{display:block;margin-top:4px;color:var(--av-muted);font-size:.75rem;line-height:1.35}\n.av-empty{padding:52px 24px;text-align:center;color:var(--av-muted)}.av-details{margin-top:14px;padding:14px 16px;border:1px solid var(--av-line);background:#fff}.av-details h3{margin-bottom:5px;font-size:1rem}.av-details p{margin-bottom:0;color:var(--av-muted);overflow-wrap:anywhere}\n@media(max-width:900px){.arch-viz{padding:0}.av-controls{grid-template-columns:1fr 1fr}.av-source{width:100%}}@media(max-width:560px){.av-controls{grid-template-columns:1fr}}\n</style>\n<section class=\"arch-viz\" aria-label=\"Architecture Visualiser\">\n  <div class=\"av-controls\">\n    <div class=\"av-field\"><label for=\"av-repository\">Repository</label><select id=\"av-repository\" name=\"repository\"></select></div>\n    <div class=\"av-field\"><label for=\"av-project\">Project</label><select id=\"av-project\" name=\"project\"></select></div>\n    <div class=\"av-field\"><label for=\"av-filter\">Filter items</label><input id=\"av-filter\" name=\"filter\" type=\"search\" placeholder=\"Class or interface name\" /></div>\n    <button class=\"av-source\" name=\"load\" type=\"button\">Load diagram</button>\n  </div>\n  <div class=\"av-status\" name=\"status\" role=\"status\">Loading project catalogue…</div>\n  <div class=\"av-summary\" name=\"summary\" aria-label=\"Project summary\"></div>\n  <div class=\"av-surface\" name=\"surface\"><svg class=\"av-links\" name=\"links\" aria-hidden=\"true\"></svg><div class=\"av-board\" name=\"board\"><div class=\"av-empty\">Choose a project to map its architecture.</div></div></div>\n  <aside class=\"av-details\" name=\"details\" hidden><h3 name=\"detailName\"></h3><p name=\"detailText\"></p></aside>\n</section>",
  "Description": "Interactive project architecture dependency explorer.",
  "LastUpdated": "2026-09-08T20:16:57.8638835+00:00",
  "IncludeInSubSequentImports": true,
  "PackageType": "ContentManagement/Component"
}
