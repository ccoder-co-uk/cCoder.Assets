{
  "Name": "UserOnboardingAdmin",
  "Key": "B2B",
  "ResourceKey": "B2B",
  "Script": "api.addToMetaCache([\r\n    {\r\n        Name: \"ContentManagement\",\r\n        Types: [\r\n            [meta[ContentManagement/Submission]]\r\n        ]\r\n    },\r\n    {\r\n        Name: \"Workflow\",\r\n        Types: [\r\n            [meta[Workflow/FlowDefinition]]\r\n        ]\r\n    }\r\n]);\r\nUserOnboardingAdmin = {\n\tstates: {\n\t\t\"New\": \"[resource_displayname[New]]\",\n\t\t\"Rejected\": \"[resource_displayname[rejected]]\",\n\t\t\"Pending\": \"[resource_displayname[pending]]\",\n\t\t\"AdminRejected\": \"[resource_displayname[adminRejected]]\",\n\t\t\"Accepted\": \"[resource_displayname[accepted]]\"\n\t},\n\n\ticonStates: {\n\t\t\"New\": \"k-i-file\",\n\t\t\"Accepted\": \"k-i-file-add\",\n\t\t\"Pending\": \"k-i-file-config\",\n\t\t\"Rejected\": \"k-i-file-error\"\n\t},\n\n\trequestTypes: {\n\t\t\"buyer\": \"[resource_displayname[buyer]]\",\n\t\t\"supplierreadonly\": \"[resource_displayname[supplierreadonly]]\",\n\t\t\"supplieralacarte\": \"[resource_displayname[supplieralacarte]]\",\n\t\t\"funder\": \"[resource_displayname[funder]]\"\n\t},\n\n\tinit: async function (app, container) {\n\t\tapp = app || session.app;\n\t\tcontainer = container || $(\".component[name=UserOnboardingAdmin]\");\n        \n\t\tvar dataSource = await model.getDatasource({\n\t\t\tendpoint: \"ContentManagement/Submission\",\n\t\t\todataAppend: \"?$filter=SourceComponent eq 'UserOnboarding' and State eq 'new' and AppId eq \" + app.Id\n\t\t});\n\t\tvar grid = await [script[UserOnboardingAdminGrid]]({ element: $(\"[name=userOnboardingGrid]\", container), dataSource: dataSource });\n\t\tgrid.detailTemplate = \"<div name='newRequestDialog'>\" + $(\"[name=viewRequest\").html() + \"</div>\";\n\t\tgrid.detailExpand = async (e) => { await UserOnboardingAdmin.viewRequest(e, app, grid); };\n\t\tawait grid.init();\n\t\t$(\"[name=addUserOnboardingRequest]\", grid.gridElement).on(\"click\", async (e) => await UserOnboardingAdmin.addUserOnboardingRequest(e, app, grid));\n\t},\n\n\taddUserOnboardingRequest: async function (e, app, grid) {\n\t\tvar newRequestForm = new Dialog({ title: \"[resource_displayname[NewAccessRequest]]\", width: 850 });\n\t\tnewRequestForm.template = $(\"[name=userOnboardingNewRequestWizardComponent]\").first().html();\n\t\tnewRequestForm.init();\n        UserOnboardingNewRequestWizard.init(app, newRequestForm.element, grid, newRequestForm);\n\t},\n\n\tsubmitRequest: async function (e, app, grid, model) {\n\t\te.preventDefault();\n\t\tvar submission = { SourceComponent: \"UserOnboarding\", State: \"New\", DataJson: JSON.stringify({ \"fields\": JSON.parse(JSON.stringify(model)) }), AppId: app.Id };\n\t\tawait api.add(\"ContentManagement/Submission\", submission);\n\t\tnotification.success(\"[resource_displayname[SubmissionSubmitted]]\");\n\t\tgrid.refresh();\n\t},\n\n\tviewRequest: async function (e, app, grid) {\n\t\tif (!$($(e.detailRow)).attr(\"expanded\")) {\n\t\t\t$($(e.detailRow)).attr(\"expanded\");\n\t\t\tvar submission = grid.kendoObject.dataItem(e.masterRow);\n\t\t\tvar formData = JSON.parse(submission.DataJson).fields;\n\t\t\tvar model = new kendo.observable(formData);\n\t\t\tkendo.bind($(e.detailRow), model);\n\t\t\tvar countries = await api.get(\"B2B/Country\");\n\t\t\t$(\"input[name=country]\", $(e.detailRow)).kendoDropDownList({ dataSource: countries.value, dataValueField: \"Id\", dataTextField: \"Name\" });\n\t\t\t$(\"select\", $(e.detailRow)).kendoDropDownList();\n\t\t\t$(\"button[name=approve]\", $(e.detailRow)).off(\"click\").on(\"click\", async (e) => { await UserOnboardingAdmin.acceptRequest(e, app, grid, submission); });\n\t\t\t$(\"button[name=reject]\", $(e.detailRow)).off(\"click\").on(\"click\", async (e) => { await UserOnboardingAdmin.rejectRequest(e, app, grid, submission); });\n\t\t\t$(\"button[name=pending]\", $(e.detailRow)).off(\"click\").on(\"click\", async (e) => { await UserOnboardingAdmin.pendingRequest(e, app, grid, submission); });\n\t\t\t$(\"[name=save]\", $(e.detailRow)).off(\"click\").on(\"click\", async (e) => { await UserOnboardingAdmin.saveRequest(e, grid, submission, model); });\n\t\t}\n\t},\n\n\tsaveRequest: async function (e, grid, submission, model) {\n\t\te.preventDefault();\n\t\tnotification.success(\"[resource_displayname[saved]]\");\n\t\tsubmission.DataJson = JSON.stringify({ fields: JSON.parse(JSON.stringify(model)) });\n\t\tdelete submission.type;\n\t\tawait api.update(\"ContentManagement/Submission(\" + submission.Id + \")\", submission);\n\t\tgrid.kendoObject.dataSource.read();\n\t},\n\n\tacceptRequest: async function (e, app, grid, submission) {\n\t\te.preventDefault();\n\t\tvar acceptWizardDialog = new Dialog({ title: \"[resource_displayname[AcceptRequest]]\",  width: 700 });\n\n\t\tacceptWizardDialog.init(async () => {\n\t\t\tvar c = await loadComponent(acceptWizardDialog.element, \"UserOnboardingAcceptWizard\");\n\t\t\tc.init(app, acceptWizardDialog.element, grid, submission, acceptWizardDialog)\n\t\t})\n\t},\n\n\trejectRequest: async function (e, app, grid, submission) {\n\t\te.preventDefault();\n\t\tsubmission.State = \"Rejected\";\n\t\tdelete submission.type;\n\t\tvar rejectReasonDialog = new Dialog({ title: \"[resource_displayname[rejectreason]]\" });\n\t\trejectReasonDialog.template = $(\"script[name=rejectReason]\").html();\n\t\trejectReasonDialog.events.reject = async function (e) {\n\t\t\tawait api.update(\"ContentManagement/Submission(\" + submission.Id + \")\", submission);\n\t\t\tgrid.kendoObject.dataSource.read();\n\t\t\tvar workflowData = { SubmissionId: submission.Id, RejectReason: $(\"input[name=rejectReason]\", rejectReasonDialog.element).val() };\n\t\t\tvar rejectWorkflow = await api.get(\"Workflow/FlowDefinition?$filter=Name eq 'OnboardingReject' and AppId eq \" + app.Id);\n\t\t\tawait api.add(\"Workflow/FlowDefinition(\" + rejectWorkflow.value[0].Id + \")/Execute()\", workflowData).then(() => { notification.success(\"[resource_displayname[executed]]\"); rejectReasonDialog.events.close(); });\n\t\t};\n\t\trejectReasonDialog.init();\n\t},\n\n\tpendingRequest: async function(e, app, grid,submission) {\n\t\te.preventDefault();\n\t\tsubmission.State = \"Pending\";\n\t\tgrid.kendoObject.dataSource.read();\n\t}\n}",
  "Content": "<div class=\"requestGrid\" style='width:100%'>\n\t<h3>[resource_displayname[useronboardingadmin]]</h3>\n\t<div name=\"userOnboardingGrid\" role=\"UserOnboardingGrid\"/>\n</div>\n<script name=\"rejectReason\" class=\"template\" type=\"template\">\n\t<ul class=\"fieldList\">\n\t\t<li>\n\t\t\t<label>[resource_displayname[rejectreason]]</label>\n\t\t\t<div class=\"value\">\n\t\t\t\t<input name=\"rejectReason\" type=\"text\"/>\n\t\t\t</div>\n\t\t</li>\n\t</ul>\n\t<hr />\n    <div class=\"value\">\n        <button class=\"btn\" name=\"close\">[resource_displayname[close]]</button>\n        <button class=\"btn\" name=\"reject\">[resource_displayname[reject]]</button>\n    </div>\n</script>\n<script name=\"createRequest\" type=\"template/text\">\n    <form name=\"createRequestForm\">\n        <div class=\"container\">\n            <h4>[resource_displayname[contactInfo]]</h4>\n            <ul class=\"fieldList\">\n                <li>\n                    <label>[resource_displayname[username]]</label>\n                    <div class=\"value\">\n                        <input name=\"username\" type=\"text\" data-bind=\"value: [0].username\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[firstname]]</label>\n                    <div class=\"value\">\n                        <input name=\"firstname\" type=\"text\" data-bind=\"value: [0].firstname\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[surname]]</label>\n                    <div class=\"value\">\n                        <input name=\"surname\" type=\"text\" data-bind=\"value: [0].surname\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[email]]</label>\n                    <div class=\"value\">\n                        <input name=\"email\" type=\"text\" data-bind=\"value: [0].email\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[phone]]</label>\n                    <div class=\"value\">\n                        <input name=\"phone\" type=\"text\" data-bind=\"value: [0].phone\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[jobtitle]]</label>\n                    <div class=\"value\">\n                        <input name=\"jobtitle\" type=\"text\" data-bind=\"value: [0].jobtitle\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div class=\"container\">\n            <h4>[resource_displayname[companyInfo]]</h4>\n            <ul class=\"fieldList\">\n                <li>\n                    <label>[resource_displayname[vatNo]]</label>\n                    <div class=\"value\">\n                        <input name=\"vatNo\" type=\"text\" data-bind=\"value: [1].vatNo\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[companyName]]</label>\n                    <div class=\"value\">\n                        <input name=\"companyName\" type=\"text\" data-bind=\"value: [1].companyName\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[addressLine1]]</label>\n                    <div class=\"value\">\n                        <input name=\"addressLine1\" type=\"text\" data-bind=\"value: [1].addressLine1\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[addressLine2]]</label>\n                    <div class=\"value\">\n                        <input name=\"addressLine2\" type=\"text\" data-bind=\"value: [1].addressLine2\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[city]]</label>\n                    <div class=\"value\">\n                        <input name=\"city\" type=\"text\" data-bind=\"value: [1].city\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[stateProvince]]</label>\n                    <div class=\"value\">\n                        <input name=\"stateProvince\" type=\"text\" data-bind=\"value: [1].stateProvince\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[ziporpostalcode]]</label>\n                    <div class=\"value\">\n                        <input name=\"zipOrPostalCode\" type=\"text\" data-bind=\"value: [1].zipOrPostalCode\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[country]]</label>\n                    <div class=\"value\">\n                        <input name=\"country\" type=\"text\" data-bind=\"value: [1].country\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div style=\"width: 446px\" class=\"container\">\n            <h4>[resource_displayname[accessRequested]]</h4>\n            <ul class=\"fieldList\">\n                <li>\n                    <label>[resource_displayname[name]]</label>\n                    <div class=\"value accessType\">\n                        <select name=\"requestType\" data-bind=\"value: [2].requestType\">\n                            <option value='buyer'>[resource_displayname[buyer]]</.option>\n                            <option value='supplierreadonly'>[resource_displayname[supplier]]</option>\n                            <option value='funder'>[resource_displayname[funder]]</option>\n                        </select>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[reference]]</label>\n                    <div class=\"value\">\n                        <input name=\"reference\" type=\"text\" data-bind=\"value: [2].reference\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactname]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactName\" type=\"text\" data-bind=\"value: [2].contactName\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactEmail]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactEmail\" type=\"text\" data-bind=\"value: [2].contactEmail\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactPhone]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactPhone\" type=\"text\" data-bind=\"value: [2].contactPhone\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n\n        <hr style=\"width: 1510px;\" />\n\n        <div style=\"width: 1510px;\" class=\"value\">\n            <button style=\"margin-right: 5px; float:right;\" name=\"submit\">\n                <span class=\"k-icon k-i-save\"/>[resource_displayname[submit]]\n            </button>\n        </div>\n    </form>\n</script>\n<script name=\"viewRequest\" type=\"template/text\">\n    <form name=\"createRequestForm\" class=\"viewRequest\">\n        <div class=\"container\">\n            <h4>[resource_displayname[contactInfo]]</h4>\n            <ul class=\"fieldList\">\n                <li>\n                    <label>[resource_displayname[username]]</label>\n                    <div class=\"value\">\n                        <input name=\"username\" type=\"text\" data-bind=\"value: [0].username\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[firstname]]</label>\n                    <div class=\"value\">\n                        <input name=\"firstname\" type=\"text\" data-bind=\"value: [0].firstname\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[surname]]</label>\n                    <div class=\"value\">\n                        <input name=\"surname\" type=\"text\" data-bind=\"value: [0].surname\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[email]]</label>\n                    <div class=\"value\">\n                        <input name=\"email\" type=\"text\" data-bind=\"value: [0].email\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[phone]]</label>\n                    <div class=\"value\">\n                        <input name=\"phone\" type=\"text\" data-bind=\"value: [0].phone\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[jobtitle]]</label>\n                    <div class=\"value\">\n                        <input name=\"jobtitle\" type=\"text\" data-bind=\"value: [0].jobtitle\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div class=\"container\">\n            <h4>[resource_displayname[companyInfo]]</h4>\n            <ul class=\"fieldList\">\n                <li>\n                    <label>[resource_displayname[vatNo]]</label>\n                    <div class=\"value\">\n                        <input name=\"vatNo\" type=\"text\" data-bind=\"value: [1].vatNo\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[companyName]]</label>\n                    <div class=\"value\">\n                        <input name=\"companyName\" type=\"text\" data-bind=\"value: [1].companyName\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[addressLine1]]</label>\n                    <div class=\"value\">\n                        <input name=\"addressLine1\" type=\"text\" data-bind=\"value: [1].addressLine1\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[addressLine2]]</label>\n                    <div class=\"value\">\n                        <input name=\"addressLine2\" type=\"text\" data-bind=\"value: [1].addressLine2\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[city]]</label>\n                    <div class=\"value\">\n                        <input name=\"city\" type=\"text\" data-bind=\"value: [1].city\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[stateProvince]]</label>\n                    <div class=\"value\">\n                        <input name=\"stateProvince\" type=\"text\" data-bind=\"value: [1].stateProvince\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[ziporpostalcode]]</label>\n                    <div class=\"value\">\n                        <input name=\"zipOrPostalCode\" type=\"text\" data-bind=\"value: [1].zipOrPostalCode\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[pobox]]</label>\n                    <div class=\"value\">\n                        <input name=\"poBox\" type=\"text\" data-bind=\"value: [1].poBox\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[country]]</label>\n                    <div class=\"value country\">\n                        <input name=\"country\" type=\"text\" data-bind=\"value: [1].country\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div style=\"width: 446px\" class=\"container\">\n            <h4>[resource_displayname[accessRequested]]</h4>\n            <ul class=\"fieldList\" style=\"width:100%;\">\n                <li>\n                    <label>[resource_displayname[name]]</label>\n                    <div class=\"value accessType\">\n                        <select name=\"requestType\" data-bind=\"value: [2].requestType\">\n                            <option value='buyer'>[resource_displayname[buyer]]</.option>\n                            <option value='supplierreadonly'>[resource_displayname[supplier]]</option>\n                            <option value='funder'>[resource_displayname[funder]]</option>\n                        </select>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[reference]]</label>\n                    <div class=\"value\">\n                        <input name=\"reference\" type=\"text\" data-bind=\"value: [2].reference\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactname]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactName\" type=\"text\" data-bind=\"value: [2].contactName\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactEmail]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactEmail\" type=\"text\" data-bind=\"value: [2].contactEmail\"/>\n                    </div>\n                </li>\n                <li>\n                    <label>[resource_displayname[contactPhone]]</label>\n                    <div class=\"value\">\n                        <input name=\"contactPhone\" type=\"text\" data-bind=\"value: [2].contactPhone\"/>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <hr />\n        <div class=\"value\">\n            <button style=\"margin-right: 5px; \" name=\"reject\">\n                <span class=\"k-icon k-i-file-error\"/>[resource_displayname[Reject]]\n            </button>\n            <button style=\"margin-right: 5px; \" name=\"save\">\n                <span class=\"k-icon k-i-save\"/>[resource_displayname[Save]]\n            </button>\n            <button style=\"margin-right: 5px; \" name=\"pending\">\n                <span class=\"k-icon k-i-file-config\"/>[resource_displayname[Pending]]\n            </button>\n            <button style=\"margin-right: 5px; \" name=\"approve\">\n                <span class=\"k-icon k-i-file-add\"/>[resource_displayname[Approve]]\n            </button>\n        </div>\n    </form>\n</script>\n<div name=\"userOnboardingNewRequestWizardComponent\" style=\"display:none;\">\n\t[component[UserOnboardingNewRequestWizard]]\n</div>\n<div name=\"userOnboardingAcceptWizardComponent\" style=\"display:none;\"></div>",
