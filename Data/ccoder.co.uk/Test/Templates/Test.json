{
  "Name": "Test",
  "ResourceKey": "Test",
  "RawString": "\u003Chtml\u003E\r\n\u003Chead\u003E\r\n    \u003Ctitle\u003EUser Activity Report for [model[start]] to [model[end]]\u003C/title\u003E\r\n    \u003Cstyle\u003E\r\n        body { padding: 0 20px; font-size: [theme[font.size]]; font-family: [theme[font.family]]; }\r\n\r\n        h1 {\r\n            width: 80%;\r\n            border-bottom: solid 2px [theme[colours.primary]];\r\n\t\t    color: [theme[colours.primary]];\r\n        }\r\n\r\n        h2 {\r\n            width: 80%;\r\n            border-bottom: solid 2px [theme[colours.secondary]];\r\n\t\t    color: [theme[colours.secondary]];\r\n        }\r\n\r\n        table { \t\t\r\n            box-shadow: [theme[shadows]];\r\n            -moz-box-shadow: [theme[shadows]];\r\n            -webkit-box-shadow: [theme[shadows]];\r\n            border-width: [theme[border.width]];\r\n            border-radius: [theme[border.radius]];\r\n            border: [theme[border.style]];\r\n            margin-bottom: 20px; \r\n        }\r\n\r\n        thead { background: #EFEFEF; }\r\n        tr { border: [theme[border.style]]; }\r\n        th { text-align: left; padding: 2px 6px; }\r\n        td { padding: 4px; }\r\n    \u003C/style\u003E\r\n\u003C/head\u003E\r\n\u003Cbody\u003E\r\n    \u003Ch1 style=\u0022color: [theme[colours.primary]];\u0022\u003EUser Activity Report for [model[fromYear]]-[model[fromMonth]]-01 to [model[toYear]]-[model[toMonth]]-01\u003C/h1\u003E\r\n    \u003Ch2 style=\u0022color: [theme[colours.primary]];\u0022\u003EUsers\u003C/h2\u003E\r\n    \u003Ctable\u003E\r\n        \u003Cthead\u003E\r\n            \u003Ctr\u003E\r\n                \u003Cth style=\u0022width: 150px;\u0022\u003EId\u003C/th\u003E\u003Cth style=\u0022width: 200px;\u0022\u003EName\u003C/th\u003E\u003Cth style=\u0022width: 300px;\u0022\u003EEmail\u003C/th\u003E\r\n            \u003C/tr\u003E\r\n        \u003C/thead\u003E\r\n        \u003Ctbody\u003E\r\n            [execute]\r\n                string result = string.Empty;\r\n\r\n                foreach(var user in model.Data.Users)\r\n                    result \u002B= $\u0022\u003Ctr\u003E\u003Ctd\u003E{user.Id}\u003C/td\u003E\u003Ctd\u003E{user.DisplayName}\u003C/td\u003E\u003Ctd\u003E{user.Email}\u003C/td\u003E\u003C/tr\u003E\u0022;\r\n\r\n                return result;\r\n            [/execute]\r\n        \u003C/tbody\u003E\r\n    \u003C/table\u003E\r\n\r\n    \u003Ch2 style=\u0022color: [theme[colours.primary]];\u0022\u003ESessions\u003C/h2\u003E\r\n    \u003Ctable\u003E\r\n        \u003Cthead\u003E\r\n            \u003Ctr\u003E\r\n                \u003Cth\u003EDate\u003C/th\u003E\u003Cth\u003EName\u003C/th\u003E\u003Cth\u003EEmail\u003C/th\u003E\u003Cth\u003ECount\u003C/th\u003E\u003Cth\u003EPage Hits\u003C/th\u003E\u003Cth\u003EApi Calls\u003C/th\u003E\r\n            \u003C/tr\u003E\r\n        \u003C/thead\u003E\r\n        \u003Ctbody\u003E\r\n            [execute]\r\n                string result = string.Empty;\r\n\r\n                foreach(var session in model.Data.Sessions)\r\n                    result \u002B= $\u0022\u003Ctr\u003E\u003Ctd\u003E{session.Date}\u003C/td\u003E\u003Ctd\u003E{session.DisplayName}\u003C/td\u003E\u003Ctd\u003E{session.Email}\u003C/td\u003E\u003Ctd\u003E{session.SessionCount}\u003C/td\u003E\u003Ctd\u003E{session.PageHits}\u003C/td\u003E\u003Ctd\u003E{session.ApiCalls}\u003C/td\u003E\u003C/tr\u003E\u0022;\r\n\r\n                return result;\r\n            [/execute]\r\n        \u003C/tbody\u003E\r\n    \u003C/table\u003E\r\n\u003C/body\u003E\r\n\u003C/html\u003E",
  "LastUpdated": "2026-04-30T19:09:37.3432796\u002B00:00"
}