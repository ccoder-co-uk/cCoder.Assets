      "Name": "body",
      "Html": "   \u003Cdiv class=\u0022container mt-6 tool-surface\u0022\u003E\r\n        \u003Ch1 class=\u0022mb-3\u0022\u003EMortgage Repayment Analysis\u003C/h1\u003E\u003Cp class=\u0022tool-summary mb-0\u0022\u003EAdjust the repayment assumptions below to compare balance reduction, interest exposure, and equity growth over time.\u003C/p\u003E\r\n        \u003Cform id=\u0022mortgage-form\u0022\u003E\r\n            \u003Cdiv class=\u0022row g-4 mortgage-form-grid\u0022\u003E\r\n                \u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022initialBalance\u0022\u003EInitial Balance\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022initialBalance\u0022 placeholder=\u0022Initial Balance\u0022 value=\u0022280000\u0022 required\u003E\r\n                \u003C/div\u003E\r\n                \u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022initialInterestRate\u0022\u003EInitial Interest Rate (%)\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022initialInterestRate\u0022 placeholder=\u0022Initial Interest Rate\u0022 value=\u00223.59\u0022 required\u003E\r\n                \u003C/div\u003E\r\n                \u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022initialPeriod\u0022\u003EInitial Interest Rate Period (months)\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022initialPeriod\u0022 placeholder=\u0022Initial Interest Rate Period\u0022 value=\u002260\u0022 required\u003E\r\n                \u003C/div\u003E\r\n                \u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022variableInterestRate\u0022\u003EVariable Interest Rate (%)\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022variableInterestRate\u0022 placeholder=\u0022Variable Interest Rate\u0022 value=\u00224.5\u0022 required\u003E\r\n                \u003C/div\u003E\r\n                \u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022repaymentAmount\u0022\u003ERepayment Amount\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022repaymentAmount\u0022 placeholder=\u0022Repayment Amount\u0022 value=\u00221322\u0022 required\u003E\r\n                \u003C/div\u003E\r\n\t\t\t\t\u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022repaymentAmount\u0022\u003EEquity\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022equity\u0022 placeholder=\u0022Equity\u0022 value=\u002270000\u0022 required\u003E\r\n                \u003C/div\u003E\r\n\t\t\t\t\u003Cdiv class=\u0022col-xl-3 col-md-6\u0022\u003E\r\n                    \u003Clabel for=\u0022repaymentAmount\u0022\u003EProperty Value\u003C/label\u003E\r\n                    \u003Cinput type=\u0022number\u0022 class=\u0022form-control\u0022 id=\u0022propertyValue\u0022 placeholder=\u0022Property Value\u0022 value=\u0022350000\u0022 required\u003E\r\n                \u003C/div\u003E\r\n            \u003C/div\u003E\r\n            \u003Cbutton type=\u0022button\u0022 class=\u0022btn btn-primary mt-4\u0022 onclick=\u0022calculateMortgage()\u0022\u003ERecalculate\u003C/button\u003E\r\n        \u003C/form\u003E\r\n\t\u003C/div\u003E\r\n\t\u003Cdiv class=\u0022container mt-3 tool-surface\u0022\u003E\r\n\t\t\u003Cdiv class=\u0022row g-3\u0022\u003E\r\n\t\t\t\u003Cdiv class=\u0022col-md-6\u0022\u003E\r\n\t\t\t\t\u003Ch2 class=\u0022mt-5\u0022\u003EPayment Indication\u003C/h2\u003E\r\n\t\t\t\t\u003Cdiv id=\u0022paymentChart\u0022 class=\u0022mortgage-chart mb-5\u0022\u003E\u003C/div\u003E\r\n\t\t\t\u003C/div\u003E\r\n\t\t\t\u003Cdiv class=\u0022col-md-6\u0022\u003E\r\n\t\t\t\t\u003Ch2 class=\u0022mt-5\u0022\u003EInvestment (ROI) Indication\u003C/h2\u003E\r\n\t\t\t\t\u003Cdiv id=\u0022investmentChart\u0022 class=\u0022mortgage-chart mb-5\u0022\u003E\u003C/div\u003E\r\n\t\t\t\u003C/div\u003E\r\n\t\t\u003C/div\u003E\r\n\t\r\n\t\u003C/div\u003E\r\n\t\u003Cdiv class=\u0022container mt-3 mb-3 tool-surface\u0022\u003E\r\n\t\t\u003Ch2\u003EBreakdown\u003C/h2\u003E\r\n\t\t\u003Cdiv class=\u0022table-container\u0022\u003E\r\n\t\t\t\u003Ctable class=\u0022table table-striped align-middle mb-0\u0022\u003E\r\n\t\t\t\t\u003Cthead\u003E\r\n\t\t\t\t\t\u003Ctr\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EMonth\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EBalance\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003ERepayment\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EInterest\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EPrincipal\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EProperty Value (est)\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EInterest Rate\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003EEquity\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003ETotal Interest\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003ETotal Principal\u003C/th\u003E\r\n\t\t\t\t\t\t\u003Cth\u003ETotal Investment\u003C/th\u003E\r\n\t\t\t\t\t\u003C/tr\u003E\r\n\t\t\t\t\u003C/thead\u003E\r\n\t\t\t\t\u003Ctbody id=\u0022mortgageTableBody\u0022\u003E\r\n\t\t\t\t\u003C/tbody\u003E\r\n\t\t\t\u003C/table\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/div\u003E\r\n\u003Cstyle id=\u0022mortgage-chart-tidy\u0022\u003E\r\n.mortgage-form-grid{align-items:end}\r\n.mortgage-form-grid{margin-left:calc(var(--site-gap)*-.75)!important;margin-right:calc(var(--site-gap)*-.75)!important;row-gap:calc(var(--site-gap)*1.5)!important}\r\n.mortgage-form-grid\u003E[class*=col-]{display:flex;flex-direction:column;gap:calc(var(--site-gap)*.5);padding-left:calc(var(--site-gap)*.75)!important;padding-right:calc(var(--site-gap)*.75)!important}\r\n.mortgage-chart{height:340px;width:100%}\r\n.mortgage-chart\u003E.k-chart{height:100%}\r\n@media (max-width:767.98px){.mortgage-chart{height:280px}}\r\n\u003C/style\u003E\r\n\u003Cscript\u003E\r\n\t\tvar paymentChart;\r\n\t\tvar investmentChart;\r\n\r\n\t\tfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart \u0026\u0026 typeof chart.destroy === \u0027function\u0027) {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: \u0027svg\u0027,\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: \u0027transparent\u0027\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: \u0027bottom\u0027\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: \u0027line\u0027,\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: \u0027Month\u0027 },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: \u0027Amount\u0027 },\r\n\t\t\t\t\tlabels: { format: \u0027{0:c0}\u0027 }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: \u0027#= series.name #: #= kendo.toString(value, \u0022c0\u0022) #\u0027\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data(\u0027kendoChart\u0027);\r\n\t\t}\r\nfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart \u0026\u0026 typeof chart.destroy === \u0027function\u0027) {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: \u0027svg\u0027,\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: \u0027transparent\u0027\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: \u0027bottom\u0027\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: \u0027line\u0027,\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: \u0027Month\u0027 },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: \u0027Amount\u0027 },\r\n\t\t\t\t\tlabels: { format: \u0027{0:c0}\u0027 }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: \u0027#= series.name #: #= kendo.toString(value, \u0022c0\u0022) #\u0027\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data(\u0027kendoChart\u0027);\r\n\t\t}\r\nfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart \u0026\u0026 typeof chart.destroy === \u0027function\u0027) {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: \u0027svg\u0027,\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: \u0027transparent\u0027\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: \u0027bottom\u0027\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: \u0027line\u0027,\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: \u0027Month\u0027 },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: \u0027Amount\u0027 },\r\n\t\t\t\t\tlabels: { format: \u0027{0:c0}\u0027 }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: \u0027#= series.name #: #= kendo.toString(value, \u0022c0\u0022) #\u0027\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data(\u0027kendoChart\u0027);\r\n\t\t}\r\nfunction calculateMortgage() {\r\n\t\t\tconst initialBalance = parseFloat(document.getElementById(\u0027initialBalance\u0027).value);\r\n\t\t\tconst initialInterestRate = parseFloat(document.getElementById(\u0027initialInterestRate\u0027).value) / 100;\r\n\t\t\tconst initialPeriod = parseInt(document.getElementById(\u0027initialPeriod\u0027).value);\r\n\t\t\tconst variableInterestRate = parseFloat(document.getElementById(\u0027variableInterestRate\u0027).value) / 100;\r\n\t\t\tconst repaymentAmount = parseFloat(document.getElementById(\u0027repaymentAmount\u0027).value);\r\n\t\t\t\r\n\t\t\tlet balance = parseFloat(document.getElementById(\u0027initialBalance\u0027).value);\r\n\t\t\tlet equity = parseFloat(document.getElementById(\u0027equity\u0027).value);\r\n\t\t\tlet propertyValue = parseFloat(document.getElementById(\u0027propertyValue\u0027).value);\r\n\t\t\tlet totalInterest = 0;\r\n\t\t\tlet totalPrincipal = 0; \r\n\t\t\tlet totalInvestment = 0;\r\n\t\t\tlet months = 0;\r\n\t\t\tlet mortgageData = [];\r\n\r\n\t\t\twhile (balance \u003E 0 \u0026\u0026 months \u003C 420) { // limiting to 35 years\r\n\t\t\t\tlet interestRate = months \u003C initialPeriod ? initialInterestRate : variableInterestRate;\r\n\t\t\t\tlet interest = balance * interestRate / 12;\r\n\t\t\t\tlet principal = Math.min(repaymentAmount - interest, balance);\r\n\t\t\t\tbalance -= principal;\r\n\t\t\t\tequity \u002B= principal;\r\n\t\t\t\tpropertyValue \u002B= propertyValue * (0.005 / 12); // Example house value increase per month\r\n\r\n\t\t\t\tmortgageData.push({\r\n\t\t\t\t\tmonth: months \u002B 1,\r\n\t\t\t\t\tbalance: balance,\r\n\t\t\t\t\trepayment: repaymentAmount,\r\n\t\t\t\t\tinterest: interest,\r\n\t\t\t\t\tprincipal: principal,\r\n\t\t\t\t\tequity: equity,\r\n\t\t\t\t\tpropertyValue: propertyValue,\r\n\t\t\t\t\tinterestRate: (interestRate * 100),\r\n\t\t\t\t\ttotalInterest: (totalInterest \u002B= interest),\r\n\t\t\t\t\ttotalPrincipal: (totalPrincipal \u002B= principal),\r\n\t\t\t\t\ttotalInvestment: (totalInvestment \u002B= repaymentAmount)\r\n\t\t\t\t});\r\n\r\n\t\t\t\tmonths\u002B\u002B;\r\n\t\t\t}\r\n\r\n\t\t\tdestroyMortgageChart(paymentChart, \u0027#paymentChart\u0027);\r\n\t\t\tdestroyMortgageChart(investmentChart, \u0027#investmentChart\u0027);\r\n\r\n\t\t\tpaymentChart = updatePaymentChart(mortgageData);\r\n\t\t\tinvestmentChart = updateInvestmentChart(mortgageData);\r\n\t\t\tupdateTable(mortgageData);\r\n\t\t}\r\n\r\n\t\tfunction updatePaymentChart(mortgageData) {\r\n\t\t\treturn buildMortgageChart(\u0027#paymentChart\u0027, mortgageData.map(i =\u003E i.month \u002B 1), [\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Repayment\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.repayment),\r\n\t\t\t\t\tcolor: \u0027green\u0027\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Interest\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.interest),\r\n\t\t\t\t\tcolor: \u0027red\u0027\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Principal\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.principal),\r\n\t\t\t\t\tcolor: \u0027orange\u0027\r\n\t\t\t\t}\r\n\t\t\t]);\r\n\t\t}\r\n\r\n\t\tfunction updateInvestmentChart(mortgageData) {\r\n\t\t\treturn buildMortgageChart(\u0027#investmentChart\u0027, mortgageData.map(i =\u003E i.month \u002B 1), [\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Interest Paid (Total)\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.totalInterest),\r\n\t\t\t\t\tcolor: \u0027green\u0027\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Capital Owned (Equity)\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.equity),\r\n\t\t\t\t\tcolor: \u0027red\u0027\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Repayments Total\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.totalInvestment),\r\n\t\t\t\t\tcolor: \u0027orange\u0027\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: \u0027Property Value\u0027,\r\n\t\t\t\t\tdata: mortgageData.map(i =\u003E i.propertyValue),\r\n\t\t\t\t\tcolor: \u0027lightblue\u0027\r\n\t\t\t\t}\r\n\t\t\t]);\r\n\t\t}\r\n\r\n\t\tfunction updateTable(mortgageData) {\r\n\t\t\tconst table = document.getElementById(\u0027mortgageTableBody\u0027);\r\n\t\t\ttable.innerHTML = \u0027\u0027;\r\n\t\t\tmortgageData.forEach(row =\u003E {\r\n\t\t\t\tconst rowHtml = \u0060\u003Ctr\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.month}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.balance.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.repayment.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.interest.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.principal.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.propertyValue.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.interestRate.toFixed(2) \u002B \u0022%\u0022}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.equity.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.totalInterest.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.totalPrincipal.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\t\u003Ctd\u003E${row.totalInvestment.toLocaleString(\u0027en-GB\u0027, { style: \u0027currency\u0027, currency: \u0027GBP\u0027 })}\u003C/td\u003E\r\n\t\t\t\t\u003C/tr\u003E\u0060;\r\n\t\t\t\ttable.innerHTML \u002B= rowHtml;\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tdocument.addEventListener(\u0027DOMContentLoaded\u0027, calculateMortgage);\r\n    \u003C/script\u003E"
    }
  ],
