  "HeaderHtml": "<meta property=\"keywords\" content=\"[page[keywords]]\" />\n<meta property=\"description\" content=\"[page[description]]\" />\n<meta property=\"og:locale\" content=\"[[culture]]\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"[page[title]]\" />\n<meta property=\"og:description\" content=\"[page[description]]\" />\n<meta property=\"og:url\" content=\"[page[url]]\" />\n<meta property=\"og:site_name\" content=\"[app[name]]\" />\n<meta property=\"og:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:secure_url\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:type\" content=\"image/png\" />\n<meta property=\"og:image:width\" content=\"2838\" />\n<meta property=\"og:image:height\" content=\"1088\" />\n<meta property=\"og:image:alt\" content=\"cCoder logo\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"[page[title]]\" />\n<meta name=\"twitter:description\" content=\"[page[description]]\" />\n<meta name=\"twitter:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta name=\"twitter:image:alt\" content=\"cCoder logo\" /><meta name=\"theme-color\" content=\"#0E4A7A\" />\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=600\" />\n<script>(function(){document.querySelectorAll('meta[name=\"viewport\"]').forEach(function(meta){meta.setAttribute('content','width=600');});})();</script>\n<link rel=\"canonical\" href=\"[page[url]]\" />\n<style nonce=\"[request[nonce]]\">\r\n[style[Dependency.Bootstrap.Bootstrap]]\r\n[style[Dependency.Kendo.KendoV20242514Bootstrap]]\r\n[style[Baseline]]\r\n</style>\n[theme[template]]",
  "Html": "<div class=\"site-shell\">\n    <header class=\"site-header\">\n        <div class=\"container-xxl\">\n            <div class=\"site-header-row\">\n                <a class=\"site-brand\" href=\"/\" title=\"[app[name]]\">\n                    <img src=\"[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\" alt=\"[app[name]]\" /></a>\n                <div class=\"site-nav-host\">[component[TopNav]]</div><div class=\"site-utility\"><div class=\"utility-flags\">[component[CultureFlags]]</div><div class=\"utility-user\">[component[UserProfile]]</div></div>\n            </div>\n        </div>\n    </header>\n    <main class=\"site-main\"><div class=\"container-xxl\"><div class=\"docs-page\"><button class=\"docs-menu-tab\" type=\"button\" aria-controls=\"documentation-navigation\" aria-expanded=\"false\" aria-label=\"Open documentation navigation\"><span class=\"k-icon k-i-menu\" aria-hidden=\"true\"></span><span>Docs</span></button><aside class=\"docs-sidebar\" id=\"documentation-navigation\" aria-label=\"Documentation navigation\"><button class=\"docs-menu-close\" type=\"button\" aria-label=\"Close documentation navigation\"><span class=\"k-icon k-i-x\" aria-hidden=\"true\"></span></button><div class=\"docs-sidebar-inner\">[component[Sidenav]]</div></aside><button class=\"docs-menu-backdrop\" type=\"button\" tabindex=\"-1\" aria-label=\"Close documentation navigation\"></button><section class=\"docs-content\">[content[body]class=docs-body]</section></div></div></main>\n    <footer class=\"site-footer\">\n        <div class=\"container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\">\n            <span>&copy; 2026, cCoder</span>\n            <span>Standards-first bespoke cloud software with public documentation and practical platform tools.</span>\n        </div>\n    </footer>\n</div>\n<style>\n.docs-menu-tab,.docs-menu-close,.docs-menu-backdrop{display:none}\n@media(max-width:991.98px){.docs-page{display:block}.docs-page .docs-sidebar{position:fixed;inset:0 auto 0 0;z-index:1060;width:min(86vw,340px);height:100dvh;padding:calc(var(--site-gap)*2);overflow-y:auto;background:var(--site-surface);box-shadow:var(--site-shadow);transform:translateX(-105%);transition:transform .2s ease;visibility:hidden}.docs-page.docs-menu-open .docs-sidebar{transform:translateX(0);visibility:visible}.docs-menu-tab{display:flex;position:fixed;left:0;top:50%;z-index:1050;align-items:center;gap:.4rem;padding:.75rem .55rem;border:var(--site-border);border-left:0;border-radius:0 var(--site-radius) var(--site-radius) 0;background:var(--site-primary);color:var(--site-contrast);box-shadow:var(--site-shadow);writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}.docs-menu-tab:hover,.docs-menu-tab:focus-visible{background:var(--site-secondary)}.docs-menu-close{display:flex;position:sticky;top:0;z-index:1;margin:0 0 var(--site-gap) auto;padding:.55rem;border:var(--site-border);border-radius:var(--site-radius);background:var(--site-primary);color:var(--site-contrast)}.docs-menu-backdrop{position:fixed;inset:0;z-index:1055;width:100%;height:100%;border:0;background:rgba(16,36,63,.42)}.docs-page.docs-menu-open .docs-menu-backdrop{display:block}body.docs-menu-open{overflow:hidden}}\n@media(prefers-reduced-motion:reduce){.docs-page .docs-sidebar{transition:none!important}}\n.site-shell{height:100dvh;min-height:0;overflow:hidden}.site-header,.site-footer{flex:0 0 auto}.site-main{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}.site-header-row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr 1fr;align-items:start;box-sizing:border-box;height:122px;padding:0}.site-brand{grid-column:1;grid-row:1/3;align-self:center}.site-brand img{flex:0 0 auto;width:auto;max-width:min(77vw,320px);height:clamp(116px,8vw,126px);padding:0}.site-utility{display:flex;grid-column:2;grid-row:1;align-self:start;justify-self:end;flex-direction:row;align-items:center;justify-content:flex-end;gap:var(--site-gap);width:auto!important;margin:0;padding-top:.5rem;transform:translateY(.25rem);white-space:nowrap}.site-utility .component[name=UserProfile] .userName{min-width:0;justify-content:flex-end}.site-nav-host{grid-column:2;grid-row:2;align-self:start;justify-self:end;margin:.25rem 0 0 var(--site-gap)}@media(max-width:991.98px){.site-nav-host{align-self:center;margin-top:0;transform:translateY(-12px)}}</style><script nonce=\"[request[nonce]]\">\r\n[script[Dependency.Jquery.Jquery370]]\r\n[script[Dependency.Jquery.JqueryValidate]]\r\n[script[Dependency.Jquery.JqueryUi]]\r\n[script[Dependency.Kendo.KendoAllV20242514]]\r\n[script[Dependency.Kendo.KendoUiLicense]]\r\n[script[Dependency.Bootstrap.BootstrapBundle]]\r\n[script[Dependency.Other.Signalr]]\r\n[script[Widgets.Widget]]\r\n[script[Core.Api]]\r\n[script[Core.Util]]\r\n[script[Core.Model]]\r\n</script>\n<script>\n    [script[DefaultResourcing]]\r\n    [script[KendoCultures]]\n\n    type.dateFormat = \"[resource_displayname[dateformat]]\";\n    type.shortDateFormat = \"[resource_displayname[shortdateformat]]\";\n    type.moneyFormat = \"[resource_displayname[moneyformat]]\";\n    type.aggregateMoneyFormat = \"[resource_displayname[aggregateMoneyFormat]]\";\n\n    function initDocumentationMenu() {\n        var page = document.querySelector('.docs-page');\n        if (!page) return;\n        var openButton = page.querySelector('.docs-menu-tab');\n        var closeButton = page.querySelector('.docs-menu-close');\n        var backdrop = page.querySelector('.docs-menu-backdrop');\n        var sidebar = page.querySelector('.docs-sidebar');\n        function setOpen(isOpen, restoreFocus) {\n            page.classList.toggle('docs-menu-open', isOpen);\n            document.body.classList.toggle('docs-menu-open', isOpen);\n            openButton.setAttribute('aria-expanded', String(isOpen));\n            sidebar.setAttribute('aria-hidden', String(!isOpen));\n            if (isOpen) closeButton.focus(); else if (restoreFocus) openButton.focus();\n        }\n        openButton.addEventListener('click', function () { setOpen(true, false); });\n        closeButton.addEventListener('click', function () { setOpen(false, true); });\n        backdrop.addEventListener('click', function () { setOpen(false, true); });\n        document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && page.classList.contains('docs-menu-open')) setOpen(false, true); });\n        window.matchMedia('(min-width: 992px)').addEventListener('change', function (event) { if (event.matches) setOpen(false, false); });\n    }\n    initContent();\r\n    kendo.setDefaults('iconType', 'svg');\n    initDocumentationMenu();\n</script>",
