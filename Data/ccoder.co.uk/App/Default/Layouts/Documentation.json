  "HeaderHtml": "\u003Cmeta property=\u0022keywords\u0022 content=\u0022[page[keywords]]\u0022 /\u003E\n\u003Cmeta property=\u0022description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:locale\u0022 content=\u0022[[culture]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:type\u0022 content=\u0022website\u0022 /\u003E\n\u003Cmeta property=\u0022og:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:url\u0022 content=\u0022[page[url]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:site_name\u0022 content=\u0022[app[name]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:secure_url\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:type\u0022 content=\u0022image/png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:width\u0022 content=\u00222838\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:height\u0022 content=\u00221088\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:card\u0022 content=\u0022summary_large_image\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\u003Cmeta name=\u0022theme-color\u0022 content=\u0022#0E4A7A\u0022 /\u003E\n\u003Cmeta charset=\u0022utf-8\u0022 /\u003E\n\u003Cmeta name=\u0022viewport\u0022 content=\u0022width=device-width, initial-scale=1\u0022 /\u003E\n\u003Clink rel=\u0022canonical\u0022 href=\u0022[page[url]]\u0022 /\u003E\n\u003Clink rel=\u0022stylesheet\u0022 media=\u0022screen\u0022 href=\u0022/everything.min.css\u0022 /\u003E\n[theme[template]]",
  "Html": "\u003Cdiv class=\u0022site-shell\u0022\u003E\n    \u003Cheader class=\u0022site-header\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl\u0022\u003E\n            \u003Cdiv class=\u0022site-header-row\u0022\u003E\n                \u003Ca class=\u0022site-brand\u0022 href=\u0022/\u0022 title=\u0022[app[name]]\u0022\u003E\n                    \u003Cimg src=\u0022[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\u0022 alt=\u0022[app[name]]\u0022 /\u003E\u003C/a\u003E\n                \u003Cdiv class=\u0022site-nav-host\u0022\u003E[component[TopNav]]\u003C/div\u003E\u003Cdiv class=\u0022site-utility\u0022\u003E\u003Cdiv class=\u0022utility-flags\u0022\u003E[component[CultureFlags]]\u003C/div\u003E\u003Cdiv class=\u0022utility-time\u0022\u003E\u003Cspan id=\u0022site-date\u0022\u003E\u003C/span\u003E \u003Cspan id=\u0022time\u0022\u003E\u003C/span\u003E\u003C/div\u003E\u003Cdiv class=\u0022utility-user\u0022\u003E[component[UserProfile]]\u003C/div\u003E\u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/header\u003E\n    \u003Cmain class=\u0022site-main\u0022\u003E\u003Cdiv class=\u0022container-xxl\u0022\u003E\u003Cdiv class=\u0022docs-page\u0022\u003E\u003Caside class=\u0022docs-sidebar\u0022\u003E\u003Cdiv class=\u0022docs-sidebar-inner\u0022\u003E[component[Sidenav]]\u003C/div\u003E\u003C/aside\u003E\u003Csection class=\u0022docs-content\u0022\u003E[content[body]class=docs-body]\u003C/section\u003E\u003C/div\u003E\u003C/div\u003E\u003C/main\u003E\n    \u003Cfooter class=\u0022site-footer\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\u0022\u003E\n            \u003Cspan\u003E\u0026copy; 2026, cCoder\u003C/span\u003E\n            \u003Cspan\u003EStandards-first bespoke cloud software with public documentation and practical platform tools.\u003C/span\u003E\n        \u003C/div\u003E\n    \u003C/footer\u003E\n\u003C/div\u003E\n\u003Cscript src=\u0022/everything.min.js\u0022 crossorigin=\u0022anonymous\u0022\u003E\u003C/script\u003E\n\u003Cscript\u003E\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \u0022[resource_displayname[dateformat]]\u0022;\n    type.shortDateFormat = \u0022[resource_displayname[shortdateformat]]\u0022;\n    type.moneyFormat = \u0022[resource_displayname[moneyformat]]\u0022;\n    type.aggregateMoneyFormat = \u0022[resource_displayname[aggregateMoneyFormat]]\u0022;\n\n    initContent();\n    function updateSiteHeaderDate() {\n        var dateElement = document.getElementById(\u0027site-date\u0027);\n        if (!dateElement) return;\n        var pageCulture = document.querySelector(\u0027meta[property=\u0022og:locale\u0022]\u0027);\n        var activeCulture = document.querySelector(\u0027.culture.active[data-culture]\u0027);\n        var cultureName = (pageCulture \u0026\u0026 pageCulture.getAttribute(\u0027content\u0027)) || (activeCulture \u0026\u0026 activeCulture.getAttribute(\u0027data-culture\u0027)) || (window.kendo \u0026\u0026 kendo.culture \u0026\u0026 kendo.culture().name) || navigator.language || \u0027en-GB\u0027;\n        dateElement.textContent = new Intl.DateTimeFormat(cultureName, {\n            day: \u00272-digit\u0027,\n            month: \u0027long\u0027,\n            year: \u0027numeric\u0027\n        }).format(new Date());\n    }\n    updateSiteHeaderDate();\n    window.addEventListener(\u0027load\u0027, updateSiteHeaderDate);\n    window.setInterval(updateSiteHeaderDate, 60000);\n\n    kendo.setDefaults(\u0027iconType\u0027, \u0027svg\u0027);\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\u0022.k-icon:not(.k-svg-icon):not(.k-font-icon)\u0022).each(function() {\n            var iconName = $(this).attr(\u0027class\u0027).split(\u0027 \u0027).filter(function(cls) {\n                return cls !== \u0027k-icon\u0027;\n            })[0].replace(/^k-i-/, \u0022\u0022).replace(\u0022source-code\u0022, \u0022code\u0022);\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: \u0027svg\u0027 });\n\n            if(svgIcon != \u0060\u003Cspan class=\u0022k-icon k-svg-icon\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u0060) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n\u003C/script\u003E",
