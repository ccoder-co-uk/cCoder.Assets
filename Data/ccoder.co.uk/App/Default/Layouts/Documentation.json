{
  "Name": "Documentation",
  "HeaderHtml": "<meta property=\"keywords\" content=\"[page[keywords]]\" />\n<meta property=\"description\" content=\"[page[description]]\" />\n<meta property=\"og:locale\" content=\"[[culture]]\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"[page[title]]\" />\n<meta property=\"og:description\" content=\"[page[description]]\" />\n<meta property=\"og:url\" content=\"[page[url]]\" />\n<meta property=\"og:site_name\" content=\"[app[name]]\" />\n<meta property=\"og:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:secure_url\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:type\" content=\"image/png\" />\n<meta property=\"og:image:width\" content=\"2838\" />\n<meta property=\"og:image:height\" content=\"1088\" />\n<meta property=\"og:image:alt\" content=\"cCoder logo\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"[page[title]]\" />\n<meta name=\"twitter:description\" content=\"[page[description]]\" />\n<meta name=\"twitter:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta name=\"twitter:image:alt\" content=\"cCoder logo\" /><meta name=\"theme-color\" content=\"#0E4A7A\" />\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"canonical\" href=\"[page[url]]\" />\n<link rel=\"stylesheet\" media=\"screen\" href=\"/everything.min.css\" />\n[theme[template]]",
  "Html": "<div class=\"site-shell\">\n    <header class=\"site-header\">\n        <div class=\"container-xxl\">\n            <div class=\"site-header-row\">\n                <a class=\"site-brand\" href=\"/\" title=\"[app[name]]\">\n                    <img src=\"[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\" alt=\"[app[name]]\" /></a>\n                <div class=\"site-nav-host\">[component[TopNav]]</div><div class=\"site-utility\"><div class=\"utility-flags\">[component[CultureFlags]]</div><div class=\"utility-time\"><span id=\"site-date\"></span> <span id=\"time\"></span></div><div class=\"utility-user\">[component[UserProfile]]</div></div>\n            </div>\n        </div>\n    </header>\n    <main class=\"site-main\"><div class=\"container-xxl\"><div class=\"docs-page\"><button class=\"docs-menu-tab\" type=\"button\" aria-controls=\"documentation-navigation\" aria-expanded=\"false\" aria-label=\"Open documentation navigation\"><span class=\"k-icon k-i-menu\" aria-hidden=\"true\"></span><span>Docs</span></button><aside class=\"docs-sidebar\" id=\"documentation-navigation\" aria-label=\"Documentation navigation\"><button class=\"docs-menu-close\" type=\"button\" aria-label=\"Close documentation navigation\"><span class=\"k-icon k-i-x\" aria-hidden=\"true\"></span></button><div class=\"docs-sidebar-inner\">[component[Sidenav]]</div></aside><button class=\"docs-menu-backdrop\" type=\"button\" tabindex=\"-1\" aria-label=\"Close documentation navigation\"></button><section class=\"docs-content\">[content[body]class=docs-body]</section></div></div></main>\n    <footer class=\"site-footer\">\n        <div class=\"container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\">\n            <span>&copy; 2026, cCoder</span>\n            <span>Standards-first bespoke cloud software with public documentation and practical platform tools.</span>\n        </div>\n    </footer>\n</div>\n<style>\n.docs-menu-tab,.docs-menu-close,.docs-menu-backdrop{display:none}\n@media(max-width:991.98px){.docs-page{display:block}.docs-page .docs-sidebar{position:fixed;inset:0 auto 0 0;z-index:1060;width:min(86vw,340px);height:100dvh;padding:calc(var(--site-gap)*2);overflow-y:auto;background:var(--site-surface);box-shadow:var(--site-shadow);transform:translateX(-105%);transition:transform .2s ease;visibility:hidden}.docs-page.docs-menu-open .docs-sidebar{transform:translateX(0);visibility:visible}.docs-menu-tab{display:flex;position:fixed;left:0;top:50%;z-index:1050;align-items:center;gap:.4rem;padding:.75rem .55rem;border:var(--site-border);border-left:0;border-radius:0 var(--site-radius) var(--site-radius) 0;background:var(--site-primary);color:var(--site-contrast);box-shadow:var(--site-shadow);writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}.docs-menu-tab:hover,.docs-menu-tab:focus-visible{background:var(--site-secondary)}.docs-menu-close{display:flex;position:sticky;top:0;z-index:1;margin:0 0 var(--site-gap) auto;padding:.55rem;border:var(--site-border);border-radius:var(--site-radius);background:var(--site-primary);color:var(--site-contrast)}.docs-menu-backdrop{position:fixed;inset:0;z-index:1055;width:100%;height:100%;border:0;background:rgba(16,36,63,.42)}.docs-page.docs-menu-open .docs-menu-backdrop{display:block}body.docs-menu-open{overflow:hidden}}\n@media(prefers-reduced-motion:reduce){.docs-page .docs-sidebar{transition:none!important}}\n</style><script src=\"/everything.min.js\" crossorigin=\"anonymous\"></script>\n<script>\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \"[resource_displayname[dateformat]]\";\n    type.shortDateFormat = \"[resource_displayname[shortdateformat]]\";\n    type.moneyFormat = \"[resource_displayname[moneyformat]]\";\n    type.aggregateMoneyFormat = \"[resource_displayname[aggregateMoneyFormat]]\";\n\n    function initDocumentationMenu() {\n        var page = document.querySelector('.docs-page');\n        if (!page) return;\n        var openButton = page.querySelector('.docs-menu-tab');\n        var closeButton = page.querySelector('.docs-menu-close');\n        var backdrop = page.querySelector('.docs-menu-backdrop');\n        var sidebar = page.querySelector('.docs-sidebar');\n        function setOpen(isOpen, restoreFocus) {\n            page.classList.toggle('docs-menu-open', isOpen);\n            document.body.classList.toggle('docs-menu-open', isOpen);\n            openButton.setAttribute('aria-expanded', String(isOpen));\n            sidebar.setAttribute('aria-hidden', String(!isOpen));\n            if (isOpen) closeButton.focus(); else if (restoreFocus) openButton.focus();\n        }\n        openButton.addEventListener('click', function () { setOpen(true, false); });\n        closeButton.addEventListener('click', function () { setOpen(false, true); });\n        backdrop.addEventListener('click', function () { setOpen(false, true); });\n        document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && page.classList.contains('docs-menu-open')) setOpen(false, true); });\n        window.matchMedia('(min-width: 992px)').addEventListener('change', function (event) { if (event.matches) setOpen(false, false); });\n    }\n    initContent();\n    initDocumentationMenu();\n    function updateSiteHeaderDate() {\n        var dateElement = document.getElementById('site-date');\n        if (!dateElement) return;\n        var pageCulture = document.querySelector('meta[property=\"og:locale\"]');\n        var activeCulture = document.querySelector('.culture.active[data-culture]');\n        var cultureName = (pageCulture && pageCulture.getAttribute('content')) || (activeCulture && activeCulture.getAttribute('data-culture')) || (window.kendo && kendo.culture && kendo.culture().name) || navigator.language || 'en-GB';\n        dateElement.textContent = new Intl.DateTimeFormat(cultureName, {\n            day: '2-digit',\n            month: 'long',\n            year: 'numeric'\n        }).format(new Date());\n    }\n    updateSiteHeaderDate();\n    window.addEventListener('load', updateSiteHeaderDate);\n    window.setInterval(updateSiteHeaderDate, 60000);\n\n    kendo.setDefaults('iconType', 'svg');\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\".k-icon:not(.k-svg-icon):not(.k-font-icon)\").each(function() {\n            var iconName = $(this).attr('class').split(' ').filter(function(cls) {\n                return cls !== 'k-icon';\n            })[0].replace(/^k-i-/, \"\").replace(\"source-code\", \"code\");\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: 'svg' });\n\n            if(svgIcon != `<span class=\"k-icon k-svg-icon\" aria-hidden=\"true\"></span>`) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n</script>",
  "Script": "",
  "LastUpdated": "2026-08-01T11:15:00+01:00",
  "PackageType": "ContentManagement/Layout",
  "IncludeInSubSequentImports": false
}
