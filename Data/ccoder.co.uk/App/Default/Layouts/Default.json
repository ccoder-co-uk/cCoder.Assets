{
  "Name": "Default",
  "HeaderHtml": "<meta property=\"keywords\" content=\"[page[keywords]]\" />\n<meta property=\"description\" content=\"[page[description]]\" />\n<meta property=\"og:locale\" content=\"[[culture]]\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"[page[title]]\" />\n<meta property=\"og:description\" content=\"[page[description]]\" />\n<meta property=\"og:url\" content=\"[page[url]]\" />\n<meta property=\"og:site_name\" content=\"[app[name]]\" />\n<meta property=\"og:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:secure_url\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta property=\"og:image:type\" content=\"image/png\" />\n<meta property=\"og:image:width\" content=\"2838\" />\n<meta property=\"og:image:height\" content=\"1088\" />\n<meta property=\"og:image:alt\" content=\"cCoder logo\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"[page[title]]\" />\n<meta name=\"twitter:description\" content=\"[page[description]]\" />\n<meta name=\"twitter:image\" content=\"https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\" />\n<meta name=\"twitter:image:alt\" content=\"cCoder logo\" /><meta name=\"theme-color\" content=\"#0E4A7A\" />\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=600\" />\n<script>(function(){document.querySelectorAll('meta[name=\"viewport\"]').forEach(function(meta){meta.setAttribute('content','width=600');});})();</script>\n<link rel=\"canonical\" href=\"[page[url]]\" />\n<style nonce=\"[request[nonce]]\">\r\n[style[Dependency.Bootstrap.Bootstrap]]\r\n[style[Dependency.Kendo.KendoV20242514Bootstrap]]\r\n[style[Baseline]]\r\n</style>\n[theme[template]]\n<style>\n    .site-shell {\n        display: flex;\n        flex-direction: column;\n        height: 100vh;\n        overflow: hidden;\n    }\n\n    .site-main {\n        overflow: hidden;\n    }\n\n    .site-shell,\n    .site-main,\n    .site-main > .container-fluid,\n    .admin-page-shell {\n        min-height: 0;\n    }\n\n    .site-main,\n    .site-main > .container-fluid,\n    .admin-page-shell,\n    .admin-page-content {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n    }\n\n    .admin-page-shell {\n        gap: 1.5rem;\n        padding: 0.5rem 0 1.5rem;\n    }\n\n    .admin-page-header {\n        flex: 0 0 auto;\n    }\n\n    .admin-page-header h2 {\n        margin: 0;\n    }\n\n    .admin-page-content {\n        min-width: 0;\n        overflow: hidden;\n    }\n\n    .admin-page-content > .component {\n        flex: 1 1 auto;\n        min-height: 0;\n    }\n</style>",
  "Html": "<style>.site-header-row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr 1fr;align-items:start;box-sizing:border-box;height:122px;padding:0}.site-brand{grid-column:1;grid-row:1/3;align-self:center}.site-brand img{flex:0 0 auto;width:auto;max-width:min(77vw,320px);height:clamp(116px,8vw,126px);padding:0}.site-utility{display:flex;grid-column:2;grid-row:1;align-self:start;justify-self:end;flex-direction:row;align-items:center;justify-content:flex-end;gap:var(--site-gap);width:auto!important;margin:0;padding-top:.5rem;transform:translateY(.25rem);white-space:nowrap}.site-utility .component[name=UserProfile] .userName{min-width:0;justify-content:flex-end}.site-nav-host{grid-column:2;grid-row:2;align-self:start;justify-self:end;margin:.25rem 0 0 var(--site-gap)}@media(max-width:991.98px){.site-nav-host{align-self:center;margin-top:0;transform:translateY(-12px)}}</style><script nonce=\"[request[nonce]]\">\r\n[script[Dependency.Jquery.Jquery370]]\r\n[script[Dependency.Jquery.JqueryValidate]]\r\n[script[Dependency.Jquery.JqueryUi]]\r\n[script[Dependency.Kendo.KendoAllV20242514]]\r\n[script[Dependency.Kendo.KendoUiLicense]]\r\n[script[Dependency.Bootstrap.BootstrapBundle]]\r\n[script[Dependency.Other.Signalr]]\r\n[script[Widgets.Widget]]\r\n[script[Core.Api]]\r\n[script[Core.Util]]\r\n[script[Core.Model]]\r\n[script[Monaco.MonacoEditor]]\r\n[script[Monaco.JavaScriptMonacoEditor]]\r\n[script[Monaco.HTMLMonacoEditor]]\r\n[script[Monaco.CSharpMonacoEditor]]\r\n[script[Core.Drawing]]\r\n[script[Widgets.Dialog]]\r\n[script[Widgets.BootstrapDialog]]\r\n[script[Widgets.BootstrapTabs]]\r\n[script[Widgets.Chart]]\r\n[script[Widgets.PieChart]]\r\n[script[Widgets.ConfirmDialog]]\r\n[script[Widgets.ConsoleDialog]]\r\n[script[Widgets.ExportDialog]]\r\n[script[Widgets.Detail]]\r\n[script[Widgets.EditorDialog]]\r\n[script[Widgets.Grid]]\r\n[script[Widgets.ContextMenuWidget]]\r\n[script[Widgets.FileDropContainerWidget]]\r\n[script[Widgets.Picker]]\r\n[script[Widgets.ReadOnlyDetailView]]\r\n[script[Widgets.Tree]]\r\n[script[Widgets.DataTreeView]]\r\n[script[Widgets.OdataTree]]\r\n[script[Widgets.Workspace]]\r\n[script[Widgets.WritableDetailView]]\r\n[script[Workflow.Close]]\r\n[script[Workflow.Handle]]\r\n[script[Workflow.Link]]\r\n[script[Workflow.Action]]\r\n[script[Workflow.Activity]]\r\n[script[Workflow.Connector]]\r\n[script[Workflow.Flow]]\r\n[script[Workflow.Workflowdesigner]]\r\n</script>\n<div class=\"site-shell\">\n    <header class=\"site-header\">\n        <div class=\"container-xxl\">\n            <div class=\"site-header-row\">\n                <a class=\"site-brand\" href=\"/\" title=\"[app[name]]\">\n                    <img src=\"[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\" alt=\"[app[name]]\" /></a>\n                <div class=\"site-nav-host\">[component[TopNav]]</div><div class=\"site-utility\"><div class=\"utility-flags\">[component[CultureFlags]]</div><div class=\"utility-time\"><span id=\"site-date\"></span> <span id=\"time\"></span></div><div class=\"utility-user\">[component[UserProfile]]</div></div>\n            </div>\n        </div>\n    </header>\n    <main class=\"site-main\"><div class=\"container-fluid\"><section class=\"admin-page-shell\"><div class=\"admin-page-header\"><h2>[page[title]]</h2></div><div class=\"admin-page-content\">[content[body]]</div></section></div></main>\n    <footer class=\"site-footer\">\n        <div class=\"container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\">\n            <span>&copy; 2026, cCoder</span>\n            <span>Standards-first bespoke cloud software with public documentation and practical platform tools.</span>\n        </div>\n    </footer>\n</div>\n<script>\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \"[resource_displayname[dateformat]]\";\n    if (!type.dateFormat || type.dateFormat.toLowerCase() === \"dateformat\") { type.dateFormat = \"yyyy MMMM dd\"; }\n    type.shortDateFormat = \"[resource_displayname[shortdateformat]]\";\n    if (!type.shortDateFormat || type.shortDateFormat.toLowerCase() === \"shortdateformat\") { type.shortDateFormat = \"yyyy-MM-dd\"; }\n    type.dateAndTimeFormat = \"[resource_displayname[dateandtimeformat]]\";\n    if (!type.dateAndTimeFormat || type.dateAndTimeFormat.toLowerCase() === \"dateandtimeformat\") { type.dateAndTimeFormat = \"yyyy MMMM dd HH:mm\"; }\n    type.timeFormat = \"[resource_displayname[timeformat]]\";\n    if (!type.timeFormat || type.timeFormat.toLowerCase() === \"timeformat\") { type.timeFormat = \"HH:mm\"; }\n    type.moneyFormat = \"[resource_displayname[moneyformat]]\";\n    type.aggregateMoneyFormat = \"[resource_displayname[aggregateMoneyFormat]]\";\n\n    initContent();\n    function updateSiteHeaderDate() {\n        var dateElement = document.getElementById('site-date');\n        if (!dateElement) return;\n        var pageCulture = document.querySelector('meta[property=\"og:locale\"]');\n        var activeCulture = document.querySelector('.culture.active[data-culture]');\n        var cultureName = (pageCulture && pageCulture.getAttribute('content')) || (activeCulture && activeCulture.getAttribute('data-culture')) || (window.kendo && kendo.culture && kendo.culture().name) || navigator.language || 'en-GB';\n        dateElement.textContent = new Intl.DateTimeFormat(cultureName, {\n            day: '2-digit',\n            month: 'long',\n            year: 'numeric'\n        }).format(new Date());\n    }\n    updateSiteHeaderDate();\n    window.addEventListener('load', updateSiteHeaderDate);\n    window.setInterval(updateSiteHeaderDate, 60000);\n\n    kendo.setDefaults('iconType', 'svg');\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\".k-icon:not(.k-svg-icon):not(.k-font-icon)\").each(function() {\n            var iconName = $(this).attr('class').split(' ').filter(function(cls) {\n                return cls !== 'k-icon';\n            })[0].replace(/^k-i-/, \"\").replace(\"source-code\", \"code\");\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: 'svg' });\n\n            if(svgIcon != `<span class=\"k-icon k-svg-icon\" aria-hidden=\"true\"></span>`) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n</script>",
