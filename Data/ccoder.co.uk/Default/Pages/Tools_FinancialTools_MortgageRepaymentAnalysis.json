    {
      "CultureId": "",
      "Name": "body",
      "Html": "   <div class=\"container mt-6 tool-surface\">\r\n        <h1 class=\"mb-3\">Mortgage Repayment Analysis</h1><p class=\"tool-summary mb-0\">Adjust the repayment assumptions below to compare balance reduction, interest exposure, and equity growth over time.</p>\r\n        <form id=\"mortgage-form\">\r\n            <div class=\"row g-4 mortgage-form-grid\">\r\n                <div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"initialBalance\">Initial Balance</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"initialBalance\" placeholder=\"Initial Balance\" value=\"280000\" required>\r\n                </div>\r\n                <div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"initialInterestRate\">Initial Interest Rate (%)</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"initialInterestRate\" placeholder=\"Initial Interest Rate\" value=\"3.59\" required>\r\n                </div>\r\n                <div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"initialPeriod\">Initial Interest Rate Period (months)</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"initialPeriod\" placeholder=\"Initial Interest Rate Period\" value=\"60\" required>\r\n                </div>\r\n                <div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"variableInterestRate\">Variable Interest Rate (%)</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"variableInterestRate\" placeholder=\"Variable Interest Rate\" value=\"4.5\" required>\r\n                </div>\r\n                <div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"repaymentAmount\">Repayment Amount</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"repaymentAmount\" placeholder=\"Repayment Amount\" value=\"1322\" required>\r\n                </div>\r\n\t\t\t\t<div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"repaymentAmount\">Equity</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"equity\" placeholder=\"Equity\" value=\"70000\" required>\r\n                </div>\r\n\t\t\t\t<div class=\"col-xl-3 col-md-6\">\r\n                    <label for=\"repaymentAmount\">Property Value</label>\r\n                    <input type=\"number\" class=\"form-control\" id=\"propertyValue\" placeholder=\"Property Value\" value=\"350000\" required>\r\n                </div>\r\n            </div>\r\n            <button type=\"button\" class=\"btn btn-primary mt-4\" onclick=\"calculateMortgage()\">Recalculate</button>\r\n        </form>\r\n\t</div>\r\n\t<div class=\"container mt-3 tool-surface\">\r\n\t\t<div class=\"row g-3\">\r\n\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t<h2 class=\"mt-5\">Payment Indication</h2>\r\n\t\t\t\t<div id=\"paymentChart\" class=\"mortgage-chart mb-5\"></div>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t<h2 class=\"mt-5\">Investment (ROI) Indication</h2>\r\n\t\t\t\t<div id=\"investmentChart\" class=\"mortgage-chart mb-5\"></div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\r\n\t</div>\r\n\t<div class=\"container mt-3 mb-3 tool-surface\">\r\n\t\t<h2>Breakdown</h2>\r\n\t\t<div class=\"table-container\">\r\n\t\t\t<table class=\"table table-striped align-middle mb-0\">\r\n\t\t\t\t<thead>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<th>Month</th>\r\n\t\t\t\t\t\t<th>Balance</th>\r\n\t\t\t\t\t\t<th>Repayment</th>\r\n\t\t\t\t\t\t<th>Interest</th>\r\n\t\t\t\t\t\t<th>Principal</th>\r\n\t\t\t\t\t\t<th>Property Value (est)</th>\r\n\t\t\t\t\t\t<th>Interest Rate</th>\r\n\t\t\t\t\t\t<th>Equity</th>\r\n\t\t\t\t\t\t<th>Total Interest</th>\r\n\t\t\t\t\t\t<th>Total Principal</th>\r\n\t\t\t\t\t\t<th>Total Investment</th>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</thead>\r\n\t\t\t\t<tbody id=\"mortgageTableBody\">\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n<style id=\"mortgage-chart-tidy\">\r\n.mortgage-form-grid{align-items:end}\r\n.mortgage-form-grid{margin-left:calc(var(--site-gap)*-.75)!important;margin-right:calc(var(--site-gap)*-.75)!important;row-gap:calc(var(--site-gap)*1.5)!important}\r\n.mortgage-form-grid>[class*=col-]{display:flex;flex-direction:column;gap:calc(var(--site-gap)*.5);padding-left:calc(var(--site-gap)*.75)!important;padding-right:calc(var(--site-gap)*.75)!important}\r\n.mortgage-chart{height:340px;width:100%}\r\n.mortgage-chart>.k-chart{height:100%}\r\n@media (max-width:767.98px){.mortgage-chart{height:280px}}\r\n</style>\r\n<script>\r\n\t\tvar paymentChart;\r\n\t\tvar investmentChart;\r\n\r\n\t\tfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart && typeof chart.destroy === 'function') {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: 'svg',\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: 'transparent'\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: 'bottom'\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: 'line',\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: 'Month' },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: 'Amount' },\r\n\t\t\t\t\tlabels: { format: '{0:c0}' }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: '#= series.name #: #= kendo.toString(value, \"c0\") #'\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data('kendoChart');\r\n\t\t}\r\nfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart && typeof chart.destroy === 'function') {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: 'svg',\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: 'transparent'\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: 'bottom'\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: 'line',\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: 'Month' },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: 'Amount' },\r\n\t\t\t\t\tlabels: { format: '{0:c0}' }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: '#= series.name #: #= kendo.toString(value, \"c0\") #'\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data('kendoChart');\r\n\t\t}\r\nfunction destroyMortgageChart(chart, selector) {\r\n\t\t\tif (chart && typeof chart.destroy === 'function') {\r\n\t\t\t\tchart.destroy();\r\n\t\t\t}\r\n\r\n\t\t\tconst element = $(selector);\r\n\t\t\tkendo.destroy(element);\r\n\t\t\telement.empty();\r\n\t\t}\r\n\r\n\t\tfunction buildMortgageChart(selector, categories, series) {\r\n\t\t\tconst element = $(selector);\r\n\t\t\telement.kendoChart({\r\n\t\t\t\trenderAs: 'svg',\r\n\t\t\t\ttransitions: false,\r\n\t\t\t\tchartArea: {\r\n\t\t\t\t\tbackground: 'transparent'\r\n\t\t\t\t},\r\n\t\t\t\tlegend: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\tposition: 'bottom'\r\n\t\t\t\t},\r\n\t\t\t\tseriesDefaults: {\r\n\t\t\t\t\ttype: 'line',\r\n\t\t\t\t\tmarkers: {\r\n\t\t\t\t\t\tvisible: false\r\n\t\t\t\t\t},\r\n\t\t\t\t\twidth: 2\r\n\t\t\t\t},\r\n\t\t\t\tseries: series,\r\n\t\t\t\tcategoryAxis: {\r\n\t\t\t\t\tcategories: categories,\r\n\t\t\t\t\ttitle: { text: 'Month' },\r\n\t\t\t\t\tmajorGridLines: { visible: false }\r\n\t\t\t\t},\r\n\t\t\t\tvalueAxis: {\r\n\t\t\t\t\ttitle: { text: 'Amount' },\r\n\t\t\t\t\tlabels: { format: '{0:c0}' }\r\n\t\t\t\t},\r\n\t\t\t\ttooltip: {\r\n\t\t\t\t\tvisible: true,\r\n\t\t\t\t\ttemplate: '#= series.name #: #= kendo.toString(value, \"c0\") #'\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn element.data('kendoChart');\r\n\t\t}\r\nfunction calculateMortgage() {\r\n\t\t\tconst initialBalance = parseFloat(document.getElementById('initialBalance').value);\r\n\t\t\tconst initialInterestRate = parseFloat(document.getElementById('initialInterestRate').value) / 100;\r\n\t\t\tconst initialPeriod = parseInt(document.getElementById('initialPeriod').value);\r\n\t\t\tconst variableInterestRate = parseFloat(document.getElementById('variableInterestRate').value) / 100;\r\n\t\t\tconst repaymentAmount = parseFloat(document.getElementById('repaymentAmount').value);\r\n\t\t\t\r\n\t\t\tlet balance = parseFloat(document.getElementById('initialBalance').value);\r\n\t\t\tlet equity = parseFloat(document.getElementById('equity').value);\r\n\t\t\tlet propertyValue = parseFloat(document.getElementById('propertyValue').value);\r\n\t\t\tlet totalInterest = 0;\r\n\t\t\tlet totalPrincipal = 0; \r\n\t\t\tlet totalInvestment = 0;\r\n\t\t\tlet months = 0;\r\n\t\t\tlet mortgageData = [];\r\n\r\n\t\t\twhile (balance > 0 && months < 420) { // limiting to 35 years\r\n\t\t\t\tlet interestRate = months < initialPeriod ? initialInterestRate : variableInterestRate;\r\n\t\t\t\tlet interest = balance * interestRate / 12;\r\n\t\t\t\tlet principal = Math.min(repaymentAmount - interest, balance);\r\n\t\t\t\tbalance -= principal;\r\n\t\t\t\tequity += principal;\r\n\t\t\t\tpropertyValue += propertyValue * (0.005 / 12); // Example house value increase per month\r\n\r\n\t\t\t\tmortgageData.push({\r\n\t\t\t\t\tmonth: months + 1,\r\n\t\t\t\t\tbalance: balance,\r\n\t\t\t\t\trepayment: repaymentAmount,\r\n\t\t\t\t\tinterest: interest,\r\n\t\t\t\t\tprincipal: principal,\r\n\t\t\t\t\tequity: equity,\r\n\t\t\t\t\tpropertyValue: propertyValue,\r\n\t\t\t\t\tinterestRate: (interestRate * 100),\r\n\t\t\t\t\ttotalInterest: (totalInterest += interest),\r\n\t\t\t\t\ttotalPrincipal: (totalPrincipal += principal),\r\n\t\t\t\t\ttotalInvestment: (totalInvestment += repaymentAmount)\r\n\t\t\t\t});\r\n\r\n\t\t\t\tmonths++;\r\n\t\t\t}\r\n\r\n\t\t\tdestroyMortgageChart(paymentChart, '#paymentChart');\r\n\t\t\tdestroyMortgageChart(investmentChart, '#investmentChart');\r\n\r\n\t\t\tpaymentChart = updatePaymentChart(mortgageData);\r\n\t\t\tinvestmentChart = updateInvestmentChart(mortgageData);\r\n\t\t\tupdateTable(mortgageData);\r\n\t\t}\r\n\r\n\t\tfunction updatePaymentChart(mortgageData) {\r\n\t\t\treturn buildMortgageChart('#paymentChart', mortgageData.map(i => i.month + 1), [\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Repayment',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.repayment),\r\n\t\t\t\t\tcolor: 'green'\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Interest',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.interest),\r\n\t\t\t\t\tcolor: 'red'\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Principal',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.principal),\r\n\t\t\t\t\tcolor: 'orange'\r\n\t\t\t\t}\r\n\t\t\t]);\r\n\t\t}\r\n\r\n\t\tfunction updateInvestmentChart(mortgageData) {\r\n\t\t\treturn buildMortgageChart('#investmentChart', mortgageData.map(i => i.month + 1), [\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Interest Paid (Total)',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.totalInterest),\r\n\t\t\t\t\tcolor: 'green'\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Capital Owned (Equity)',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.equity),\r\n\t\t\t\t\tcolor: 'red'\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Repayments Total',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.totalInvestment),\r\n\t\t\t\t\tcolor: 'orange'\r\n\t\t\t\t},\r\n\t\t\t\t{\r\n\t\t\t\t\tname: 'Property Value',\r\n\t\t\t\t\tdata: mortgageData.map(i => i.propertyValue),\r\n\t\t\t\t\tcolor: 'lightblue'\r\n\t\t\t\t}\r\n\t\t\t]);\r\n\t\t}\r\n\r\n\t\tfunction updateTable(mortgageData) {\r\n\t\t\tconst table = document.getElementById('mortgageTableBody');\r\n\t\t\ttable.innerHTML = '';\r\n\t\t\tmortgageData.forEach(row => {\r\n\t\t\t\tconst rowHtml = `<tr>\r\n\t\t\t\t\t<td>${row.month}</td>\r\n\t\t\t\t\t<td>${row.balance.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.repayment.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.interest.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.principal.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.propertyValue.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.interestRate.toFixed(2) + \"%\"}</td>\r\n\t\t\t\t\t<td>${row.equity.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.totalInterest.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.totalPrincipal.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t\t<td>${row.totalInvestment.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' })}</td>\r\n\t\t\t\t</tr>`;\r\n\t\t\t\ttable.innerHTML += rowHtml;\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tdocument.addEventListener('DOMContentLoaded', calculateMortgage);\r\n    </script>"
    }
  ],
