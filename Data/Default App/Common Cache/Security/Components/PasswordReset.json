{
  "Name": "PasswordReset",
  "Key": "Security",
  "ResourceKey": "Security",
  "Script": "PasswordReset = {\n  init: async function (app, container) {\n    app = app || session.app;\n    container = container || $(\u0022.component[name=PasswordReset]\u0022);\n    $(\u0022button[name=submitReset]\u0022, container).on(\u0022click\u0022, async function (event) { event.preventDefault(); await PasswordReset.confirm(app, container); });\n  },\n  confirm: async function (app, container) {\n    var url = new URL(window.location.href);\n    var resetRequest = { UserId: url.searchParams.get(\u0022uid\u0022), NewPassword: $(\u0022input[name=pass]\u0022, container).val(), ConfirmPassword: $(\u0022input[name=confirm]\u0022, container).val(), Token: url.searchParams.get(\u0022token\u0022), SourceAppId: app.Id };\n    var result = await api.post(\u0022Account/ConfirmForgotPassword\u0022, resetRequest);\n    if (!(result || result === \u0022\u0022)) { notification.error(\u0022[resource_description[ResetFailed]]\u0022); return; }\n    notification.success(\u0022[resource_description[ResetSuccess]]\u0022);\n    try {\n      await api.login(resetRequest.UserId, resetRequest.NewPassword, true);\n      window.location.replace(\u0022/\u0022);\n    } catch (_) {\n      notification.error(\u0022[resource_description[ResetLoginFailed]]\u0022);\n    }\n  }\n};\n$(function () { PasswordReset.init(); });\n",
  "Content": "\u003Cstyle nonce=\u0022[request[nonce]]\u0022\u003E\n.component[name=PasswordReset]{height:auto;border:0;box-shadow:none;background:transparent}\n.component[name=PasswordReset] .ccoder-code-form{width:min(100%,720px);margin:20px auto;padding:28px;border:1px solid #cfdee8;border-left:4px solid #142a48;border-radius:4px;background:#f8fbfd;box-shadow:0 12px 30px rgba(20,42,72,.08);color:#142a48;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}\n.component[name=PasswordReset] .ccoder-code-line{margin:0 0 10px}\n.component[name=PasswordReset] .ccoder-code-indent{padding-left:20px}\n.component[name=PasswordReset] .ccoder-keyword{color:#075ccc}\n.component[name=PasswordReset] .ccoder-type{color:#008575}\n.component[name=PasswordReset] .ccoder-punctuation{color:#16a7e0}\n.component[name=PasswordReset] .ccoder-code-fields{display:grid;gap:12px;margin:14px 0;padding:0 0 0 20px;list-style:none}\n.component[name=PasswordReset] .ccoder-field{display:grid;grid-template-columns:10rem minmax(0,1fr);align-items:center;gap:12px}\n.component[name=PasswordReset] .form-control{width:100%;padding:9px 11px;border:1px solid #cfdee8;border-radius:2px;background:#fff}\n.component[name=PasswordReset] .ccoder-code-actions{display:flex;justify-content:flex-end;margin:20px 0 8px}\n.component[name=PasswordReset] .ccoder-code-actions .btn{font-family:inherit}\n@media(max-width:620px){.component[name=PasswordReset] .ccoder-code-form{padding:20px}.component[name=PasswordReset] .ccoder-field{grid-template-columns:1fr;gap:5px}.component[name=PasswordReset] .ccoder-code-indent{padding-left:12px}}\n\u003C/style\u003E\n\u003Cform class=\u0022ccoder-code-form\u0022 autocomplete=\u0022off\u0022\u003E\n  \u003Cdiv class=\u0022ccoder-code-line\u0022\u003E\u003Cspan class=\u0022ccoder-keyword\u0022\u003Evoid\u003C/span\u003E ResetPassword()\u003C/div\u003E\n  \u003Cdiv class=\u0022ccoder-code-line ccoder-punctuation\u0022\u003E{\u003C/div\u003E\n  \u003Cdiv class=\u0022ccoder-code-indent\u0022\u003E\n    \u003Cdiv class=\u0022ccoder-code-line\u0022\u003E\u003Cspan class=\u0022ccoder-keyword\u0022\u003Evar\u003C/span\u003E details = \u003Cspan class=\u0022ccoder-keyword\u0022\u003Enew\u003C/span\u003E \u003Cspan class=\u0022ccoder-type\u0022\u003EPasswordResetDetails\u003C/span\u003E()\u003C/div\u003E\n    \u003Cdiv class=\u0022ccoder-code-line ccoder-punctuation\u0022\u003E{\u003C/div\u003E\n    \u003Cul class=\u0022ccoder-code-fields ccoder-code-indent\u0022\u003E\n      \u003Cli class=\u0022ccoder-field\u0022\u003E\u003Clabel for=\u0022password-reset-new\u0022\u003E[resource_displayname[Password]] =\u003C/label\u003E\u003Cinput id=\u0022password-reset-new\u0022 type=\u0022password\u0022 name=\u0022pass\u0022 required autocomplete=\u0022new-password\u0022 class=\u0022form-control\u0022 /\u003E\u003C/li\u003E\n      \u003Cli class=\u0022ccoder-field\u0022\u003E\u003Clabel for=\u0022password-reset-confirm\u0022\u003E[resource_displayname[ConfirmPassword]] =\u003C/label\u003E\u003Cinput id=\u0022password-reset-confirm\u0022 type=\u0022password\u0022 name=\u0022confirm\u0022 required autocomplete=\u0022new-password\u0022 class=\u0022form-control\u0022 /\u003E\u003C/li\u003E\n    \u003C/ul\u003E\n    \u003Cdiv class=\u0022ccoder-code-line ccoder-punctuation\u0022\u003E};\u003C/div\u003E\n    \u003Cdiv class=\u0022ccoder-code-actions\u0022\u003E\u003Cbutton name=\u0022submitReset\u0022 type=\u0022submit\u0022 class=\u0022btn btn-primary\u0022\u003E\u003Cspan class=\u0022k-icon k-i-play\u0022\u003E\u003C/span\u003E Submit(details);\u003C/button\u003E\u003C/div\u003E\n  \u003C/div\u003E\n  \u003Cdiv class=\u0022ccoder-code-line ccoder-punctuation\u0022\u003E}\u003C/div\u003E\n\u003C/form\u003E",
