{
  "Key": "ContentManagement",
  "Name": "AppTheming",
  "ResourceKey": "ContentManagement",
  "Content": "<div class=\"app-theming-shell\">\n  <section class=\"app-theming-assets\" aria-labelledby=\"app-theming-assets-title\">\n    <h4 id=\"app-theming-assets-title\"><span class=\"k-icon k-i-image\"></span> Site assets</h4>\n    <div class=\"app-theming-asset-list\">\n      <label class=\"app-theming-asset\" for=\"app-theming-brand-logo\">\n        <span class=\"app-theming-preview\"><img src=\"/images/ccoder-logo.png\" name=\"brand-logo-preview\" alt=\"\" /></span>\n        <span class=\"app-theming-asset-copy\"><strong>Brand logo</strong><small>Company identity shown in the site header.</small></span>\n        <span class=\"btn btn-sm btn-primary\"><span class=\"k-icon k-i-upload\"></span> Replace</span>\n        <input type=\"file\" accept=\"image/*\" name=\"brand-logo\" id=\"app-theming-brand-logo\" />\n      </label>\n      <label class=\"app-theming-asset\" for=\"app-theming-project-logo\">\n        <span class=\"app-theming-preview\"><img src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==\" name=\"project-logo-preview\" alt=\"\" /></span>\n        <span class=\"app-theming-asset-copy\"><strong>Project logo</strong><small>Secondary project or product identity.</small></span>\n        <span class=\"btn btn-sm btn-primary\"><span class=\"k-icon k-i-upload\"></span> Replace</span>\n        <input type=\"file\" accept=\"image/*\" name=\"project-logo\" id=\"app-theming-project-logo\" />\n      </label>\n      <label class=\"app-theming-asset\" for=\"app-theming-animation\">\n        <span class=\"app-theming-preview\"><img src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==\" name=\"animation-preview\" alt=\"\" /></span>\n        <span class=\"app-theming-asset-copy\"><strong>Animation</strong><small>Optional animated background asset.</small></span>\n        <span class=\"btn btn-sm btn-primary\"><span class=\"k-icon k-i-upload\"></span> Replace</span>\n        <input type=\"file\" accept=\"image/gif,image/webp,video/*\" name=\"animation\" id=\"app-theming-animation\" />\n      </label>\n    </div>\n  </section>\n  <section class=\"app-theming-themes\" aria-labelledby=\"app-theming-themes-title\">\n    <h4 id=\"app-theming-themes-title\"><span class=\"k-icon k-i-palette\"></span> Themes</h4>\n    <p class=\"app-theming-intro\">Create and edit the semantic colour, type, border and spacing settings available to this app.</p>\n    [component[AppThemeList]]\n  </section>\n</div>\n<style>\n.component[name=AppTheming] { display:flex; flex:1 1 auto; min-height:0; margin:0; overflow:auto; padding:18px; background:[theme[colours.background]]; }\n.component[name=AppTheming] .app-theming-shell { display:grid; grid-template-columns:minmax(320px, .8fr) minmax(460px, 1.2fr); gap:18px; width:100%; align-content:start; }\n.component[name=AppTheming] section { min-width:0; padding:18px; border:[theme[border.style]]; border-radius:max(8px, [theme[border.radius]]); background:[theme[colours.background]]; box-shadow:0 8px 24px rgba(20,42,72,.08); }\n.component[name=AppTheming] h4 { display:flex; align-items:center; gap:8px; margin:0 0 14px; color:[theme[colours.primary]]; }\n.component[name=AppTheming] .app-theming-intro { margin:-6px 0 14px; color:[theme[colours.text]]; opacity:.72; }\n.component[name=AppTheming] .app-theming-asset-list { display:grid; gap:10px; }\n.component[name=AppTheming] .app-theming-asset { display:grid; grid-template-columns:56px minmax(0,1fr) auto; gap:12px; align-items:center; padding:10px; margin:0; cursor:pointer; border:[theme[border.style]]; border-radius:max(6px, [theme[border.radius]]); transition:border-color .15s ease, box-shadow .15s ease; }\n.component[name=AppTheming] .app-theming-asset:hover { border-color:[theme[colours.secondary]]; box-shadow:0 0 0 3px color-mix(in srgb, [theme[colours.secondary]] 18%, transparent); }\n.component[name=AppTheming] .app-theming-preview { display:flex; align-items:center; justify-content:center; width:56px; height:46px; overflow:hidden; border-radius:5px; background:color-mix(in srgb, [theme[colours.primary]] 7%, [theme[colours.background]]); }\n.component[name=AppTheming] .app-theming-preview img { display:block; max-width:100%; max-height:100%; object-fit:contain; }\n.component[name=AppTheming] .app-theming-preview img.asset-missing { visibility:hidden; }\n.component[name=AppTheming] .app-theming-asset-copy { display:flex; min-width:0; flex-direction:column; color:[theme[colours.text]]; }\n.component[name=AppTheming] .app-theming-asset-copy small { margin-top:2px; opacity:.68; }\n.component[name=AppTheming] input[type=file] { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }\n.component[name=AppTheming] .component[name=AppThemeList] { margin:0; width:100%; }\n@media (max-width: 980px) { .component[name=AppTheming] .app-theming-shell { grid-template-columns:1fr; } }\n</style>",
  "Script": "AppTheming = {\n  init: async function(app, container) {\n    app = app || session.app;\n    container = container || $(\".component[name=AppTheming]\");\n    AppTheming.wireUpEvents(container);\n    AppTheming.hideMissingPreviews(container);\n  },\n\n  wireUpEvents: function(container) {\n    AppTheming.wireUpFileUploading($(\"input[name=brand-logo]\", container), $(\"img[name=brand-logo-preview]\", container), \"Content/CompanyLogo.png\");\n    AppTheming.wireUpFileUploading($(\"input[name=project-logo]\", container), $(\"img[name=project-logo-preview]\", container), \"Content/CompanyLogo2.png\");\n    AppTheming.wireUpFileUploading($(\"input[name=animation]\", container), $(\"img[name=animation-preview]\", container), \"Content/background.gif\");\n  },\n\n  wireUpFileUploading: function(element, preview, path) {\n    element.off(\"change.appTheming\").on(\"change.appTheming\", function(event) {\n      return AppTheming.handleFileUploadEvent(event, preview, path);\n    });\n  },\n\n  handleFileUploadEvent: async function(event, preview, path) {\n    var files = event.target.files || [];\n    if (files.length > 1) {\n      error(\"Select one file only\");\n      return;\n    }\n    if (!files.length) return;\n    AppTheming.handleFileUploadPreview(files[0], preview);\n    await api.file.upload(path, files[0]);\n    notification.success(\"[resource_displayname[saved]]\");\n  },\n\n  handleFileUploadPreview: function(file, preview) {\n    var objectUrl = URL.createObjectURL(file);\n    preview.removeClass(\"asset-missing\").attr(\"src\", objectUrl).one(\"load\", function() { URL.revokeObjectURL(objectUrl); });\n  },\n\n  hideMissingPreviews: function(container) {\n    $(\".app-theming-preview img\", container).each(function() {\n      var image = $(this);\n      image.off(\"error.appTheming\").on(\"error.appTheming\", function() { image.addClass(\"asset-missing\"); });\n      if (this.complete && !this.naturalWidth) image.addClass(\"asset-missing\");\n    });\n  }\n};",
  "CreatedOn": "2022-09-16T09:03:40.943Z",
  "LastUpdated": "2026-07-27T14:00:00+01:00",
  "IncludeInSubSequentImports": true,
  "PackageType": "ContentManagement/Component"
}
