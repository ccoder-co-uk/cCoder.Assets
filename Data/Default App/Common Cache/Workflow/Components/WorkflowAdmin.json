{
  "Name": "WorkflowAdmin",
  "Key": "Workflow",
  "ResourceKey": "Workflow",
  "Script": "WorkflowAdmin = {\n    init: async function (app, container) {\n        app = app || session.app;\n        container = container || $(\".component[name=WorkflowAdmin]\");\n\n        var initialized = {};\n        var initializeTab = async function (name) {\n            if (initialized[name]) return;\n\n            initialized[name] = true;\n            var pane = $(\"[data-workflow-admin-pane=\" + name + \"]\", container);\n\n            if (name === \"workflows\") {\n                await WorkflowManagement.init(app, $(\".component[name=WorkflowList]\", pane));\n            } else if (name === \"scheduling\") {\n                await Scheduling.init(app, $(\".component[name=WorkflowScheduling]\", pane));\n            }\n        };\n\n        $(\"[data-bs-toggle=tab]\", container).on(\"shown.bs.tab\", async function (event) {\n            await initializeTab($(event.target).data(\"workflow-admin-tab\"));\n        });\n\n        await initializeTab(\"workflows\");\n    }\n}",
  "Content": "<style nonce=\"[request[nonce]]\"></style>\r\n<div class=\"tab-control workflow-admin-tabs\">\n    <nav>\n        <div class=\"nav nav-tabs\" id=\"workflow-admin-nav-tab\" role=\"tablist\">\n            <button class=\"nav-link bg active\" id=\"workflow-admin-workflows-tab\" data-bs-toggle=\"tab\" data-bs-target=\"#workflow-admin-workflows\" data-workflow-admin-tab=\"workflows\" type=\"button\" role=\"tab\" aria-controls=\"workflow-admin-workflows\" aria-selected=\"true\">\n                <span class=\"k-icon k-i-arrows-swap\"></span>[resource_displayname[workflows]]\n            </button>\n            <button class=\"nav-link bg\" id=\"workflow-admin-scheduling-tab\" data-bs-toggle=\"tab\" data-bs-target=\"#workflow-admin-scheduling\" data-workflow-admin-tab=\"scheduling\" type=\"button\" role=\"tab\" aria-controls=\"workflow-admin-scheduling\" aria-selected=\"false\" tabindex=\"-1\">\n                <span class=\"k-icon k-i-clock\"></span>[resource_displayname[scheduling]]\n            </button>\n        </div>\n    </nav>\n\n    <div class=\"tab-content\" id=\"workflow-admin-nav-tabContent\">\n        <div class=\"tab-pane fade active show\" id=\"workflow-admin-workflows\" data-workflow-admin-pane=\"workflows\" role=\"tabpanel\" aria-labelledby=\"workflow-admin-workflows-tab\">\n            [component[WorkflowList]]\n        </div>\n        <div class=\"tab-pane fade\" id=\"workflow-admin-scheduling\" data-workflow-admin-pane=\"scheduling\" role=\"tabpanel\" aria-labelledby=\"workflow-admin-scheduling-tab\">\n            [component[WorkflowScheduling]]\n        </div>\n    </div>\n</div>\n\n<style scoped>\n    .component[name=WorkflowAdmin],\n    .component[name=WorkflowAdmin] > .workflow-admin-tabs,\n    .component[name=WorkflowAdmin] > .workflow-admin-tabs > .tab-content,\n    .component[name=WorkflowAdmin] > .workflow-admin-tabs > .tab-content > .tab-pane.active {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n        min-height: 0;\n        height: 100%;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] > .workflow-admin-tabs > nav {\n        flex: 0 0 auto;\n    }\n\n    .component[name=WorkflowAdmin] > .workflow-admin-tabs > .tab-content > .tab-pane {\n        display: none;\n        min-height: 0;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] .tab-pane.active > .component,\n    .component[name=WorkflowAdmin] .tab-pane.active > .component > .k-grid {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n        min-height: 0;\n        height: 100%;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] .tab-pane.active .k-grid-content,\n    .component[name=WorkflowAdmin] .tab-pane.active .k-grid-content-locked {\n        flex: 1 1 auto;\n        min-height: 0;\n        overflow: auto;\n    }\n</style>",
  "LastUpdated": "2026-07-27T12:00:00+01:00",
  "PackageType": "ContentManagement/Component",
  "IncludeInSubSequentImports": false
}
