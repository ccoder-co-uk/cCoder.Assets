  "Content": "\u003Cdiv class=\u0022k-toolbar\u0022 name=\u0022appToolbar\u0022\u003E\u003C/div\u003E\n\n\u003Cdiv class=\u0022tab-control\u0022\u003E\n   \u003Cnav\u003E\n      \u003Cdiv class=\u0022nav nav-tabs\u0022 id=\u0022app-management-nav-tab\u0022 role=\u0022tablist\u0022\u003E\n         \u003Cbutton class=\u0022nav-link bg active\u0022 id=\u0022app-management-config-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-config\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-config\u0022 aria-selected=\u0022true\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-edit\u0022\u003E\u003C/span\u003E[resource_displayname[configuration]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-theming-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-theming\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-theming\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-palette\u0022\u003E\u003C/span\u003E[resource_displayname[theming]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-cultures-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-cultures\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-cultures\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-globe\u0022\u003E\u003C/span\u003E[resource_displayname[cultures]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-layouts-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-layouts\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-layouts\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-grid-layout\u0022\u003E\u003C/span\u003E[resource_displayname[layouts]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-templates-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-templates\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-templates\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-css\u0022\u003E\u003C/span\u003E[resource_displayname[templates]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-components-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-components\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-components\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-source-code\u0022\u003E\u003C/span\u003E[resource_displayname[components]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-resources-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-resources\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-resources\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-foreground-color\u0022\u003E\u003C/span\u003E[resource_displayname[resources]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-roles-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-roles\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-roles\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-user\u0022\u003E\u003C/span\u003E[resource_displayname[roles]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-scheduling-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-scheduling\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-scheduling\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-clock\u0022\u003E\u003C/span\u003E[resource_displayname[scheduling]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-mailmanagement-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-mailmanagement\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-mailmanagement\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-inbox\u0022\u003E\u003C/span\u003E[resource_displayname[mailmanagement]]\n         \u003C/button\u003E\n         \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022app-management-logstream-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#app-management-logstream\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022app-management-logstream\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n            \u003Cspan class=\u0022k-icon k-i-clipboard-text\u0022\u003E\u003C/span\u003E[resource_displayname[logstream]]\n         \u003C/button\u003E\n      \u003C/div\u003E\n   \u003C/nav\u003E\n\n   \u003Cdiv class=\u0022tab-content\u0022 id=\u0022app-management-nav-tabContent\u0022\u003E\n      \u003Cdiv class=\u0022tab-pane fade active show\u0022 id=\u0022app-management-config\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-config-tab\u0022 name=\u0022config\u0022\u003E\u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-theming\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-theming-tab\u0022 name=\u0022theming\u0022\u003E\n         [component[AppTheming]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-cultures\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-cultures-tab\u0022 name=\u0022cultures\u0022\u003E\n         [component[CultureManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-layouts\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-layouts-tab\u0022 name=\u0022layouts\u0022\u003E\n         [component[LayoutManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-templates\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-templates-tab\u0022 name=\u0022templates\u0022\u003E\n         [component[TemplateManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-components\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-components-tab\u0022 name=\u0022components\u0022\u003E\n         [component[ComponentManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-resources\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-resources-tab\u0022 name=\u0022resources\u0022\u003E\n         [component[ResourceManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-roles\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-roles-tab\u0022 name=\u0022roles\u0022\u003E\n         [component[RoleManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-scheduling\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-scheduling-tab\u0022 name=\u0022scheduling\u0022\u003E\n         [component[Scheduling]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-mailmanagement\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-mailmanagement-tab\u0022 name=\u0022mailmanagement\u0022\u003E\n         [component[MailManagement]]\n      \u003C/div\u003E\n      \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022app-management-logstream\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022app-management-logstream-tab\u0022 name=\u0022logstream\u0022\u003E\n         [component[LogStream]]\n      \u003C/div\u003E\n   \u003C/div\u003E\n\u003C/div\u003E\n\n\u003Cdiv class=\u0022hidden\u0022\u003E\n   [component[AppMigrator]]\n\u003C/div\u003E",
  "Script": "AppManagement = {\n    toolbar: true,\n\n    init: async function (app, container) {\n        app = app || session.app;\n        container = container || $(\u0022.component[name=AppManagement]\u0022)[0];\n        app = await api.get(\u0022ContentManagement/App(\u0022 \u002B app.Id \u002B \u0022)\u0022);\n        app.Config = JSON.parse(app.ConfigJson);\n        if (AppManagement.toolbar) {\n            $(\u0022[name=appToolbar]\u0022).kendoToolBar({\n                items: [\n                    {\n                        text: \u0022[resource_displayname[save]]\u0022,\n                        type: \u0022button\u0022,\n                        template: \u0060\n                            \u003Cbutton class=\u0022btn btn-primary\u0022 name=\u0022appSave\u0022\u003E\n                                \u003Cspan class=\u0027k-icon k-i-save\u0027\u003E\u003C/span\u003E [resource_displayname[Save]]\n                            \u003C/button\u003E\u0060\n                    },\n                    {\n                        text: \u0022[resource_displayname[migrate]]\u0022,\n                        type: \u0022button\u0022,\n                        template: \u0060\n                            \u003Cbutton class=\u0022btn btn-primary\u0022 name=\u0022appMigrate\u0022 data-bs-toggle=\u0022modal\u0022 data-bs-target=\u0022#app-migrator-model\u0022\u003E\n                                \u003Cspan class=\u0027k-icon k-i-arrow-up\u0027\u003E\u003C/span\u003E [resource_displayname[Migrate]]\n                            \u003C/button\u003E\u0060\n                    }\n                ]\n            });\n        } else {\n            $(\u0022[name=appToolbar]\u0022, container).remove();\n        }\n\n        if ($(\u0022.tab-pane[name=config]\u0022, container)[0].childElementCount === 0) {\n            var configEditor = new MonacoEditor($(\u0022.tab-pane[name=config]\u0022, container)[0], {\n                code: app.ConfigJson,\n                language: \u0022json\u0022,\n                automaticLayout: true\n            });\n            configEditor.onChange = () =\u003E app.ConfigJson = configEditor.getValue();\n            configEditor.init();\n            $(\u0022.tab-pane[name=config]\u0022, container).data(\u0022configEditor\u0022, configEditor);\n            $(\u0022[name=appSave]\u0022, container).click(() =\u003E AppManagement.save(app, configEditor));\n            $(\u0022[name=appMigrate]\u0022, container).click(() =\u003E AppManagement.migrate(app, container));\n        }\n    },\n\n    migrate: async function (app, container) {\n        // var d = new Dialog({ title: \u0022[resource_displayname[migrate]]\u0022, width: 620, height: \u0022auto\u0022 });\n        // d.template = $(\u0022[name=appMigratorComponent]\u0022).first().html();\n        var element = $(\u0022[name=AppMigrator]\u0022, container);\n        await AppMigrator.init(app, element, app);\n    },\n\n    save: async function (app, configEditor) {\n        var newApp = {\n            ConfigJson: configEditor.getValue(),\n            Cultures: app.Cultures,\n            DefaultCultureId: app.DefaultCultureId,\n            DefaultTheme: app.DefaultTheme,\n            Domain: app.Domain,\n            Id: app.Id,\n            Name: app.Name,\n            TenantId: app.TenantId\n        };\n        try {\n            JSON.parse(newApp.ConfigJson);\n        } catch(err) {\n            error(\u0022[resource_displayname[AppConfigParsingError]]\u0022);\n            return;\n        }\n        notification.info(\u0022[resource_displayname[saving]]\u0022);\n        await api.update(\u0022ContentManagement/App(\u0022 \u002B app.Id \u002B \u0022)\u0022, newApp).then(() =\u003E {\n            notification.success(\u0022[resource_displayname[saved]]\u0022)\n        }).catch((err) =\u003E error(err));\n    }\n};",
  "Name": "AppManagement",
  "Description": null,
  "Key": "Content Management"
}