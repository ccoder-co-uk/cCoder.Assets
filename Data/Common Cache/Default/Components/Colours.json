  "Key": "Default",
  "Name": "Colours",
  "ResourceKey": "Default",
  "Content": "<h4>[resource_displayname[baseColours]]</h4>\r\n<ul class=\"fieldList\">\r\n\t<li>\r\n\t\t<label>[resource_displayname[primary]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input  name=\"picker\"  data-bind=\"value: colours.primary\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[secondary]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.secondary\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[background]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.background\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[text]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.text\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[text2]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.text2\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[links]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.links\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n        <label>[resource_displayname[margins]]</label>\r\n        <div class=\"value\">\r\n            <input type=\"text\" name=\"marginSlider\" />\r\n        </div>\r\n    </li>\r\n</ul>\r\n<h4>[resource_displayname[chartColours]]</h4>\r\n<ul class=\"fieldList\">\r\n\t<li>\r\n\t\t<label>[resource_displayname[colourone]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[0]\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[colourtwo]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[1]\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[colourthree]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[2]\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[colourfour]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[3]\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[colourfive]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[4]\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[coloursix]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: colours.charts[5]\" />\r\n\t\t</div>\r\n\t</li>\r\n</ul>\r\n",
  "Script": "Colours = {\r\n    init: async function(app, container, observable) {\r\n        app = app || session.app;\r\n        container = container || $(\".component[name=Colours]\");\r\n        if(!observable) { return; }\r\n        $(\"[name=picker]\", container).kendoColorPicker({buttons: false, change: (e) => e.preventDefault()});\r\n        $(\"[name=marginSlider]\", container).kendoSlider({ \r\n            min: 0, \r\n            max: 20, \r\n            smallStep: 1, \r\n            largeStep: 2, \r\n            value: parseFloat((observable.get(\"colours.margins\") || \"4px\").replaceAll(\"px\", \"\")),\r\n            change: function(e) {\r\n                e.preventDefault();\r\n                observable.set(\"colours.margins\", this.value() + \"px\");\r\n            }\r\n        });\r\n    }\r\n}",
  "CreatedOn": "2021-11-19T21:25:08.872Z",
  "LastUpdated": "2021-11-19T21:25:08.872Z",
  "IncludeInSubSequentImports": true
}