  "Content": "<h4>[resource_displayname[notifications]]</h4>\r\n<ul class=\"fieldList\">\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsErrorText]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.error.text\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label  >[resource_displayname[notificationsErrorBackground]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.error.background\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsWarningText]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\"  data-bind=\"value: notifications.warning.text\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsWarningBackground]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.warning.background\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsInfoText]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.info.text\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsInfoBackground]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.info.background\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsSuccessText]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.success.text\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[notificationsSuccessBackground]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"picker\" data-bind=\"value: notifications.success.background\" />\r\n\t\t</div>\r\n\t</li>\r\n</ul>\r\n",
  "Script": "Notifications = {\r\n    init: async function(app, container) {\r\n        app = app || session.app;\r\n        container = container || $(\".component[name=Notifications]\");\r\n        $(\"[name=picker]\", container).kendoColorPicker({buttons: false, change: (e) => e.preventDefault()});\r\n    }\r\n}",
