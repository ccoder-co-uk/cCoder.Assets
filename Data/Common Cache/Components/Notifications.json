  "Content": "\u003Ch4\u003E[resource_displayname[notifications]]\u003C/h4\u003E\r\n\u003Cul class=\u0022fieldList\u0022\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[notificationsErrorText]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022 data-bind=\u0022value: notifications.error.text\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel  \u003E[resource_displayname[notificationsErrorBackground]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022 data-bind=\u0022value: notifications.error.background\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[notificationsWarningText]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022  data-bind=\u0022value: notifications.warning.text\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[notificationsWarningBackground]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022 data-bind=\u0022value: notifications.warning.background\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[notificationsInfoText]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022 data-bind=\u0022value: notifications.info.text\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[notificationsInfoBackground]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n\t\t\t\u003Cinput name=\u0022picker\u0022 data-bind=\u0022value: notifications.info.background\u0022 /\u003E\r\n\t\t\u003C/div\u003E\r\n