  "Content": "\u003Cdiv name=\u0022tabs\u0022\u003E\r\n\t\u003Cul\u003E\r\n\t\t\u003Cli name=\u0022loginPage\u0022 class = \u0022k-state-active\u0022\u003E[resource_displayname[loginPage]]\u003C/li\u003E\r\n\t\t\u003Cli name=\u0022homePage\u0022\u003E[resource_displayname[homePage]]\u003C/li\u003E\r\n        \u003Cli name=\u0022invoicesPage\u0022\u003E[resource_displayname[invoicesPage]]\u003C/li\u003E\r\n\t\t\u003Cli name=\u0022analysisPage\u0022\u003E[resource_displayname[analysisPage]]\u003C/li\u003E\r\n        \u003Cli name=\u0022paymentsPage\u0022\u003E[resource_displayname[paymentPage]]\u003C/li\u003E\r\n        \u003Cli name=\u0022myRegistrations\u0022\u003E[resource_displayname[myRegistrations]]\u003C/li\u003E\r\n        \u003Cli name=\u0022summary\u0022\u003E[resource_displayname[summary]]\u003C/li\u003E\r\n        \u003Cli name=\u0022userPreferences\u0022\u003E[resource_displayname[userPreferences]]\u003C/li\u003E\r\n        \u003Cli name=\u0022howToSetup\u0022\u003E[resource_displayname[howToSetup]]\u003C/li\u003E\r\n\t\u003C/ul\u003E\r\n\t\u003Cdiv class=\u0022tab\u0022 name=\u0022loginPage\u0022\u003E\r\n        [component[LoginPage]]\r\n    \u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022homePage\u0022\u003E\r\n        [component[HomePage]]\r\n    \u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022invoicesPage\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022analysisPage\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022paymentPage\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022myRegistrations\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022summary\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022userPreferences\u0022\u003E\u003C/div\u003E\r\n    \u003Cdiv class=\u0022tab\u0022 name=\u0022howToSetup\u0022\u003E\u003C/div\u003E\r\n\u003C/div\u003E\r\n\r\n\u003Cstyle scoped\u