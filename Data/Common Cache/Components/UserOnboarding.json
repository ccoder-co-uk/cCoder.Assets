1].country\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n \u003C/ul\u003E\n \u003C/div\u003E\n \u003Cdiv  class=\u0022container\u0022\u003E\n  \u003Ch4\u003E[resource_displayname[accessRequested]]\u003C/h4\u003E\n \u003Cul class=\u0022fieldList\u0022\u003E\n   \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[name]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\n     \t\t\t\u003Cselect name=\u0022requestType\u0022 data-bind=\u0022value: [2].requestType\u0022\u003E\n                   \u003Coption value=\u0027buyer\u0027\u003E[resource_displayname[buyer]]\u003C/.option\u003E\n\t\t\t\t   \u003Coption value=\u0027supplierreadonly\u0027\u003E[resource_displayname[supplierreadonly]]\u003C/option\u003E\n\t\t\t\t   \u003Coption value=\u0027supplieralacarte\u0027\u003E[resource_displayname[supplieralacarte]]\u003C/option\u003E\n\t\t\t\t   \u003Coption value=\u0027funder\u0027\u003E[resource_displayname[funder]]\u003C/option\u003E\n              \u003C/select\u003E\n         \u003C/div\u003E\n\t\u003C/li\u003E\n\t\u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[reference]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022reference\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].reference\u0022/\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n         \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactName]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022contactName\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].contactName\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactEmail]]\u003C/label\u003E\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022contactEmail\u0022 type=\u0022text\u0022 data-bind=\u0022value: [2].contactEmail\u0022 /\u003E\u003C/div\u003E\n\t\u003C/li\u003E\n     \u003Cli\u003E\n\t\t\u003Clabel\u003E[resource_displayname[contactPhone]]\