  "Content": "\u003Ch3\u003E[resource_displayname[RegistrationOfInterest]]\u003C/h3\u003E\r\n\u003Cdiv name=\u0022roiGrid\u0022 role=\u0022ROIGrid\u0022\u003E\u003C/div\u003E\r\n\r\n\u003Cscript name=\u0022createRequest\u0022 type=\u0022template/text\u0022\u003E\r\n\u003Cdiv class=\u0022partsList\u0022\u003E\r\n\t\u003Cul\u003E\r\n\t\t\u003Cli class=\u0022selected\u0022 data-container=\u0022contactInfo\u0022\u003E[resource_displayname[contactInfo]]\u003C/li\u003E\r\n\t\t\u003Cli data-container=\u0022fundingNeeded\u0022\u003E[resource_displayname[fundingNeed]]\u003C/li\u003E\r\n\t\t\u003Cli data-container=\u0022auth\u0022\u003E[resource_displayname[Authorisation]]\u003C/li\u003E\r\n\t\t\u003Cli data-container=\u0022supportingDocs\u0022\u003E[resource_displayname[supportingdocs]]\u003C/li\u003E\r\n\t\t\u003Cli data-container=\u0022disclaimer\u0022\u003E[resource_displayname[disclaimer]]\u003C/li\u003E\r\n\t\u003C/ul\u003E\r\n\u003C/div\u003E\r\n\u003Cdiv name=\u0022contactInfo\u0022 class=\u0022container\u0022\u003E\r\n\u003Cul class=\u0022fieldList\u0022\u003E\r\n   \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[firstname]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022firstname\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].firstname\u0022 /\u003E\u003C/div \u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[surname]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022surname\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].surname\u0022 /\u003E\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n     \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[email]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022email\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].email\u0022 /\u003E\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n     \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[phone]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022phone\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].phone\u0022/\u003E\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n     \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[jobtitle]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022jobtitle\u0022 type=\u0022text\u0022 data-bind=\u0022value: [0].jobtitle\u0022 /\u003E\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n \u003C/ul\u003E\r\n\u003C/div\u003E\r\n \u003Cdiv name=\u0022fundingNeeded\u0022 class=\u0022container\u0022 style=\u0022display: none;\u0022\u003E\r\n \u003Cul class=\u0022fieldList\u0022\u003E\r\n    \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[company]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n              \u003Cselect name=\u0022company\u0022 data-bind=\u0022value: [1].company\u0022\u003E\r\n                   \u003Coption\u003E[resource_displayname[pleaseSelect]]\r\n              \u003C/select\u003E\r\n         \u003C/div\u003E\r\n\t\u003C/li\u003E\r\n   \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[fundingType]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\r\n              \u003Cselect name=\u0022requestType\u0022 data-bind=\u0022value: [1].requestType\u0022\u003E\r\n                   \u003Coption\u003ESystematic\u003C/option\u003E\r\n\t\t\t\t   \u003Coption\u003EA La carte\u003C/option\u003E\r\n              \u003C/select\u003E\r\n         \u003C/div\u003E\r\n\t\u003C/li\u003E\r\n\t\u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[reference]]\u003C/label\u003E\r\n\t\t\u003Cdiv class=\u0022value\u0022\u003E\u003Cinput name=\u0022reference\u0022 type=\u0022text\u0022 data-bind=\u0022value: [1].reference\u0022/\u003E\u003C/div\u003E\r\n\t\u003C/li\u003E\r\n         \u003Cli\u003E\r\n\t\t\u003Clabel\u003E[resource_displayname[contactname]]\u003C/label\u003E\r\n\t\t\u003Cd