u003E[resource_displayname[Save]]\u003C/button\u003E\u003C/div\u003E\r\n\u003C/script\u003E\r\n\u003Cstyle\u003E\r\n\t[name=newFundingRequestDialog] \u003E.container { min-width: 650px; }\r\n\t[name=newFundingRequestDialog] .partsList {border-right: solid 1px #ccc; }\r\n\t[name=newFundingRequestDialog] \u003E .value \u003E button { float: right; margin: 8px 10px; }\r\n\t.k-grid-content { overflow-x: hidden; }\r\n\u003C/style\u003E",
  "Script": "RegistrationOfInterest = {\r\n\tstates: {\r\n\t\t\u0022New\u0022: \u0022[resource_displayname[New]]\u0022,\r\n\t\t\u0022Rejected\u0022: \u0022[resource_displayname[rejected]]\u0022,\r\n\t\t\u0022AdminRejected\u0022: \u0022[resource_displayname[adminRejected]]\u0022,\r\n\t\t\u0022Accepted\u0022: \u0022[resource_displayname[accepted]]\u0022\r\n\t},\r\n\r\n\tinit: async function (app, container) {\r\n\t\tvar meta = [\r\n\t\t\t{\n        \u0022Name\u0022: \u0022Core\u0022,\n        \u0022Types\u0022: [\n            [meta[Core/Submission]]\n        ]\n    }\r\n\t\t];\r\n\t\tvar config = { endpoint: \u0022ContentManagement/Submission\u0022, odataAppend: \u0022?$filter=SourceComponent eq \u0027RegistrationOfInterest\u0027  and CreatedBy eq \u0027\u0022 \u002B session.user \u002B \u0022\u0027 and AppId eq \u0022 \u002B app.Id };\r\n\t\tvar ds = await model.getDatasource(config);\r\n\t\tvar roiGrid = await [script[RoiGrid]]({element: $(\u0022[name=roiGrid]\u0022, container), data: ds});\r\n\t\tawait roiGrid.init();\r\n\t\t$(\u0022[name=addROI]\u0022).on(\u0022click\u0022, function (e) { e.preventDefault(); RegistrationOfInterest.createROI(container, roiGrid, app); });\r\n\t},\r\n\r\n\tcreateROI: async function (container, widget, app) {\r\n\t\tvar d = new Dialog({ title: \u0022[resource_displayname[newAccessRequest]]\u0022, width: 1000 });\r\n\t\tvar user = await api.get(\u0022AppSecurity/User/Me()\u0022);\r\n\t\tvar model = kendo.observable({\r\n\t\t\t0: {firstname: user.DisplayName. split(\u0027 \u0027)[0], lastname:user.DisplayName.split(\u0027 \u0027)[user.DisplayName.split(\u0027 \u0027).length - 1], email: user.Email, phone: null, jobtitle: null},\r\n\t\t\t1: {company: null, requestType: null, reference: null, contactName: null, contactEmail: null, contactPhone: null},\r\n\t\t\t2: {signatoryName: null, signatoryPosition: null, signarotyPhone: null, bankName: null, accountNo: null, sortCode: null},\r\n\t\t\t3: {signature: null, ident1: null, ident2: null, accounts: null, shareholderDetails: null, associationDetails: null, contract: null}\r\n\t\t});\r\n\t\td.template = \u0022\u003Cdiv name=\u0027newFundingRequestDialog\u0027\u003E\u0022 \u002B $(\u0022script[name=createRequest]\u0022, container).html() \u002B \u0022\u003C/div\u003E\u0022;\r\n\t\td.events.save = async function (e) {\r\n\t\t\tvar items = JSON.parse(JSON.stringify(model));\r\n\t\t\tvar submission = { SourceComponent: \u0022RegistrationOfInterest\u0022, State: \u0022New\u0022, DataJson: JSON.stringify({ \u0022fields\u0022: items }), AppId: app.Id };\r\n\t\t\tawait api.add(\u0022ContentManagement/Submission\u0022, submission);\r\n\t\t\tnotification.success(\u0022[resource_displayname[SubmissionSubmitted]]\u0022);\r\n\t\t\twidget.kendoObject.dataSource.read();\r\n\t\t\twidget.kendoObject.refresh();\r\n\t\t\td.events.close();\r\n\t\t};\r\n\t\td.init(async () =\u003E {\r\n\t\t\tvar dialog = d.element;\r\n\t\t\tawait api.get(\u0022B2B/Country\u0022).then((countries) =\u003E {\r\n\t\t\t\t$(\u0022input[name=country]\u0022, dialog).kendoDropDownList({\r\n\t\t\t\t\tdataSource: countries.value,\r\n\t\t\t\t\tdataValueField: \u0022Id\u0022,\r\n\t\t\t\t\tdataTextField: \u0022Name\u0022\r\n\t\t\t\t});\r\n\t\t\t});\r\n\t\t\t$(\u0022select\u0022, dialog).kendoDropDownList();\r\n\t\t\tkendo.bind(dialog, model);\r\n\t\t\t$(\u0022.partsList \u003E ul \u003E li\u0022, dialog).on(\u0022click\u0022, function(e) {\r\n\t\t\t\t$(\u0022.partsList \u003E ul \u003E li\u0022, dialog).removeClass(\u0022selected\u0022);\r\n\t\t\t\t$(\u0022.container\u0022, dialog).css(\u0022display\u0022, \u0022none\u0022);\r\n\t\t\t\t$(\u0022.container[name=\u0022 \u002B $(e.target).attr(\u0022data-container\u0022) \u002B \u0022]\u0022).css(\u0022display\u0022, \u0022inline-block\u0022);\r\n\t\t\t\t$(e.target).addClass(\u0022selected\u0022);\r\n\t\t\t});\r\n\t\t});\r\n\t}\r\n};",
