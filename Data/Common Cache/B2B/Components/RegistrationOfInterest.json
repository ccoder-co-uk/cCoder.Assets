{
  "AppId": 11,
  "ResourceKey": "B2B",
  "Content": "<h3>[resource_displayname[RegistrationOfInterest]]</h3>\r\n<div name=\"roiGrid\" role=\"ROIGrid\"></div>\r\n\r\n<script name=\"createRequest\" type=\"template/text\">\r\n<div class=\"partsList\">\r\n\t<ul>\r\n\t\t<li class=\"selected\" data-container=\"contactInfo\">[resource_displayname[contactInfo]]</li>\r\n\t\t<li data-container=\"fundingNeeded\">[resource_displayname[fundingNeed]]</li>\r\n\t\t<li data-container=\"auth\">[resource_displayname[Authorisation]]</li>\r\n\t\t<li data-container=\"supportingDocs\">[resource_displayname[supportingdocs]]</li>\r\n\t\t<li data-container=\"disclaimer\">[resource_displayname[disclaimer]]</li>\r\n\t</ul>\r\n</div>\r\n<div name=\"contactInfo\" class=\"container\">\r\n<ul class=\"fieldList\">\r\n   <li>\r\n\t\t<label>[resource_displayname[firstname]]</label>\r\n\t\t<div class=\"value\"><input name=\"firstname\" type=\"text\" data-bind=\"value: [0].firstname\" /></div >\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[surname]]</label>\r\n\t\t<div class=\"value\"><input name=\"surname\" type=\"text\" data-bind=\"value: [0].surname\" /></div>\r\n\t</li>\r\n     <li>\r\n\t\t<label>[resource_displayname[email]]</label>\r\n\t\t<div class=\"value\"><input name=\"email\" type=\"text\" data-bind=\"value: [0].email\" /></div>\r\n\t</li>\r\n     <li>\r\n\t\t<label>[resource_displayname[phone]]</label>\r\n\t\t<div class=\"value\"><input name=\"phone\" type=\"text\" data-bind=\"value: [0].phone\"/></div>\r\n\t</li>\r\n     <li>\r\n\t\t<label>[resource_displayname[jobtitle]]</label>\r\n\t\t<div class=\"value\"><input name=\"jobtitle\" type=\"text\" data-bind=\"value: [0].jobtitle\" /></div>\r\n\t</li>\r\n </ul>\r\n</div>\r\n <div name=\"fundingNeeded\" class=\"container\" style=\"display: none;\">\r\n <ul class=\"fieldList\">\r\n    <li>\r\n\t\t<label>[resource_displayname[company]]</label>\r\n\t\t<div class=\"value\">\r\n              <select name=\"company\" data-bind=\"value: [1].company\">\r\n                   <option>[resource_displayname[pleaseSelect]]\r\n              </select>\r\n         </div>\r\n\t</li>\r\n   <li>\r\n\t\t<label>[resource_displayname[fundingType]]</label>\r\n\t\t<div class=\"value\">\r\n              <select name=\"requestType\" data-bind=\"value: [1].requestType\">\r\n                   <option>Systematic</option>\r\n\t\t\t\t   <option>A La carte</option>\r\n              </select>\r\n         </div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[reference]]</label>\r\n\t\t<div class=\"value\"><input name=\"reference\" type=\"text\" data-bind=\"value: [1].reference\"/></div>\r\n\t</li>\r\n         <li>\r\n\t\t<label>[resource_displayname[contactname]]</label>\r\n\t\t<div class=\"value\"><input name=\"contactName\" type=\"text\" data-bind=\"value: [1].contactName\" /></div>\r\n\t</li>\r\n     <li>\r\n\t\t<label>[resource_displayname[contactEmail]]</label>\r\n\t\t<div class=\"value\"><input name=\"contactEmail\" type=\"text\" data-bind=\"value: [1].contactEmail\"/></div>\r\n\t</li>\r\n     <li>\r\n\t\t<label>[resource_displayname[contactPhone]]</label>\r\n\t\t<div class=\"value\"><input name=\"contactPhone\" type=\"text\" data-bind=\"value: [1].contactPhone\" /></div>\r\n\t</li>\r\n </ul>\r\n </div>\r\n <div name=\"auth\" class=\"container\" style=\"display: none;\">\r\n <ul class=\"fieldList\">\r\n    <li>\r\n\t\t<label style=\"font-weight: bold;\">[resource_displayname[signatory]]</label>\r\n\t\t<div class=\"value\"></div>\r\n\t</li>\r\n    <li>\r\n\t\t<label>[resource_displayname[SignatoryName]]</label>\r\n\t\t<div class=\"value\"><input name=\"signatoryName\" type=\"text\" data-bind=\"value: [2].signatoryName\" /></div>\r\n\t</li>\r\n   <li>\r\n\t\t<label>[resource_displayname[signatoryPosition]]</label>\r\n\t\t<div class=\"value\"><input name=\"signatoryPosition\" type=\"text\" data-bind=\"value: [2].signatoryPosition\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[signatoryPhone]]</label>\r\n\t\t<div class=\"value\"><input name=\"signatoryPhone\" type=\"text\" data-bind=\"value: [2].signatoryPhone\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label style=\"font-weight: bold;\">[resource_displayname[bank]]</label>\r\n\t\t<div class=\"value\"></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[bankName]]</label>\r\n\t\t<div class=\"value\"><input name=\"bankName\" type=\"text\" data-bind=\"value: [2].bankName\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[accountNo]]</label>\r\n\t\t<div class=\"value\"><input name=\"accountNo\" type=\"text\" data-bind=\"value: [2].accountNo\" /></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[sortCode]]</label>\r\n\t\t<div class=\"value\"><input name=\"sortCode\" type=\"text\" data-bind=\"value: [2].sortCode\"/></div>\r\n\t</li>\r\n </ul>\r\n </div>\r\n <div name=\"supportingDocs\" class=\"container\" style=\"display: none;\">\r\n <ul class=\"fieldList\">\r\n    <li>\r\n\t\t<label>[resource_displayname[signature]]</label>\r\n\t\t<div class=\"value\"><input name=\"signature\" type=\"file\" data-bind=\"value: [3].signature\"/></div>\r\n\t</li>\r\n   <li>\r\n\t\t<label>[resource_displayname[proofOfIdentity]]</label>\r\n\t\t<div class=\"value\"><input name=\"ident1\" type=\"file\" data-bind=\"value: [3].ident1\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[proofOfIdentity2]]</label>\r\n\t\t<div class=\"value\"><input name=\"ident2\" type=\"file\" data-bind=\"value: [3].ident2\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[accounts]]</label>\r\n\t\t<div class=\"value\"><input name=\"accounts\" type=\"file\" data-bind=\"value: [3].accounts\"/></div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[shareholders]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"shareholderDetails\" type=\"file\"data-bind=\"value: [3].shareholderDetails\" />\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[association]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"associationDetails\" type=\"file\" data-bind=\"value: [3].associationDetails\"/>\r\n\t\t</div>\r\n\t</li>\r\n\t<li>\r\n\t\t<label>[resource_displayname[contract]]</label>\r\n\t\t<div class=\"value\">\r\n\t\t\t<input name=\"contract\" type=\"file\" data-bind=\"value: [3].contract\"/>\r\n\t\t</div>\r\n\t</li>\r\n\t </ul>\r\n </div>\r\n<div name=\"disclaimer\" class=\"container\" style=\"display:none;\">\r\n\t<ul class=\"fieldList\">\r\n\t\t[dms[content/registrationOfInterestDisclaimer-[[lang]].html]]\r\n\t</ul>\r\n</div>\r\n <hr />\r\n <div class=\"value\"><button name=\"save\"><span class=\"k-icon k-i-save\"></span>[resource_displayname[Save]]</button></div>\r\n</script>\r\n<style>\r\n\t[name=newFundingRequestDialog] >.container { min-width: 650px; }\r\n\t[name=newFundingRequestDialog] .partsList {border-right: solid 1px #ccc; }\r\n\t[name=newFundingRequestDialog] > .value > button { float: right; margin: 8px 10px; }\r\n\t.k-grid-content { overflow-x: hidden; }\r\n</style>",
  "Script": "RegistrationOfInterest = {\r\n\tstates: {\r\n\t\t\"New\": \"[resource_displayname[New]]\",\r\n\t\t\"Rejected\": \"[resource_displayname[rejected]]\",\r\n\t\t\"AdminRejected\": \"[resource_displayname[adminRejected]]\",\r\n\t\t\"Accepted\": \"[resource_displayname[accepted]]\"\r\n\t},\r\n\r\n\tinit: async function (app, container) {\r\n\t\tvar meta = [\r\n\t\t\t{\n        \"Name\": \"Core\",\n        \"Types\": [\n            [meta[Core/Submission]]\n        ]\n    }\r\n\t\t];\r\n\t\tvar config = { endpoint: \"ContentManagement/Submission\", odataAppend: \"?$filter=SourceComponent eq 'RegistrationOfInterest'  and CreatedBy eq '\" + session.user + \"' and AppId eq \" + app.Id };\r\n\t\tvar ds = await model.getDatasource(config);\r\n\t\tvar roiGrid = await [script[RoiGrid]]({element: $(\"[name=roiGrid]\", container), data: ds});\r\n\t\tawait roiGrid.init();\r\n\t\t$(\"[name=addROI]\").on(\"click\", function (e) { e.preventDefault(); RegistrationOfInterest.createROI(container, roiGrid, app); });\r\n\t},\r\n\r\n\tcreateROI: async function (container, widget, app) {\r\n\t\tvar d = new Dialog({ title: \"[resource_displayname[newAccessRequest]]\", width: 1000 });\r\n\t\tvar user = await api.get(\"AppSecurity/User/Me()\");\r\n\t\tvar model = kendo.observable({\r\n\t\t\t0: {firstname: user.DisplayName. split(' ')[0], lastname:user.DisplayName.split(' ')[user.DisplayName.split(' ').length - 1], email: user.Email, phone: null, jobtitle: null},\r\n\t\t\t1: {company: null, requestType: null, reference: null, contactName: null, contactEmail: null, contactPhone: null},\r\n\t\t\t2: {signatoryName: null, signatoryPosition: null, signarotyPhone: null, bankName: null, accountNo: null, sortCode: null},\r\n\t\t\t3: {signature: null, ident1: null, ident2: null, accounts: null, shareholderDetails: null, associationDetails: null, contract: null}\r\n\t\t});\r\n\t\td.template = \"<div name='newFundingRequestDialog'>\" + $(\"script[name=createRequest]\", container).html() + \"</div>\";\r\n\t\td.events.save = async function (e) {\r\n\t\t\tvar items = JSON.parse(JSON.stringify(model));\r\n\t\t\tvar submission = { SourceComponent: \"RegistrationOfInterest\", State: \"New\", DataJson: JSON.stringify({ \"fields\": items }), AppId: app.Id };\r\n\t\t\tawait api.add(\"ContentManagement/Submission\", submission);\r\n\t\t\tnotification.success(\"[resource_displayname[SubmissionSubmitted]]\");\r\n\t\t\twidget.kendoObject.dataSource.read();\r\n\t\t\twidget.kendoObject.refresh();\r\n\t\t\td.events.close();\r\n\t\t};\r\n\t\td.init(async () => {\r\n\t\t\tvar dialog = d.element;\r\n\t\t\tawait api.get(\"B2B/Country\").then((countries) => {\r\n\t\t\t\t$(\"input[name=country]\", dialog).kendoDropDownList({\r\n\t\t\t\t\tdataSource: countries.value,\r\n\t\t\t\t\tdataValueField: \"Id\",\r\n\t\t\t\t\tdataTextField: \"Name\"\r\n\t\t\t\t});\r\n\t\t\t});\r\n\t\t\t$(\"select\", dialog).kendoDropDownList();\r\n\t\t\tkendo.bind(dialog, model);\r\n\t\t\t$(\".partsList > ul > li\", dialog).on(\"click\", function(e) {\r\n\t\t\t\t$(\".partsList > ul > li\", dialog).removeClass(\"selected\");\r\n\t\t\t\t$(\".container\", dialog).css(\"display\", \"none\");\r\n\t\t\t\t$(\".container[name=\" + $(e.target).attr(\"data-container\") + \"]\").css(\"display\", \"inline-block\");\r\n\t\t\t\t$(e.target).addClass(\"selected\");\r\n\t\t\t});\r\n\t\t});\r\n\t}\r\n};",
  "Name": "RegistrationOfInterest",
  "Description": null,
  "Key": "B2B",
  "IncludeInSubSequentImports": true
}