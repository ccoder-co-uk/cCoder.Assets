  "Content": "<h3>[resource_displayname[useronboarding]]</h3>\n<script name=\"createRequest\" type=\"template/text\">\n\t<div class=\"partsList\">\n\t<ul>\n\t\t<li class=\"selected\" data-container=\"contactInfo\">[resource_displayname[contactInfo]]</li>\n\t\t<li data-container=\"companyInfo\">[resource_displayname[companyInfo]]</li>\n\t\t<li data-container=\"accessRequested\">[resource_displayname[accessRequested]]</li>\n\t\t<li data-container=\"disclaimer\">[resource_displayname[disclaimer]]</li>\n\t</ul>\n</div>\n<div name=\"contactInfo\" class=\"container\" >\n<ul class=\"fieldList\">\n\t<li>\n\t\t<label>[resource_displayname[username]]</label>\n\t\t<div class=\"value\">\n\t\t\t<input name=\"username\" type=\"text\" data-bind=\"value: [0].username\" />\n\t\t</div>\n\t</li>\n   <li>\n\t\t<label>[resource_displayname[firstname]]</label>\n\t\t<div class=\"value\"><input name=\"firstname\" type=\"text\" data-bind=\"value: [0].firstname\" /></div>\n\t</li>\n\t<li>\n\t\t<label>[resource_displayname[surname]]</label>\n\t\t<div class=\"value\"><input name=\"surname\" type=\"text\" data-bind=\"value: [0].surname\" /></div>\n\t</li>\n\n     <li>\n\t\t<label>[resource_displayname[email]]</label>\n\t\t<div class=\"value\"><input name=\"email\" type=\"text\" data-bind=\"value: [0].email\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[phone]]</label>\n\t\t<div class=\"value\"><input name=\"phone\" type=\"text\" data-bind=\"value: [0].phone\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[jobtitle]]</label>\n\t\t<div class=\"value\"><input name=\"jobtitle\" type=\"text\" data-bind=\"value: [0].jobtitle\" /></div>\n\t</li>\n </ul>\n</div>\n<div class=\"container\" name=\"companyInfo\" style= \"display:none;\">\n <ul class=\"fieldList\">\n     <li>\n\t\t<label>[resource_displayname[vatNo]]</label>\n\t\t<div class=\"value\"><input name=\"vatNo\" type=\"text\" data-bind=\"value: [1].vatNo\" /></div>\n\t</li>\n   <li>\n\t\t<label>[resource_displayname[companyName]]</label>\n\t\t<div class=\"value\"><input name=\"companyName\" type=\"text\" data-bind=\"value: [1].companyName\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[addressLine1]]</label>\n\t\t<div class=\"value\"><input name=\"addressLine1\" type=\"text\" data-bind=\"value: [1].addressLine1\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[addressLine2]]</label>\n\t\t<div class=\"value\"><input name=\"addressLine2\" type=\"text\" data-bind=\"value: [1].addressLine2\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[city]]</label>\n\t\t<div class=\"value\"><input name=\"city\" type=\"text\" data-bind=\"value: [1].city\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[stateProvince]]</label>\n\t\t<div class=\"value\"><input name=\"stateProvince\" type=\"text\" data-bind=\"value: [1].stateProvince\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[ziporpostalcode]]</label>\n\t\t<div class=\"value\"><input name=\"ziporpostalcode\" type=\"text\" data-bind=\"value: [1].zipOrPostalCode\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[country]]</label>\n\t\t<div class=\"value\"><input name=\"country\" type=\"text\" data-bind=\"value: [1].country\" /></div>\n\t</li>\n </ul>\n </div>\n <div class=\"container\" name=\"accessRequested\" style= \"display:none;\">\n <ul class=\"fieldList\">\n   <li>\n\t\t<label>[resource_displayname[name]]</label>\n\t\t<div class=\"value\">\n     \t\t\t<select name=\"requestType\" data-bind=\"value: [2].requestType\">\n\t\t\t\t   <option value=\"supplierreadonly\">[resource_displayname[supplierreadonly]]</option>\n\t\t\t\t   <option value=\"supplieralacarte\">[resource_displayname[supplieralacarte]]</option>\n              </select>\n         </div>\n\t</li>\n\t<li>\n\t\t<label>[resource_displayname[reference]]</label>\n\t\t<div class=\"value\"><input name=\"reference\" type=\"text\" data-bind=\"value: [2].reference\"/></div>\n\t</li>\n         <li>\n\t\t<label>[resource_displayname[contactName]]</label>\n\t\t<div class=\"value\"><input name=\"contactName\" type=\"text\" data-bind=\"value: [2].contactName\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[contactEmail]]</label>\n\t\t<div class=\"value\"><input name=\"contactEmail\" type=\"text\" data-bind=\"value: [2].contactEmail\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[contactPhone]]</label>\n\t\t<div class=\"value\"><input name=\"contactPhone\" type=\"text\" data-bind=\"value: [2].contactPhone\"/></div>\n\t</li>\n </ul>\n </div>\n <div name=\"disclaimer\" class=\"container\" style=\"display:none;\">\n\t<ul class=\"fieldList\">\n\t\t[dms[content/userOnboardingDisclaimer-[[lang]].html]]\n\t</ul>\n</div>\n <hr/>\n <div class=\"value\" style=\"float: right;\" ><button name=\"submit\" style=\"margin:-10px padding:5px;;\"><span class=\"k-icon k-i-save\"></span>[resource_displayname[submit]]</button></div>\n</script>\n<script name=\"viewRequest\" type=\"template/text\">\n\t<form name=\"createRequestForm\">\n\t\t<div class=\"container\">\n <h4>[resource_displayname[contactInfo]]</h4>\n<ul class=\"fieldList\">\n\t<li>\n\t\t<label>[resource_displayname[username]]</label>\n\t\t<div class=\"value\">\n\t\t\t<input name=\"username\" type=\"text\" data-bind=\"value: [0].username\" />\n\t\t</div>\n\t</li>\n   <li>\n\t\t<label>[resource_displayname[firstname]]</label>\n\t\t<div class=\"value\"><input name=\"firstname\" type=\"text\" data-bind=\"value: [0].firstname\" /></div>\n\t</li>\n\t<li>\n\t\t<label>[resource_displayname[surname]]</label>\n\t\t<div class=\"value\"><input name=\"surname\" type=\"text\" data-bind=\"value: [0].surname\" /></div>\n\t</li>\n\n     <li>\n\t\t<label>[resource_displayname[email]]</label>\n\t\t<div class=\"value\"><input name=\"email\" type=\"text\" data-bind=\"value: [0].email\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[phone]]</label>\n\t\t<div class=\"value\"><input name=\"phone\" type=\"text\" data-bind=\"value: [0].phone\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[jobtitle]]</label>\n\t\t<div class=\"value\"><input name=\"jobtitle\" type=\"text\" data-bind=\"value: [0].jobtitle\" /></div>\n\t</li>\n </ul>\n</div>\n<div class=\"container\">\n <h4>[resource_displayname[companyInfo]]</h4>\n <ul class=\"fieldList\">\n     <li>\n\t\t<label>[resource_displayname[vatNo]]</label>\n\t\t<div class=\"value\"><input name=\"vatNo\" type=\"text\" data-bind=\"value: [1].vatNo\" /></div>\n\t</li>\n   <li>\n\t\t<label>[resource_displayname[companyName]]</label>\n\t\t<div class=\"value\"><input name=\"companyName\" type=\"text\" data-bind=\"value: [1].companyName\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[addressLine1]]</label>\n\t\t<div class=\"value\"><input name=\"addressLine1\" type=\"text\" data-bind=\"value: [1].addressLine1\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[addressline2]]</label>\n\t\t<div class=\"value\"><input name=\"addressLine2\" type=\"text\" data-bind=\"value: [1].addressLine2\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[city]]</label>\n\t\t<div class=\"value\"><input name=\"city\" type=\"text\" data-bind=\"value: [1].city\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[stateprovince]]</label>\n\t\t<div class=\"value\"><input name=\"stateProvince\" type=\"text\" data-bind=\"value: [1].stateProvince\" /></div>\n\t</li>\n    <li>\n\t\t<label>[resource_displayname[ziporpostalcode]]</label>\n\t\t<div class=\"value\"><input name=\"zipOrPostalCode\" type=\"text\" data-bind=\"value: [1].zipOrPostalCode\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[country]]</label>\n\t\t<div class=\"value\"><input name=\"country\" type=\"text\" data-bind=\"value: [1].country\" /></div>\n\t</li>\n </ul>\n </div>\n <div  class=\"container\">\n  <h4>[resource_displayname[accessRequested]]</h4>\n <ul class=\"fieldList\">\n   <li>\n\t\t<label>[resource_displayname[name]]</label>\n\t\t<div class=\"value\">\n     \t\t\t<select name=\"requestType\" data-bind=\"value: [2].requestType\">\n                   <option value='buyer'>[resource_displayname[buyer]]</.option>\n\t\t\t\t   <option value='supplierreadonly'>[resource_displayname[supplierreadonly]]</option>\n\t\t\t\t   <option value='supplieralacarte'>[resource_displayname[supplieralacarte]]</option>\n\t\t\t\t   <option value='funder'>[resource_displayname[funder]]</option>\n              </select>\n         </div>\n\t</li>\n\t<li>\n\t\t<label>[resource_displayname[reference]]</label>\n\t\t<div class=\"value\"><input name=\"reference\" type=\"text\" data-bind=\"value: [2].reference\"/></div>\n\t</li>\n         <li>\n\t\t<label>[resource_displayname[contactName]]</label>\n\t\t<div class=\"value\"><input name=\"contactName\" type=\"text\" data-bind=\"value: [2].contactName\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[contactEmail]]</label>\n\t\t<div class=\"value\"><input name=\"contactEmail\" type=\"text\" data-bind=\"value: [2].contactEmail\" /></div>\n\t</li>\n     <li>\n\t\t<label>[resource_displayname[contactPhone]]</label>\n\t\t<div class=\"value\"><input name=\"contactPhone\" type=\"text\" data-bind=\"value: [2].contactPhone\"/></div>\n\t</li>\n</ul>\n</div>\n <hr  style=\"  width: 100%; \" />\n <div style=\" width: 100%; \" class=\"value\">\n \t<button style=\"margin-right: 5px; float:right;\" name=\"save\" >\n\t \t<span   class=\"k-icon k-i-save\"></span>[resource_displayname[Save]]\n\t</button>\n</div>\n</form>\n</script>\n<div name=\"userOnboardingNewRequestWizardComponent\" style=\"display:none;\">\n\t[component[UserOnboardingNewRequestWizard]]\n</div>\n<style scoped>\n\t[name=newRequestDialog] { overflow: hidden; }\n\t.container { width: 511px; display: inline-block; vertical-align: top; }\n\t.partsList { height: 321px;  width: 320px; display: inline-block; vertical-align: top; border-right: solid 1px #ccc; }\n\t.partsList > ul { padding: 10px; }\n\t.partsList > ul > li { margin: 2px; padding: 10px; cursor: pointer; background: #ccc; width: 70%; }\n\t.partsList > ul > li.selected { font-weight: bold; background: #ddd; width: 96%; }\n\tcontainer { width: 480px; display: inline-block; vertical-align: top; }\n\t.value > button { float: right;  display: inline-block; }\n\t[name=UserOnboardingGrid] { height: calc(100% - 25px); width: 100%; }\n</style>",
  "Script": "UserOnboarding = {\n\tstates: {\n\t\t\"New\": \"[resource_displayname[new]]\",\n\t\t\"Rejected\": \"[resource_displayname[rejected]]\",\n\t\t\"Pending\": \"[resource_displayname[pending]]\",\n\t\t\"AdminRejected\": \"[resource_displayname[adminrejected]]\",\n\t\t\"Accepted\": \"[resource_displayname[accepted]]\"\n\t},\n\n\trequestTypes: {\n\t\t\"supplierreadonly\": \"[resource_displayname[supplierreadonly]]\",\n\t\t\"supplieralacarte\": \"[resource_displayname[supplieralacarte]]\",\n\t},\n\n\ticonStates: {\n\t\t\"New\": \"k-i-file\",\n\t\t\"Accepted\": \"k-i-file-add\",\n\t\t\"Pending\": \"k-i-file-config\",\n\t\t\"Rejected\": \"k-i-file-error\"\n\t},\n\n\tinit: async function (app, container) {\n\t\tapp = app || session.app;\n\t\tcontainer = container || $(\".component[name=UserOnboarding]\");\n        api.addToMetaCache([\n            {\n        \"Name\": \"Core\",\n        \"Types\": [\n            [meta[Core/Submission]]\n        ]\n    }\n        ]);\n\t\tvar dataSource = await model.getDatasource({\n\t\t\tendpoint: \"ContentManagement/Submission\",\n\t\t\todataAppend: \"?$filter=SourceComponent eq 'UserOnboarding' and State eq 'new' and CreatedBy eq '\" + session.user + \"' and AppId eq \" + app.Id\n\t\t});\n\t\tvar grid = await [script[UserOnboardingGrid]]({element: container, dataSource: dataSource});\n\t\tgrid.detailTemplate = \"<div name='newRequestDialog'>\" + $(\"[name=viewRequest\").html() + \"</div>\";\n\t\tgrid.detailExpand = async (e) => { await UserOnboarding.viewRequest(e, app, grid); };\n\t\tawait grid.init();\n\t\t$(\"[name=addUserOnboardingRequest]\", grid.gridElement).on(\"click\", async function (e) { await UserOnboarding.addUserOnboardingRequest(e, app, grid); });\n\t},\n\n\taddUserOnboardingRequest: async function (e, app, grid) {\n\t\tvar newRequestForm = new Dialog({ title: \"[resource_displayname[NewAccessRequest]]\", width: 850 });\n\t\tnewRequestForm.template = $(\"[name=userOnboardingNewRequestWizardComponent]\").first().html();\n\t\tnewRequestForm.init();\n        UserOnboardingNewRequestWizard.init(app, newRequestForm.element, grid, newRequestForm);\n\t},\n\n\tviewRequest: async function (e, app, grid) {\n\t\tif (!$($(e.detailRow)).attr(\"expanded\")) {\n\t\t\t$($(e.detailRow)).attr(\"expanded\");\n\t\t\tvar submission = grid.kendoObject.dataItem(e.masterRow);\n\t\t\tvar formData = JSON.parse(submission.DataJson).fields;\n\t\t\tvar model = new kendo.observable(formData);\n\t\t\tkendo.bind($(e.detailRow), model);\n\t\t\tvar countries = await api.get(\"B2B/Country\");\n\t\t\t$(\"select\", $(e.detailRow)).kendoDropDownList();\n\t\t\t$(\"input[name=country]\", $(e.detailRow)).kendoDropDownList({\n\t\t\t\tdataSource: { data: countries.value, sort: [{field: \"Name\", dir: \"asc\"}] },\n\t\t\t\tdataValueField: \"Id\",\n\t\t\t\tdataTextField: \"Name\"\n\t\t\t}).data(\"kendoDropdownList\");\n\t\t\t$(\"[name=save]\", $(e.detailRow)).off(\"click\").on(\"click\", async (e) => { await UserOnboarding.saveRequest(e, grid, submission, model); });\n\t\t}\n\t},\n\n\tsaveRequest: async function (e, grid, submission, model) {\n\t\te.preventDefault();\n\t\tnotification.success(\"[resource_displayname[saved]]\");\n\t\tsubmission.DataJson = JSON.stringify({ fields: JSON.parse(JSON.stringify(model)) });\n\t\tdelete submission.type;\n\t\tawait api.update(\"ContentManagement/Submission(\" + submission.Id + \")\", submission);\n\t\tgrid.kendoObject.dataSource.read();\n\t}\n}",
  "Name": "UserOnboarding",
  "Description": null,
