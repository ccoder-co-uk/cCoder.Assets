  "Script": "UserOnboardingAdmin = {\n\tstates: {\n\t\t\u0022New\u0022: \u0022[resource_displayname[New]]\u0022,\n\t\t\u0022Rejected\u0022: \u0022[resource_displayname[rejected]]\u0022,\n\t\t\u0022Pending\u0022: \u0022[resource_displayname[pending]]\u0022,\n\t\t\u0022AdminRejected\u0022: \u0022[resource_displayname[adminRejected]]\u0022,\n\t\t\u0022Accepted\u0022: \u0022[resource_displayname[accepted]]\u0022\n\t},\n\n\ticonStates: {\n\t\t\u0022New\u0022: \u0022k-i-file\u0022,\n\t\t\u0022Accepted\u0022: \u0022k-i-file-add\u0022,\n\t\t\u0022Pending\u0022: \u0022k-i-file-config\u0022,\n\t\t\u0022Rejected\u0022: \u0022k-i-file-error\u0022\n\t},\n\n\trequestTypes: {\n\t\t\u0022buyer\u0022: \u0022[resource_displayname[buyer]]\u0022,\n\t\t\u0022supplierreadonly\u0022: \u0022[resource_displayname[supplierreadonly]]\u0022,\n\t\t\u0022supplieralacarte\u0022: \u0022[resource_displayname[supplieralacarte]]\u0022,\n\t\t\u0022funder\u0022: \u0022[resource_displayname[funder]]\u0022\n\t},\n\n\tinit: async function (app, container) {\n\t\tapp = app || session.app;\n\t\tcontainer = container || $(\u0022.component[name=UserOnboardingAdmin]\u0022);\n        api.addToMetaCache([\n            {\n        \u0022Name\u0022: \u0022Core\u0022,\n        \u0022Types\u0022: [\n            [meta[Core/Submission]]\n        ]\n    }\n        ]);\n\t\tvar dataSource = await model.getDatasource({\n\t\t\tendpoint: \u0022ContentManagement/Submission\u0022,\n\t\t\todataAppend: \u0022?$filter=SourceComponent eq \u0027UserOnboarding\u0027 and State eq \u0027new\u0027 and AppId eq \u0022 \u002B app.Id\n\t\t});\n\t\tvar grid = await [script[UserOnboardingAdminGrid]]({ element: $(\u0022[name=userOnboardingGrid]\u0022, container), dataSource: dataSource });\n\t\tgrid.detailTemplate = \u0022\u003Cdiv name=\u0027newRequestDialog\u0027\u003E\u0022 \u002B $(\u0022[name=viewRequest\u0022).html() \u002B \u0022\u003C/div\u003E\u0022;\n\t\tgrid.detailExpand = async (e) =\u003E { await UserOnboardingAdmin.viewRequest(e, app, grid); };\n\t\tawait grid.init();\n\t\t$(\u0022[name=addUserOnboardingRequest]\u0022, grid.gridElement).on(\u0022click\u0022, async (e) =\u003E await UserOnboardingAdmin.addUserOnboardingRequest(e, app, grid));\n\t},\n\n\taddUserOnboardingRequest: async function (e, app, grid) {\n\t\tvar newRequestForm = new Dialog({ title: \u0022[resource_displayname[NewAccessRequest]]\u0022, width: 850 });\n\t\tnewRequestForm.template = $(\u0022[name=userOnboardingNewRequestWizardComponent]\u0022).first().html();\n\t\tnewRequestForm.init();\n        UserOnboardingNewRequestWizard.init(app, newRequestForm.element, grid, newRequestForm);\n\t},\n\n\tsubmitRequest: async function (e, app, grid, model) {\n\t\te.preventDefault();\n\t\tvar submission = { SourceComponent: \u0022UserOnboarding\u0022, State: \u0022New\u0022, DataJson: JSON.stringify({ \u0022fields\u0022: JSON.parse(JSON.stringify(model)) }), AppId: app.Id };\n\t\tawait api.add(\u0022ContentManagement/Submission\u0022, submission);\n\t\tnotification.success(\u0022[resource_displayname[SubmissionSubmitted]]\u0022);\n\t\tgrid.refresh();\n\t},\n\n\tviewRequest: async function (e, app, grid) {\n\t\tif (!$($(e.detailRow)).attr(\u0022expanded\u0022)) {\n\t\t\t$($(e.detailRow)).attr(\u0022expanded\u0022);\n\t\t\tvar submission = grid.kendoObject.dataItem(e.masterRow);\n\t\t\tvar formData = JSON.parse(submission.DataJson).fields;\n\t\t\tvar model = new kendo.observable(formData);\n\t\t\tkendo.bind($(e.detailRow), model);\n\t\t\tvar countries = await api.get(\u0022B2B/Country\u0022);\n\t\t\t$(\u0022input[name=country]\u0022, $(e.detailRow)).kendoDropDownList({ dataSource: countries.value, dataValueField: \u0022Id\u0022, dataTextField: \u0022Name\u0022 });\n\t\t\t$(\u0022select\u0022, $(e.detailRow)).kendoDropDownList();\n\t\t\t$(\u0022button[name=approve]\u0022, $(e.detailRow)).off(\u0022click\u0022).on(\u0022click\u0022, async (e) =\u003E { await UserOnboardingAdmin.acceptRequest(e, app, grid, submission); });\n\t\t\t$(\u0022button[name=reject]\u0022, $(e.detailRow)).off(\u0022click\u0022).on(\u0022click\u0022, async (e) =\u003E { await UserOnboardingAdmin.rejectRequest(e, app, grid, submission); });\n\t\t\t$(\u0022button[name=pending]\u0022, $(e.detailRow)).off(\u0022click\u0022).on(\u0022click\u0022, async (e) =\u003E { await UserOnboardingAdmin.pendingRequest(e, app, grid, submission); });\n\t\t\t$(\u0022[name=save]\u0022, $(e.detailRow)).off(\u0022click\u0022).on(\u0022click\u0022, async (e) =\u003E { await UserOnboardingAdmin.saveRequest(e, grid, submission, model); });\n\t\t}\n\t},\n\n\tsaveRequest: async function (e, grid, submission, model) {\n\t\te.preventDefault();\n\t\tnotification.success(\u0022[resource_displayname[saved]]\u0022);\n\t\tsubmission.DataJson = JSON.stringify({ fields: JSON.parse(JSON.stringify(model)) });\n\t\tdelete submission.type;\n\t\tawait api.update(\u0022ContentManagement/Submission(\u0022 \u002B submission.Id \u002B \u0022)\u0022, submission);\n\t\tgrid.kendoObject.dataSource.read();\n\t},\n\n\tacceptRequest: async function (e, app, grid, submission) {\n\t\te.preventDefault();\n\t\tvar acceptWizardDialog = new Dialog({ title: \u0022[resource_displayname[AcceptRequest]]\u0022, height: 520, width: 975 });\n\n\t\tacceptWizardDialog.init(async () =\u003E {\n\t\t\tvar c = await loadComponent(acceptWizardDialog.element, \u0022UserOnboardingAcceptWizard\u0022);\n\t\t\tc.init(app, acceptWizardDialog.element, grid, submission, acceptWizardDialog)\n\t\t})\n\t},\n\n\trejectRequest: async function (e, app, grid, submission) {\n\t\te.preventDefault();\n\t\tsubmission.State = \u0022Rejected\u0022;\n\t\tdelete submission.type;\n\t\tvar rejectReasonDialog = new Dialog({ title: \u0022[resource_displayname[rejectreason]]\u0022 });\n\t\trejectReasonDialog.template = $(\u0022script[name=rejectReason]\u0022).html();\n\t\trejectReasonDialog.events.reject = async function (e) {\n\t\t\tawait api.update(\u0022ContentManagement/Submission(\u0022 \u002B submission.Id \u002B \u0022)\u0022, submission);\n\t\t\tgrid.kendoObject.dataSource.read();\n\t\t\tvar workflowData = { SubmissionId: submission.Id, RejectReason: $(\u0022input[name=rejectReason]\u0022, rejectReasonDialog.element).val() };\n\t\t\tvar rejectWorkflow = await api.get(\u0022Workflow/FlowDefinition?$filter=Name eq \u0027OnboardingReject\u0027 and AppId eq \u0022 \u002B app.Id);\n\t\t\tawait api.add(\u0022Workflow/FlowDefinition(\u0022 \u002B rejectWorkflow.value[0].Id \u002B \u0022)/Execute()\u0022, workflowData).then(() =\u003E { notification.success(\u0022[resource_displayname[executed]]\u0022); rejectReasonDialog.events.close(); });\n\t\t};\n\t\trejectReasonDialog.init();\n\t},\n\n\tpendingRequest: async function(e, app, grid,submission) {\n\t\te.preventDefault();\n\t\tsubmission.State = \u0022Pending\u0022;\n\t\tgrid.kendoObject.dataSource.read();\n\t}\n}",
