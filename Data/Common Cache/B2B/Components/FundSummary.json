  "Content": "<div class=\"box\">\n   <h4>Basic Information</h4>\n   <ul class=\"fieldList\">\n      <li><label>Name</label><div class=\"value\"></div></li>\n      <li><label>Description</label><div class=\"value\"></div></li>\n      <li><label>Ref</label><div class=\"value\"></div></li>\n   </ul>\n</div>\n\n<div class=\"box\">\n   <h4>Transaction Value</h4>\n   <ul class=\"fieldList\">\n      <li><label>Limit</label><div class=\"value\">0.00 AUD</div></li>\n      <li><label>Funded</label><div class=\"value\">0.00 AUD</div></li>\n      <li><label>New Today</label><div class=\"value\">0.00 AUD</div></li>\n      <li><label>Debtor Paid Today</label><div class=\"value\">0.00 AUD</div></li>\n   </ul>\n</div>\n\n<div class=\"box\">\n   <h4>Transaction Counts</h4>\n   <ul class=\"fieldList\">\n      <li><label>New Today</label><div class=\"value\">0</div></li>\n      <li><label>Funded</label><div class=\"value\">0</div></li>\n      <li><label>Not funded</label><div class=\"value\">0</div></li>\n      <li><label>Client Validated</label><div class=\"value\">0</div></li>\n      <li><label>Client Not-Validated</label><div class=\"value\">0</div></li>\n   </ul>\n</div>\n\n<div class=\"box\">\n   <h4>Ageing</h4>\n   <ul class=\"fieldList\">\n      <li><label>0 - 30</label><div class=\"value\">0</div></li>\n      <li><label>31 - 60</label><div class=\"value\">0</div></li>\n      <li><label>61 - 90</label><div class=\"value\">0</div></li>\n      <li><label>90+</label><div class=\"value\">0</div></li>\n   </ul>\n</div>\n\n<div class=\"box\">\n   <h4>Dates</h4>\n   <ul class=\"fieldList\">\n      <li><label>Next Payment</label><div class=\"value\">2019 Nov 30</div></li>\n   </ul>\n</div>\n\n<style>\n   .box { width: 330px; display: inline-block; height: 180px; vertical-align: top; }\n   .box label { font-weight: bold; }\n</style>",
  "Script": "FundSummary = {\n\tinit: function(app, container, fund) {\n    \tapp = app || session.app;\n        container = container || $(\".component[name=FundSummary]\");\n        if(fund) {\n        \tFundSummary.setup(fund);\n        }\n        else {\n              var fundId = getQueryParameter(\"fundId\");\n             api.get(\"B2B/Bucket(\" + fundId + \")\", function(f) { FundSummary.setup(app, container, f); });\n        }   \n    },\n   \n    setup: function(app, container, fund) {\n    \t\n    }\n}",
