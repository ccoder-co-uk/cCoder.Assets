  "HeaderHtml": "\u003Cmeta property=\u0022keywords\u0022 content=\u0022[page[keywords]]\u0022 /\u003E\n\u003Cmeta property=\u0022description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:locale\u0022 content=\u0022[[culture]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:type\u0022 content=\u0022website\u0022 /\u003E\n\u003Cmeta property=\u0022og:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:url\u0022 content=\u0022[page[url]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:site_name\u0022 content=\u0022[app[name]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:image\u0022 content=\u0022[app[root]]images/ccoder-logo.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:secure_url\u0022 content=\u0022[app[root]]images/ccoder-logo.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:type\u0022 content=\u0022image/png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:width\u0022 content=\u00222838\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:height\u0022 content=\u00221088\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:card\u0022 content=\u0022summary_large_image\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image\u0022 content=\u0022[app[root]]images/ccoder-logo.png\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\u003Cmeta name=\u0022theme-color\u0022 content=\u0022#0E4A7A\u0022 /\u003E\n\u003Cmeta charset=\u0022utf-8\u0022 /\u003E\n\u003Cmeta name=\u0022viewport\u0022 content=\u0022width=600\u0022 /\u003E\n\u003Cscript\u003E(function(){document.querySelectorAll(\u0027meta[name=\u0022viewport\u0022]\u0027).forEach(function(meta){meta.setAttribute(\u0027content\u0027,\u0027width=600\u0027);});})();\u003C/script\u003E\n\u003Clink rel=\u0022canonical\u0022 href=\u0022[page[url]]\u0022 /\u003E\n\u003Cstyle nonce=\u0022[request[nonce]]\u0022\u003E\r\n[style[Dependency.Bootstrap.Bootstrap]]\r\n[style[Dependency.Kendo.KendoV20242514Bootstrap]]\r\n[style[Baseline]]\r\n\u003C/style\u003E\n[theme[template]]\n\u003Cstyle\u003E\n    .site-shell {\n        display: flex;\n        flex-direction: column;\n        height: 100vh;\n        overflow: hidden;\n    }\n\n    .site-main {\n        overflow: hidden;\n    }\n\n    .site-shell,\n    .site-main,\n    .site-main \u003E .container-fluid,\n    .admin-page-shell {\n        min-height: 0;\n    }\n\n    .site-main,\n    .site-main \u003E .container-fluid,\n    .admin-page-shell,\n    .admin-page-content {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n    }\n\n    .admin-page-shell {\n        gap: 1.5rem;\n        padding: 0.5rem 0 1.5rem;\n    }\n\n    .admin-page-header {\n        flex: 0 0 auto;\n    }\n\n    .admin-page-header h2 {\n        margin: 0;\n    }\n\n    .admin-page-content {\n        min-width: 0;\n        overflow: hidden;\n    }\n\n    .admin-page-content \u003E .component {\n        flex: 1 1 auto;\n        min-height: 0;\n    }\n\u003C/style\u003E",
  "Html": "\u003Cstyle\u003E.site-header-row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr 1fr;align-items:start;box-sizing:border-box;height:122px;padding:0}.site-brand{grid-column:1;grid-row:1/3;align-self:center}.site-brand img{flex:0 0 auto;width:auto;max-width:min(77vw,320px);height:clamp(116px,8vw,126px);padding:0}.site-utility{display:flex;grid-column:2;grid-row:1;align-self:start;justify-self:end;flex-direction:row;align-items:center;justify-content:flex-end;gap:var(--site-gap);width:auto!important;margin:0;padding-top:.5rem;transform:translateY(.25rem);white-space:nowrap}.site-utility .component[name=UserProfile] .userName{min-width:0;justify-content:flex-end}.site-nav-host{grid-column:2;grid-row:2;align-self:start;justify-self:end;margin:.25rem 0 0 var(--site-gap)}@media(max-width:991.98px){.site-nav-host{align-self:center;margin-top:0;transform:translateY(-12px)}}\u003C/style\u003E\u003Cscript nonce=\u0022[request[nonce]]\u0022\u003E\r\n[script[Dependency.Jquery.Jquery370]]\r\n[script[Dependency.Jquery.JqueryValidate]]\r\n[script[Dependency.Jquery.JqueryUi]]\r\n[script[Dependency.Kendo.KendoAllV20242514]]\r\n[script[Dependency.Kendo.KendoUiLicense]]\r\n[script[Dependency.Bootstrap.BootstrapBundle]]\r\n[script[Dependency.Other.Signalr]]\r\n[script[Widgets.Widget]]\r\n[script[Core.Api]]\r\n[script[Core.Util]]\r\n[script[Core.Model]]\r\n[script[Monaco.MonacoEditor]]\r\n[script[Monaco.JavaScriptMonacoEditor]]\r\n[script[Monaco.HTMLMonacoEditor]]\r\n[script[Monaco.CSharpMonacoEditor]]\r\n[script[Core.Drawing]]\r\n[script[Widgets.Dialog]]\r\n[script[Widgets.BootstrapDialog]]\r\n[script[Widgets.BootstrapTabs]]\r\n[script[Widgets.Chart]]\r\n[script[Widgets.PieChart]]\r\n[script[Widgets.ConfirmDialog]]\r\n[script[Widgets.ConsoleDialog]]\r\n[script[Widgets.ExportDialog]]\r\n[script[Widgets.Detail]]\r\n[script[Widgets.EditorDialog]]\r\n[script[Widgets.Grid]]\r\n[script[Widgets.ContextMenuWidget]]\r\n[script[Widgets.FileDropContainerWidget]]\r\n[script[Widgets.Picker]]\r\n[script[Widgets.ReadOnlyDetailView]]\r\n[script[Widgets.Tree]]\r\n[script[Widgets.DataTreeView]]\r\n[script[Widgets.OdataTree]]\r\n[script[Widgets.Workspace]]\r\n[script[Widgets.WritableDetailView]]\r\n[script[Workflow.Close]]\r\n[script[Workflow.Handle]]\r\n[script[Workflow.Link]]\r\n[script[Workflow.Action]]\r\n[script[Workflow.Activity]]\r\n[script[Workflow.Connector]]\r\n[script[Workflow.Flow]]\r\n[script[Workflow.Workflowdesigner]]\r\n\u003C/script\u003E\n\u003Cdiv class=\u0022site-shell\u0022\u003E\n    \u003Cheader class=\u0022site-header\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl\u0022\u003E\n            \u003Cdiv class=\u0022site-header-row\u0022\u003E\n                \u003Ca class=\u0022site-brand\u0022 href=\u0022/\u0022 title=\u0022[app[name]]\u0022\u003E\n                    \u003Cimg src=\u0022[app[root]]images/ccoder-logo.png\u0022 alt=\u0022[app[name]]\u0022 /\u003E\u003C/a\u003E\n                \u003Cdiv class=\u0022site-nav-host\u0022\u003E[component[TopNav]]\u003C/div\u003E\u003Cdiv class=\u0022site-utility\u0022\u003E\u003Cdiv class=\u0022utility-flags\u0022\u003E[component[CultureFlags]]\u003C/div\u003E\u003Cdiv class=\u0022utility-time\u0022\u003E\u003Cspan id=\u0022site-date\u0022\u003E\u003C/span\u003E \u003Cspan id=\u0022time\u0022\u003E\u003C/span\u003E\u003C/div\u003E\u003Cdiv class=\u0022utility-user\u0022\u003E[component[UserProfile]]\u003C/div\u003E\u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/header\u003E\n    \u003Cmain class=\u0022site-main\u0022\u003E\u003Cdiv class=\u0022container-fluid\u0022\u003E\u003Csection class=\u0022admin-page-shell\u0022\u003E\u003Cdiv class=\u0022admin-page-header\u0022\u003E\u003Ch2\u003E[page[title]]\u003C/h2\u003E\u003C/div\u003E\u003Cdiv class=\u0022admin-page-content\u0022\u003E[content[body]]\u003C/div\u003E\u003C/section\u003E\u003C/div\u003E\u003C/main\u003E\n    \u003Cfooter class=\u0022site-footer\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\u0022\u003E\n            \u003Cspan\u003E\u0026copy; 2026, cCoder\u003C/span\u003E\n            \u003Cspan\u003EStandards-first bespoke cloud software with public documentation and practical platform tools.\u003C/span\u003E\n        \u003C/div\u003E\n    \u003C/footer\u003E\n\u003C/div\u003E\n\u003Cscript\u003E\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \u0022[resource_displayname[dateformat]]\u0022;\n    if (!type.dateFormat || type.dateFormat.toLowerCase() === \u0022dateformat\u0022) { type.dateFormat = \u0022yyyy MMMM dd\u0022; }\n    type.shortDateFormat = \u0022[resource_displayname[shortdateformat]]\u0022;\n    if (!type.shortDateFormat || type.shortDateFormat.toLowerCase() === \u0022shortdateformat\u0022) { type.shortDateFormat = \u0022yyyy-MM-dd\u0022; }\n    type.dateAndTimeFormat = \u0022[resource_displayname[dateandtimeformat]]\u0022;\n    if (!type.dateAndTimeFormat || type.dateAndTimeFormat.toLowerCase() === \u0022dateandtimeformat\u0022) { type.dateAndTimeFormat = \u0022yyyy MMMM dd HH:mm\u0022; }\n    type.timeFormat = \u0022[resource_displayname[timeformat]]\u0022;\n    if (!type.timeFormat || type.timeFormat.toLowerCase() === \u0022timeformat\u0022) { type.timeFormat = \u0022HH:mm\u0022; }\n    type.moneyFormat = \u0022[resource_displayname[moneyformat]]\u0022;\n    type.aggregateMoneyFormat = \u0022[resource_displayname[aggregateMoneyFormat]]\u0022;\n\n    initContent();\n    function updateSiteHeaderDate() {\n        var dateElement = document.getElementById(\u0027site-date\u0027);\n        if (!dateElement) return;\n        var pageCulture = document.querySelector(\u0027meta[property=\u0022og:locale\u0022]\u0027);\n        var activeCulture = document.querySelector(\u0027.culture.active[data-culture]\u0027);\n        var cultureName = (pageCulture \u0026\u0026 pageCulture.getAttribute(\u0027content\u0027)) || (activeCulture \u0026\u0026 activeCulture.getAttribute(\u0027data-culture\u0027)) || (window.kendo \u0026\u0026 kendo.culture \u0026\u0026 kendo.culture().name) || navigator.language || \u0027en-GB\u0027;\n        dateElement.textContent = new Intl.DateTimeFormat(cultureName, {\n            day: \u00272-digit\u0027,\n            month: \u0027long\u0027,\n            year: \u0027numeric\u0027\n        }).format(new Date());\n    }\n    updateSiteHeaderDate();\n    window.addEventListener(\u0027load\u0027, updateSiteHeaderDate);\n    window.setInterval(updateSiteHeaderDate, 60000);\n\n    kendo.setDefaults(\u0027iconType\u0027, \u0027svg\u0027);\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\u0022.k-icon:not(.k-svg-icon):not(.k-font-icon)\u0022).each(function() {\n            var iconName = $(this).attr(\u0027class\u0027).split(\u0027 \u0027).filter(function(cls) {\n                return cls !== \u0027k-icon\u0027;\n            })[0].replace(/^k-i-/, \u0022\u0022).replace(\u0022source-code\u0022, \u0022code\u0022);\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: \u0027svg\u0027 });\n\n            if(svgIcon != \u0060\u003Cspan class=\u0022k-icon k-svg-icon\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u0060) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n\u003C/script\u003E",
