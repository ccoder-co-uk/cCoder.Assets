  "HeaderHtml": "\u003Cmeta property=\u0022keywords\u0022 content=\u0022[page[keywords]]\u0022 /\u003E\n\u003Cmeta property=\u0022description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:locale\u0022 content=\u0022[[culture]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:type\u0022 content=\u0022website\u0022 /\u003E\n\u003Cmeta property=\u0022og:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:url\u0022 content=\u0022[page[url]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:site_name\u0022 content=\u0022[app[name]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:secure_url\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:type\u0022 content=\u0022image/png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:width\u0022 content=\u00222838\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:height\u0022 content=\u00221088\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:card\u0022 content=\u0022summary_large_image\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\u003Cmeta name=\u0022theme-color\u0022 content=\u0022#0E4A7A\u0022 /\u003E\n\u003Cmeta charset=\u0022utf-8\u0022 /\u003E\n\u003Cmeta name=\u0022viewport\u0022 content=\u0022width=600\u0022 /\u003E\n\u003Cscript\u003E(function(){document.querySelectorAll(\u0027meta[name=\u0022viewport\u0022]\u0027).forEach(function(meta){meta.setAttribute(\u0027content\u0027,\u0027width=600\u0027);});})();\u003C/script\u003E\n\u003Clink rel=\u0022canonical\u0022 href=\u0022[page[url]]\u0022 /\u003E\n\n\u003Cstyle nonce=\u0022[request[nonce]]\u0022\u003E\r\n[style[Dependency.Bootstrap.Bootstrap]]\r\n[style[Dependency.Kendo.KendoV20242514Bootstrap]]\r\n[style[Baseline]]\r\n\u003C/style\u003E\r\n[theme[template]]",
  "Html": "\u003Cscript nonce=\u0022[request[nonce]]\u0022\u003E\r\n[script[Dependency.Jquery.Jquery370]]\r\n[script[Dependency.Jquery.JqueryValidate]]\r\n[script[Dependency.Jquery.JqueryUi]]\r\n[script[Dependency.Kendo.KendoAllV20242514]]\r\n[script[Dependency.Kendo.KendoUiLicense]]\r\n[script[Dependency.Bootstrap.BootstrapBundle]]\r\n[script[Dependency.Other.Signalr]]\r\n[script[Widgets.Widget]]\r\n[script[Core.Api]]\r\n[script[Core.Util]]\r\n[script[Core.Model]]\r\n\u003C/script\u003E\r\n\u003Cdiv class=\u0022site-shell\u0022\u003E\n    \u003Cheader class=\u0022site-header\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl\u0022\u003E\n            \u003Cdiv class=\u0022site-header-row\u0022\u003E\n                \u003Ca class=\u0022site-brand\u0022 href=\u0022/\u0022 title=\u0022[app[name]]\u0022\u003E\n                    \u003Cimg src=\u0022[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\u0022 alt=\u0022[app[name]]\u0022 /\u003E\u003C/a\u003E\n                \u003Cdiv class=\u0022site-nav-host\u0022\u003E[component[TopNav]]\u003C/div\u003E\u003Cdiv class=\u0022site-utility\u0022\u003E\u003Cdiv class=\u0022utility-flags\u0022\u003E[component[CultureFlags]]\u003C/div\u003E\u003Cdiv class=\u0022utility-user\u0022\u003E[component[UserProfile]]\u003C/div\u003E\u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/header\u003E\n    \u003Cmain class=\u0022site-main\u0022\u003E\u003Cdiv class=\u0022container-xxl\u0022\u003E\u003Cdiv class=\u0022docs-page\u0022\u003E\u003Cbutton class=\u0022docs-menu-tab\u0022 type=\u0022button\u0022 aria-controls=\u0022documentation-navigation\u0022 aria-expanded=\u0022false\u0022 aria-label=\u0022Open documentation navigation\u0022\u003E\u003Cspan class=\u0022k-icon k-i-menu\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u003Cspan\u003EDocs\u003C/span\u003E\u003C/button\u003E\u003Caside class=\u0022docs-sidebar\u0022 id=\u0022documentation-navigation\u0022 aria-label=\u0022Documentation navigation\u0022\u003E\u003Cbutton class=\u0022docs-menu-close\u0022 type=\u0022button\u0022 aria-label=\u0022Close documentation navigation\u0022\u003E\u003Cspan class=\u0022k-icon k-i-x\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u003C/button\u003E\u003Cdiv class=\u0022docs-sidebar-inner\u0022\u003E[component[Sidenav]]\u003C/div\u003E\u003C/aside\u003E\u003Cbutton class=\u0022docs-menu-backdrop\u0022 type=\u0022button\u0022 tabindex=\u0022-1\u0022 aria-label=\u0022Close documentation navigation\u0022\u003E\u003C/button\u003E\u003Csection class=\u0022docs-content\u0022\u003E[content[body]class=docs-body]\u003C/section\u003E\u003C/div\u003E\u003C/div\u003E\u003C/main\u003E\n    \u003Cfooter class=\u0022site-footer\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\u0022\u003E\n            \u003Cspan\u003E\u0026copy; 2026, cCoder\u003C/span\u003E\n            \u003Cspan\u003EStandards-first bespoke cloud software with public documentation and practical platform tools.\u003C/span\u003E\n        \u003C/div\u003E\n    \u003C/footer\u003E\n\u003C/div\u003E\n\u003Cstyle\u003E\n.docs-menu-tab,.docs-menu-close,.docs-menu-backdrop{display:none}\n@media(max-width:991.98px){.docs-page{display:block}.docs-page .docs-sidebar{position:fixed;inset:0 auto 0 0;z-index:1060;width:min(86vw,340px);height:100dvh;padding:calc(var(--site-gap)*2);overflow-y:auto;background:var(--site-surface);box-shadow:var(--site-shadow);transform:translateX(-105%);transition:transform .2s ease;visibility:hidden}.docs-page.docs-menu-open .docs-sidebar{transform:translateX(0);visibility:visible}.docs-menu-tab{display:flex;position:fixed;left:0;top:50%;z-index:1050;align-items:center;gap:.4rem;padding:.75rem .55rem;border:var(--site-border);border-left:0;border-radius:0 var(--site-radius) var(--site-radius) 0;background:var(--site-primary);color:var(--site-contrast);box-shadow:var(--site-shadow);writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}.docs-menu-tab:hover,.docs-menu-tab:focus-visible{background:var(--site-secondary)}.docs-menu-close{display:flex;position:sticky;top:0;z-index:1;margin:0 0 var(--site-gap) auto;padding:.55rem;border:var(--site-border);border-radius:var(--site-radius);background:var(--site-primary);color:var(--site-contrast)}.docs-menu-backdrop{position:fixed;inset:0;z-index:1055;width:100%;height:100%;border:0;background:rgba(16,36,63,.42)}.docs-page.docs-menu-open .docs-menu-backdrop{display:block}body.docs-menu-open{overflow:hidden}}\n@media(prefers-reduced-motion:reduce){.docs-page .docs-sidebar{transition:none!important}}\n.site-shell{height:100dvh;min-height:0;overflow:hidden}.site-header,.site-footer{flex:0 0 auto}.site-main{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}.site-header-row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr 1fr;align-items:start;box-sizing:border-box;height:122px;padding:0}.site-brand{grid-column:1;grid-row:1/3;align-self:center}.site-brand img{flex:0 0 auto;width:auto;max-width:min(77vw,320px);height:clamp(116px,8vw,126px);padding:0}.site-utility{display:flex;grid-column:2;grid-row:1;align-self:start;justify-self:end;flex-direction:row;align-items:center;justify-content:flex-end;gap:var(--site-gap);width:auto!important;margin:0;padding-top:.5rem;transform:translateY(.25rem);white-space:nowrap}.site-utility .component[name=UserProfile] .userName{min-width:0;justify-content:flex-end}.site-nav-host{grid-column:2;grid-row:2;align-self:start;justify-self:end;margin:.25rem 0 0 var(--site-gap)}@media(max-width:991.98px){.site-nav-host{align-self:center;margin-top:0;transform:translateY(-12px)}}\u003C/style\u003E\n\r\n\u003Cscript\u003E\r\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \u0022[resource_displayname[dateformat]]\u0022;\n    type.shortDateFormat = \u0022[resource_displayname[shortdateformat]]\u0022;\n    type.moneyFormat = \u0022[resource_displayname[moneyformat]]\u0022;\n    type.aggregateMoneyFormat = \u0022[resource_displayname[aggregateMoneyFormat]]\u0022;\n\n    function initDocumentationMenu() {\n        var page = document.querySelector(\u0027.docs-page\u0027);\n        if (!page) return;\n        var openButton = page.querySelector(\u0027.docs-menu-tab\u0027);\n        var closeButton = page.querySelector(\u0027.docs-menu-close\u0027);\n        var backdrop = page.querySelector(\u0027.docs-menu-backdrop\u0027);\n        var sidebar = page.querySelector(\u0027.docs-sidebar\u0027);\n        function setOpen(isOpen, restoreFocus) {\n            page.classList.toggle(\u0027docs-menu-open\u0027, isOpen);\n            document.body.classList.toggle(\u0027docs-menu-open\u0027, isOpen);\n            openButton.setAttribute(\u0027aria-expanded\u0027, String(isOpen));\n            sidebar.setAttribute(\u0027aria-hidden\u0027, String(!isOpen));\n            if (isOpen) closeButton.focus(); else if (restoreFocus) openButton.focus();\n        }\n        openButton.addEventListener(\u0027click\u0027, function () { setOpen(true, false); });\n        closeButton.addEventListener(\u0027click\u0027, function () { setOpen(false, true); });\n        backdrop.addEventListener(\u0027click\u0027, function () { setOpen(false, true); });\n        document.addEventListener(\u0027keydown\u0027, function (event) { if (event.key === \u0027Escape\u0027 \u0026\u0026 page.classList.contains(\u0027docs-menu-open\u0027)) setOpen(false, true); });\n        window.matchMedia(\u0027(min-width: 992px)\u0027).addEventListener(\u0027change\u0027, function (event) { if (event.matches) setOpen(false, false); });\n    }\n    initContent();\n    initDocumentationMenu();\n    kendo.setDefaults(\u0027iconType\u0027, \u0027svg\u0027);\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\u0022.k-icon:not(.k-svg-icon):not(.k-font-icon)\u0022).each(function() {\n            var iconName = $(this).attr(\u0027class\u0027).split(\u0027 \u0027).filter(function(cls) {\n                return cls !== \u0027k-icon\u0027;\n            })[0].replace(/^k-i-/, \u0022\u0022).replace(\u0022source-code\u0022, \u0022code\u0022);\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: \u0027svg\u0027 });\n\n            if(svgIcon != \u0060\u003Cspan class=\u0022k-icon k-svg-icon\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u0060) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n\u003C/script\u003E",
