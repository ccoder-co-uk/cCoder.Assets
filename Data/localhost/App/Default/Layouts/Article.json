  "HeaderHtml": "\u003Cmeta property=\u0022keywords\u0022 content=\u0022[page[keywords]]\u0022 /\u003E\n\u003Cmeta property=\u0022description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:locale\u0022 content=\u0022[[culture]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:type\u0022 content=\u0022website\u0022 /\u003E\n\u003Cmeta property=\u0022og:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:url\u0022 content=\u0022[page[url]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:site_name\u0022 content=\u0022[app[name]]\u0022 /\u003E\n\u003Cmeta property=\u0022og:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:secure_url\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:type\u0022 content=\u0022image/png\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:width\u0022 content=\u00222838\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:height\u0022 content=\u00221088\u0022 /\u003E\n\u003Cmeta property=\u0022og:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:card\u0022 content=\u0022summary_large_image\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:title\u0022 content=\u0022[page[title]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:description\u0022 content=\u0022[page[description]]\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image\u0022 content=\u0022https://ccoder.co.uk/Api/DMS/Content/CompanyLogoTransparent.png\u0022 /\u003E\n\u003Cmeta name=\u0022twitter:image:alt\u0022 content=\u0022cCoder logo\u0022 /\u003E\u003Cmeta charset=\u0022utf-8\u0022 /\u003E\n\u003Cmeta name=\u0022viewport\u0022 content=\u0022width=600\u0022 /\u003E\n\u003Cscript\u003E(function(){document.querySelectorAll(\u0027meta[name=\u0022viewport\u0022]\u0027).forEach(function(meta){meta.setAttribute(\u0027content\u0027,\u0027width=600\u0027);});})();\u003C/script\u003E\n\u003Clink rel=\u0022canonical\u0022 href=\u0022[page[url]]\u0022 /\u003E\n\u003Cstyle nonce=\u0022[request[nonce]]\u0022\u003E\r\n[style[Dependency.Bootstrap.Bootstrap]]\r\n[style[Dependency.Kendo.KendoV20242514Bootstrap]]\r\n[style[Baseline]]\r\n\u003C/style\u003E\n[theme[template]]\n\u003Cstyle id=\u0022ccoder-public-theme\u0022\u003E\n.public-flow-section \u003E .public-section-frame {\n  border: 0;\n  background: transparent;\n  box-shadow: none;\n}\n\n.public-flow-section.public-banner-deep \u003E .public-section-frame {\n  background: #142a48;\n  border: 0;\n}\n\n.public-flow-section.public-banner-blue \u003E .public-section-frame {\n  background: #0e6fae;\n  border: 0;\n}\n\n.public-banner .public-hero-copy .site-kicker,\n.public-banner \u003E .public-section-frame \u003E .site-kicker {\n  color: #8fd4ff;\n}\n\n.public-banner .public-hero-copy .public-hero-title,\n.public-banner .public-hero-copy .public-copy {\n  color: #ffffff;\n}\n\n.public-flow-section .public-card,\n.public-flow-section .public-hero-list,\n.public-flow-section .accordion .accordion-item {\n  border-color: rgba(20, 42, 72, .16);\n  background: #ffffff;\n  box-shadow: 0 8px 20px rgba(20, 42, 72, .07);\n}\n\n.public-flow-section .public-card:hover {\n  border-color: rgba(82, 188, 255, .55);\n}\n\n.public-feature-card {\n  max-width: 900px;\n  margin: 0 auto;\n}\n\n.public-article {\n  width: min(100%, 900px);\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.public-domain-article {\n  width: min(100%, 1180px);\n  max-width: 1180px;\n}\n\n.public-domain-article pre {\n  overflow-x: auto;\n  margin: 1rem 0 1.75rem;\n  padding: 1.25rem 1.4rem;\n  border: 1px solid rgba(20, 42, 72, .16);\n  border-left: 4px solid #0e6fae;\n  border-radius: 4px;\n  background: #f7fbfe;\n  color: #10263a;\n}\n\n.public-domain-article pre code {\n  white-space: pre;\n  color: inherit;\n  background: transparent;\n}\n\n.public-domain-article pre code {\n  font-size: 1rem;\n  line-height: 1.65;\n}\n\n.language-csharp .syntax-comment { color: #587287; font-style: italic; }\n.language-csharp .syntax-string { color: #8a3d12; }\n.language-csharp .syntax-keyword { color: #6542a6; font-weight: 700; }\n.language-csharp .syntax-number { color: #096b65; }\n.language-csharp .syntax-type { color: #0a6680; font-weight: 600; }\n\n.public-content-page {\n  width: min(100%, 1180px);\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.public-content-page .public-section-frame {\n  padding-left: 0;\n  padding-right: 0;\n}\n\n.public-content-page .public-article,\n.public-content-page .public-domain-article {\n  width: 100%;\n  max-width: 1180px;\n}\n\n.public-content-page .public-copy,\n.public-content-page .public-page p,\n.public-content-page p,\n.public-content-page li,\n.public-content-page .docs-sidebar-copy,\n.public-content-page .public-section-heading {\n  max-width: none;\n}\n\n\n\n\n\n\n\n\n\n\u003C/style\u003E",
  "Html": "\u003Cscript nonce=\u0022[request[nonce]]\u0022\u003E\r\n[script[Dependency.Jquery.Jquery370]]\r\n[script[Dependency.Jquery.JqueryValidate]]\r\n[script[Dependency.Jquery.JqueryUi]]\r\n[script[Dependency.Kendo.KendoAllV20242514]]\r\n[script[Dependency.Kendo.KendoUiLicense]]\r\n[script[Dependency.Bootstrap.BootstrapBundle]]\r\n[script[Dependency.Other.Signalr]]\r\n[script[Widgets.Widget]]\r\n[script[Core.Api]]\r\n[script[Core.Util]]\r\n[script[Core.Model]]\r\n\u003C/script\u003E\r\n\u003Cdiv class=\u0022site-shell\u0022\u003E\n    \u003Cheader class=\u0022site-header\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl\u0022\u003E\n            \u003Cdiv class=\u0022site-header-row\u0022\u003E\n                \u003Ca class=\u0022site-brand\u0022 href=\u0022/\u0022 title=\u0022[app[name]]\u0022\u003E\n                    \u003Cimg src=\u0022[app[root]]Api/DMS/Content/CompanyLogoTransparent.png\u0022 alt=\u0022[app[name]]\u0022 /\u003E\u003C/a\u003E\n                \u003Cdiv class=\u0022site-nav-host\u0022\u003E[component[TopNav]]\u003C/div\u003E\u003Cdiv class=\u0022site-utility\u0022\u003E\u003Cdiv class=\u0022utility-flags\u0022\u003E[component[CultureFlags]]\u003C/div\u003E\u003Cdiv class=\u0022utility-user\u0022\u003E[component[UserProfile]]\u003C/div\u003E\u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/header\u003E\n    \u003Cmain class=\u0022site-main\u0022\u003E\u003Cdiv class=\u0022container-xxl\u0022\u003E\u003Cdiv class=\u0022public-page public-content-page\u0022\u003E[content[body]]\u003C/div\u003E\u003C/div\u003E\u003C/main\u003E\n    \u003Cfooter class=\u0022site-footer\u0022\u003E\n        \u003Cdiv class=\u0022container-xxl site-footer-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2\u0022\u003E\n            \u003Cspan\u003E\u0026copy; 2026, cCoder\u003C/span\u003E\n            \u003Cspan\u003EArchitecture, engineering and technology leadership through working software.\u003C/span\u003E\n        \u003C/div\u003E\n    \u003C/footer\u003E\n\u003C/div\u003E\n\u003Cstyle\u003E.site-shell{height:100dvh;min-height:0;overflow:hidden}.site-header,.site-footer{flex:0 0 auto}.site-main{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}.site-header-row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr 1fr;align-items:start;box-sizing:border-box;height:122px;padding:0}.site-brand{grid-column:1;grid-row:1/3;align-self:center}.site-brand img{flex:0 0 auto;width:auto;max-width:min(77vw,320px);height:clamp(116px,8vw,126px);padding:0}.site-utility{display:flex;grid-column:2;grid-row:1;align-self:start;justify-self:end;flex-direction:row;align-items:center;justify-content:flex-end;gap:var(--site-gap);width:auto!important;margin:0;padding-top:.5rem;transform:translateY(.25rem);white-space:nowrap}.site-utility .component[name=UserProfile] .userName{min-width:0;justify-content:flex-end}.site-nav-host{grid-column:2;grid-row:2;align-self:start;justify-self:end;margin:.25rem 0 0 var(--site-gap)}@media(max-width:991.98px){.site-nav-host{align-self:center;margin-top:0;transform:translateY(-12px)}}\u003C/style\u003E\n\u003Cscript\u003E\n    [script[DefaultResourcing]]\n    [script[KendoCultures]]\n    type.dateFormat = \u0022[resource_displayname[dateformat]]\u0022;\n    if (!type.dateFormat || type.dateFormat.toLowerCase() === \u0022dateformat\u0022) { type.dateFormat = \u0022yyyy MMMM dd\u0022; }\n    type.shortDateFormat = \u0022[resource_displayname[shortdateformat]]\u0022;\n    if (!type.shortDateFormat || type.shortDateFormat.toLowerCase() === \u0022shortdateformat\u0022) { type.shortDateFormat = \u0022yyyy-MM-dd\u0022; }\n    type.dateAndTimeFormat = \u0022[resource_displayname[dateandtimeformat]]\u0022;\n    if (!type.dateAndTimeFormat || type.dateAndTimeFormat.toLowerCase() === \u0022dateandtimeformat\u0022) { type.dateAndTimeFormat = \u0022yyyy MMMM dd HH:mm\u0022; }\n    type.timeFormat = \u0022[resource_displayname[timeformat]]\u0022;\n    if (!type.timeFormat || type.timeFormat.toLowerCase() === \u0022timeformat\u0022) { type.timeFormat = \u0022HH:mm\u0022; }\n    type.moneyFormat = \u0022[resource_displayname[moneyformat]]\u0022;\n    type.aggregateMoneyFormat = \u0022[resource_displayname[aggregateMoneyFormat]]\u0022;\n\n    initContent();\n    kendo.setDefaults(\u0027iconType\u0027, \u0027svg\u0027);\n\n    const targetNode = document.body;\n    const observerConfig = { attributes: true, childList: true, subtree: true };\n    const observer = new MutationObserver(initIcons);\n    observer.observe(targetNode, observerConfig);\n\n    function initIcons() {\n        observer.disconnect();\n\n        $(\u0022.k-icon:not(.k-svg-icon):not(.k-font-icon)\u0022).each(function() {\n            var iconName = $(this).attr(\u0027class\u0027).split(\u0027 \u0027).filter(function(cls) {\n                return cls !== \u0027k-icon\u0027;\n            })[0].replace(/^k-i-/, \u0022\u0022).replace(\u0022source-code\u0022, \u0022code\u0022);\n\n            var svgIcon = kendo.ui.icon({ icon: iconName, type: \u0027svg\u0027 });\n\n            if(svgIcon != \u0060\u003Cspan class=\u0022k-icon k-svg-icon\u0022 aria-hidden=\u0022true\u0022\u003E\u003C/span\u003E\u0060) {\n                $(this).replaceWith(svgIcon);\n            }\n        });\n\n        observer.observe(targetNode, observerConfig);\n    }\n\n    function highlightCSharpSamples() {\n        const keywords = new Set([\u0022abstract\u0022,\u0022as\u0022,\u0022async\u0022,\u0022await\u0022,\u0022base\u0022,\u0022bool\u0022,\u0022break\u0022,\u0022byte\u0022,\u0022case\u0022,\u0022catch\u0022,\u0022char\u0022,\u0022class\u0022,\u0022const\u0022,\u0022continue\u0022,\u0022decimal\u0022,\u0022default\u0022,\u0022delegate\u0022,\u0022do\u0022,\u0022double\u0022,\u0022else\u0022,\u0022enum\u0022,\u0022event\u0022,\u0022explicit\u0022,\u0022extern\u0022,\u0022false\u0022,\u0022finally\u0022,\u0022fixed\u0022,\u0022float\u0022,\u0022for\u0022,\u0022foreach\u0022,\u0022if\u0022,\u0022implicit\u0022,\u0022in\u0022,\u0022int\u0022,\u0022interface\u0022,\u0022internal\u0022,\u0022is\u0022,\u0022lock\u0022,\u0022long\u0022,\u0022namespace\u0022,\u0022new\u0022,\u0022null\u0022,\u0022object\u0022,\u0022operator\u0022,\u0022out\u0022,\u0022override\u0022,\u0022params\u0022,\u0022private\u0022,\u0022protected\u0022,\u0022public\u0022,\u0022readonly\u0022,\u0022record\u0022,\u0022ref\u0022,\u0022return\u0022,\u0022sbyte\u0022,\u0022sealed\u0022,\u0022short\u0022,\u0022sizeof\u0022,\u0022stackalloc\u0022,\u0022static\u0022,\u0022string\u0022,\u0022struct\u0022,\u0022switch\u0022,\u0022this\u0022,\u0022throw\u0022,\u0022true\u0022,\u0022try\u0022,\u0022typeof\u0022,\u0022uint\u0022,\u0022ulong\u0022,\u0022unchecked\u0022,\u0022unsafe\u0022,\u0022ushort\u0022,\u0022using\u0022,\u0022var\u0022,\u0022virtual\u0022,\u0022void\u0022,\u0022volatile\u0022,\u0022while\u0022,\u0022with\u0022,\u0022yield\u0022]);\n        const knownTypes = new Set([\u0022IServiceCollection\u0022,\u0022WebApplication\u0022,\u0022WebApplicationBuilder\u0022,\u0022Task\u0022,\u0022ValueTask\u0022,\u0022IEventHub\u0022,\u0022CoreDataContext\u0022,\u0022ICompletionProviderService\u0022,\u0022IAgentOrchestrationService\u0022,\u0022IModelManagerService\u0022]);\n        const escapeHtml = value =\u003E value.replace(/\u0026/g, \u0022\u0026amp;\u0022).replace(/\u003C/g, \u0022\u0026lt;\u0022).replace(/\u003E/g, \u0022\u0026gt;\u0022);\n        const tokenPattern = /(\\/\\*[\\s\\S]*?\\*\\/|\\/\\/.*?$|@?\u0022(?:\u0022\u0022|\\\\.|[^\u0022\\\\])*\u0022|\u0027(?:\\\\.|[^\u0027\\\\])\u0027|\\b\\d\u002B(?:\\.\\d\u002B)?\\b|\\b[A-Za-z_][A-Za-z0-9_]*\\b)/gm;\n\n        document.querySelectorAll(\u0022code.language-csharp:not([data-highlighted])\u0022).forEach(code =\u003E {\n            const source = code.textContent;\n            let output = \u0022\u0022;\n            let cursor = 0;\n\n            source.replace(tokenPattern, (token, _capture, offset) =\u003E {\n                output \u002B= escapeHtml(source.slice(cursor, offset));\n                let className = \u0022\u0022;\n                if (token.startsWith(\u0022//\u0022) || token.startsWith(\u0022/*\u0022)) className = \u0022syntax-comment\u0022;\n                else if (token.startsWith(\u0027\u0022\u0027) || token.startsWith(\u0027@\u0022\u0027) || token.startsWith(\u0022\u0027\u0022)) className = \u0022syntax-string\u0022;\n                else if (/^\\d/.test(token)) className = \u0022syntax-number\u0022;\n                else if (keywords.has(token)) className = \u0022syntax-keyword\u0022;\n                else if (knownTypes.has(token) || /^[A-Z][A-Za-z0-9_]*$/.test(token)) className = \u0022syntax-type\u0022;\n                output \u002B= className ? \u0060\u003Cspan class=\u0022${className}\u0022\u003E${escapeHtml(token)}\u003C/span\u003E\u0060 : escapeHtml(token);\n                cursor = offset \u002B token.length;\n                return token;\n            });\n\n            output \u002B= escapeHtml(source.slice(cursor));\n            code.innerHTML = output;\n            code.dataset.highlighted = \u0022true\u0022;\n        });\n    }\n\n    queueMicrotask(highlightCSharpSamples);\u003C/script\u003E",
