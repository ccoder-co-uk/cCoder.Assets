{
  "Name": "AppTheming",
  "Key": "ContentManagement",
  "ResourceKey": "ContentManagement",
  "Script": "AppTheming = {\n  init: async function(app, container) {\n    app = app || session.app;\n    container = container || $(\u0022.component[name=AppTheming]\u0022);\n    AppTheming.wireUpEvents(container);\n    AppTheming.hideMissingPreviews(container);\n  },\n\n  wireUpEvents: function(container) {\n    AppTheming.wireUpFileUploading($(\u0022input[name=brand-logo]\u0022, container), $(\u0022img[name=brand-logo-preview]\u0022, container), \u0022Content/CompanyLogo.png\u0022);\n    AppTheming.wireUpFileUploading($(\u0022input[name=project-logo]\u0022, container), $(\u0022img[name=project-logo-preview]\u0022, container), \u0022Content/CompanyLogo2.png\u0022);\n    AppTheming.wireUpFileUploading($(\u0022input[name=animation]\u0022, container), $(\u0022img[name=animation-preview]\u0022, container), \u0022Content/background.gif\u0022);\n  },\n\n  wireUpFileUploading: function(element, preview, path) {\n    element.off(\u0022change.appTheming\u0022).on(\u0022change.appTheming\u0022, function(event) {\n      return AppTheming.handleFileUploadEvent(event, preview, path);\n    });\n  },\n\n  handleFileUploadEvent: async function(event, preview, path) {\n    var files = event.target.files || [];\n    if (files.length \u003E 1) {\n      error(\u0022Select one file only\u0022);\n      return;\n    }\n    if (!files.length) return;\n    AppTheming.handleFileUploadPreview(files[0], preview);\n    await api.file.upload(path, files[0]);\n    notification.success(\u0022[resource_displayname[saved]]\u0022);\n  },\n\n  handleFileUploadPreview: function(file, preview) {\n    var objectUrl = URL.createObjectURL(file);\n    preview.removeClass(\u0022asset-missing\u0022).attr(\u0022src\u0022, objectUrl).one(\u0022load\u0022, function() { URL.revokeObjectURL(objectUrl); });\n  },\n\n  hideMissingPreviews: function(container) {\n    $(\u0022.app-theming-preview img\u0022, container).each(function() {\n      var image = $(this);\n      image.off(\u0022error.appTheming\u0022).on(\u0022error.appTheming\u0022, function() { image.addClass(\u0022asset-missing\u0022); });\n      if (this.complete \u0026\u0026 !this.naturalWidth) image.addClass(\u0022asset-missing\u0022);\n    });\n  }\n};",
  "Content": "\u003Cdiv class=\u0022app-theming-shell\u0022\u003E\n  \u003Csection class=\u0022app-theming-assets\u0022 aria-labelledby=\u0022app-theming-assets-title\u0022\u003E\n    \u003Ch4 id=\u0022app-theming-assets-title\u0022\u003E\u003Cspan class=\u0022k-icon k-i-image\u0022\u003E\u003C/span\u003E Site assets\u003C/h4\u003E\n    \u003Cdiv class=\u0022app-theming-asset-list\u0022\u003E\n      \u003Clabel class=\u0022app-theming-asset\u0022 for=\u0022app-theming-brand-logo\u0022\u003E\n        \u003Cspan class=\u0022app-theming-preview\u0022\u003E\u003Cimg src=\u0022/Api/DMS/Content/CompanyLogo.png\u0022 name=\u0022brand-logo-preview\u0022 alt=\u0022\u0022 /\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022app-theming-asset-copy\u0022\u003E\u003Cstrong\u003EBrand logo\u003C/strong\u003E\u003Csmall\u003ECompany identity shown in the site header.\u003C/small\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022btn btn-sm btn-primary\u0022\u003E\u003Cspan class=\u0022k-icon k-i-upload\u0022\u003E\u003C/span\u003E Replace\u003C/span\u003E\n        \u003Cinput type=\u0022file\u0022 accept=\u0022image/*\u0022 name=\u0022brand-logo\u0022 id=\u0022app-theming-brand-logo\u0022 /\u003E\n      \u003C/label\u003E\n      \u003Clabel class=\u0022app-theming-asset\u0022 for=\u0022app-theming-project-logo\u0022\u003E\n        \u003Cspan class=\u0022app-theming-preview\u0022\u003E\u003Cimg src=\u0022/Api/DMS/Content/CompanyLogo2.png\u0022 name=\u0022project-logo-preview\u0022 alt=\u0022\u0022 /\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022app-theming-asset-copy\u0022\u003E\u003Cstrong\u003EProject logo\u003C/strong\u003E\u003Csmall\u003ESecondary project or product identity.\u003C/small\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022btn btn-sm btn-primary\u0022\u003E\u003Cspan class=\u0022k-icon k-i-upload\u0022\u003E\u003C/span\u003E Replace\u003C/span\u003E\n        \u003Cinput type=\u0022file\u0022 accept=\u0022image/*\u0022 name=\u0022project-logo\u0022 id=\u0022app-theming-project-logo\u0022 /\u003E\n      \u003C/label\u003E\n      \u003Clabel class=\u0022app-theming-asset\u0022 for=\u0022app-theming-animation\u0022\u003E\n        \u003Cspan class=\u0022app-theming-preview\u0022\u003E\u003Cimg src=\u0022/Api/DMS/Content/background.gif\u0022 name=\u0022animation-preview\u0022 alt=\u0022\u0022 /\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022app-theming-asset-copy\u0022\u003E\u003Cstrong\u003EAnimation\u003C/strong\u003E\u003Csmall\u003EOptional animated background asset.\u003C/small\u003E\u003C/span\u003E\n        \u003Cspan class=\u0022btn btn-sm btn-primary\u0022\u003E\u003Cspan class=\u0022k-icon k-i-upload\u0022\u003E\u003C/span\u003E Replace\u003C/span\u003E\n        \u003Cinput type=\u0022file\u0022 accept=\u0022image/gif,image/webp,video/*\u0022 name=\u0022animation\u0022 id=\u0022app-theming-animation\u0022 /\u003E\n      \u003C/label\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n  \u003Csection class=\u0022app-theming-themes\u0022 aria-labelledby=\u0022app-theming-themes-title\u0022\u003E\n    \u003Ch4 id=\u0022app-theming-themes-title\u0022\u003E\u003Cspan class=\u0022k-icon k-i-palette\u0022\u003E\u003C/span\u003E Themes\u003C/h4\u003E\n    \u003Cp class=\u0022app-theming-intro\u0022\u003ECreate and edit the semantic colour, type, border and spacing settings available to this app.\u003C/p\u003E\n    [component[AppThemeList]]\n  \u003C/section\u003E\n\u003C/div\u003E\n\u003Cstyle\u003E\n.component[name=AppTheming] { display:flex; flex:1 1 auto; min-height:0; margin:0; overflow:auto; padding:18px; background:[theme[colours.background]]; }\n.component[name=AppTheming] .app-theming-shell { display:grid; grid-template-columns:minmax(320px, .8fr) minmax(460px, 1.2fr); gap:18px; width:100%; align-content:start; }\n.component[name=AppTheming] section { min-width:0; padding:18px; border:[theme[border.style]]; border-radius:max(8px, [theme[border.radius]]); background:[theme[colours.background]]; box-shadow:0 8px 24px rgba(20,42,72,.08); }\n.component[name=AppTheming] h4 { display:flex; align-items:center; gap:8px; margin:0 0 14px; color:[theme[colours.primary]]; }\n.component[name=AppTheming] .app-theming-intro { margin:-6px 0 14px; color:[theme[colours.text]]; opacity:.72; }\n.component[name=AppTheming] .app-theming-asset-list { display:grid; gap:10px; }\n.component[name=AppTheming] .app-theming-asset { display:grid; grid-template-columns:56px minmax(0,1fr) auto; gap:12px; align-items:center; padding:10px; margin:0; cursor:pointer; border:[theme[border.style]]; border-radius:max(6px, [theme[border.radius]]); transition:border-color .15s ease, box-shadow .15s ease; }\n.component[name=AppTheming] .app-theming-asset:hover { border-color:[theme[colours.secondary]]; box-shadow:0 0 0 3px color-mix(in srgb, [theme[colours.secondary]] 18%, transparent); }\n.component[name=AppTheming] .app-theming-preview { display:flex; align-items:center; justify-content:center; width:56px; height:46px; overflow:hidden; border-radius:5px; background:color-mix(in srgb, [theme[colours.primary]] 7%, [theme[colours.background]]); }\n.component[name=AppTheming] .app-theming-preview img { display:block; max-width:100%; max-height:100%; object-fit:contain; }\n.component[name=AppTheming] .app-theming-preview img.asset-missing { visibility:hidden; }\n.component[name=AppTheming] .app-theming-asset-copy { display:flex; min-width:0; flex-direction:column; color:[theme[colours.text]]; }\n.component[name=AppTheming] .app-theming-asset-copy small { margin-top:2px; opacity:.68; }\n.component[name=AppTheming] input[type=file] { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }\n.component[name=AppTheming] .component[name=AppThemeList] { margin:0; width:100%; }\n@media (max-width: 980px) { .component[name=AppTheming] .app-theming-shell { grid-template-columns:1fr; } }\n\u003C/style\u003E",
  "LastUpdated": "2026-08-08T21:38:49.3707753\u002B00:00",
  "PackageType": "ContentManagement/Component",
  "IncludeInSubSequentImports": false
}