  "Script": "WorkflowAdmin = {\n    init: async function (app, container) {\n        app = app || session.app;\n        container = container || $(\u0022.component[name=WorkflowAdmin]\u0022);\n\n        var initialized = {};\n        var initializeTab = async function (name) {\n            if (initialized[name]) return;\n\n            initialized[name] = true;\n            var pane = $(\u0022[data-workflow-admin-pane=\u0022 \u002B name \u002B \u0022]\u0022, container);\n\n            if (name === \u0022workflows\u0022) {\n                await WorkflowManagement.init(app, $(\u0022.component[name=WorkflowList]\u0022, pane));\n            } else if (name === \u0022scheduling\u0022) {\n                await Scheduling.init(app, $(\u0022.component[name=WorkflowScheduling]\u0022, pane));\n            }\n        };\n\n        $(\u0022[data-bs-toggle=tab]\u0022, container).on(\u0022shown.bs.tab\u0022, async function (event) {\n            await initializeTab($(event.target).data(\u0022workflow-admin-tab\u0022));\n        });\n\n        await initializeTab(\u0022workflows\u0022);\n    }\n}",
  "Content": "\u003Cdiv class=\u0022tab-control workflow-admin-tabs\u0022\u003E\n    \u003Cnav\u003E\n        \u003Cdiv class=\u0022nav nav-tabs\u0022 id=\u0022workflow-admin-nav-tab\u0022 role=\u0022tablist\u0022\u003E\n            \u003Cbutton class=\u0022nav-link bg active\u0022 id=\u0022workflow-admin-workflows-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#workflow-admin-workflows\u0022 data-workflow-admin-tab=\u0022workflows\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022workflow-admin-workflows\u0022 aria-selected=\u0022true\u0022\u003E\n                \u003Cspan class=\u0022k-icon k-i-arrows-swap\u0022\u003E\u003C/span\u003E[resource_displayname[workflows]]\n            \u003C/button\u003E\n            \u003Cbutton class=\u0022nav-link bg\u0022 id=\u0022workflow-admin-scheduling-tab\u0022 data-bs-toggle=\u0022tab\u0022 data-bs-target=\u0022#workflow-admin-scheduling\u0022 data-workflow-admin-tab=\u0022scheduling\u0022 type=\u0022button\u0022 role=\u0022tab\u0022 aria-controls=\u0022workflow-admin-scheduling\u0022 aria-selected=\u0022false\u0022 tabindex=\u0022-1\u0022\u003E\n                \u003Cspan class=\u0022k-icon k-i-clock\u0022\u003E\u003C/span\u003E[resource_displayname[scheduling]]\n            \u003C/button\u003E\n        \u003C/div\u003E\n    \u003C/nav\u003E\n\n    \u003Cdiv class=\u0022tab-content\u0022 id=\u0022workflow-admin-nav-tabContent\u0022\u003E\n        \u003Cdiv class=\u0022tab-pane fade active show\u0022 id=\u0022workflow-admin-workflows\u0022 data-workflow-admin-pane=\u0022workflows\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022workflow-admin-workflows-tab\u0022\u003E\n            [component[WorkflowList]]\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022tab-pane fade\u0022 id=\u0022workflow-admin-scheduling\u0022 data-workflow-admin-pane=\u0022scheduling\u0022 role=\u0022tabpanel\u0022 aria-labelledby=\u0022workflow-admin-scheduling-tab\u0022\u003E\n            [component[WorkflowScheduling]]\n        \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E\n\n\u003Cstyle scoped\u003E\n    .component[name=WorkflowAdmin],\n    .component[name=WorkflowAdmin] \u003E .workflow-admin-tabs,\n    .component[name=WorkflowAdmin] \u003E .workflow-admin-tabs \u003E .tab-content,\n    .component[name=WorkflowAdmin] \u003E .workflow-admin-tabs \u003E .tab-content \u003E .tab-pane.active {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n        min-height: 0;\n        height: 100%;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] \u003E .workflow-admin-tabs \u003E nav {\n        flex: 0 0 auto;\n    }\n\n    .component[name=WorkflowAdmin] \u003E .workflow-admin-tabs \u003E .tab-content \u003E .tab-pane {\n        display: none;\n        min-height: 0;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] .tab-pane.active \u003E .component,\n    .component[name=WorkflowAdmin] .tab-pane.active \u003E .component \u003E .k-grid {\n        display: flex;\n        flex: 1 1 auto;\n        flex-direction: column;\n        min-height: 0;\n        height: 100%;\n        overflow: hidden;\n    }\n\n    .component[name=WorkflowAdmin] .tab-pane.active .k-grid-content,\n    .component[name=WorkflowAdmin] .tab-pane.active .k-grid-content-locked {\n        flex: 1 1 auto;\n        min-height: 0;\n        overflow: auto;\n    }\n\u003C/style\u003E",
