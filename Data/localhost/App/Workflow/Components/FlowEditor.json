  "Script": "var FlowEditor = {\n\tinit: async function(app, container) {\n\t\tlet id = getQueryParameter(\u0022id\u0022);\n\t\tif (!id) {\n\t\t\twindow.location.replace(\u0022/Admin/Workflows\u0022);\n\t\t\treturn;\n\t\t}\n\t\twindow.knownTypes = await api.get(\u0027GetMetadata\u0027);\n\t\twindow.editor = new WorkflowDesigner($(\u0022.component[name=FlowEditor]\u0022), await api.get(\u0022Workflow/FlowDefinition(\u0022 \u002B id \u002B \u0022)\u0022));\n\t}\n}",
  "Content": "\u003Cdiv name=\u0022splitter\u0022\u003E\n   \u003Cdiv class=\u0022flowmenu\u0022\u003E\n   \t  \u003Cdiv name=\u0022actions\u0022 class=\u0022actions\u0022\u003E\n            \u003Cbutton name=\u0022settings\u0022\u003E[resource_displayname[settings]]\u003C/button\u003E\n            \u003Cbutton name=\u0022run\u0022\u003E[resource_displayname[run]]\u003C/button\u003E\n            \u003Cbutton name=\u0022save\u0022\u003E[resource_displayname[save]]\u003C/button\u003E\n       \u003C/div\u003E\n   \u003C/div\u003E\n   \u003Cdiv class=\u0022workspace\u0022\u003E\u003Ccanvas\u003E\u003C/canvas\u003E\u003C/div\u003E\n\u003C/div\u003E\n\n\u003Cscript name=\u0022flowExecution\u0022 type=\u0022template\u0022\u003E\n\u003Cdiv class=\u0022execution\u0022 style=\u0022overflow-x:hidden;\u0022\u003E\n    \u003Cul class=\u0022fieldList options\u0022\u003E\n      \u003Cli\u003E\n         \u003Clabel\u003EOn Execution Complete\u003C/label\u003E\n         \u003Cul class=\u0022value\u0022\u003E\n         \t\u003Cli\u003E\u003Cinput type=\u0022checkbox\u0022 name=\u0022loadInDesigner\u0022 checked\u003E[resource_displayname[loadindesigner]]\u003C/input\u003E\u003C/li\u003E\n        \t\u003Cli\u003E\u003Cinput type=\u0022checkbox\u0022 name=\u0022autoClose\u0022 checked\u003E[resource_displayname[autoclose]]\u003C/input\u003E\u003C/li\u003E\n   \t\t \u003C/ul\u003E\n      \u003C/li\u003E\n   \t\u003C/ul\u003E\n    \u003Cdiv class=\u0022executionConsole\u0022\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/script\u003E\n\n\u003Cscript name=\u0022executionLog\u0022 type=\u0022template\u0022\u003E\n\u003Cdiv class=\u0027execConsole\u0027 name=\u0027execConsole\u0027\u003E\n   \u003Cstyle\u003E\n      .execConsole { overflow: hidden; }\n      .flowConsole { padding: 5px; height: 300px; width: 790px; overflow: auto; }\n      .flowConsole \u003E .message { }\n      .flowConsole \u003E .message \u003E * { vertical-align: top; }\n      .flowConsole \u003E .message \u003E .message { display: inline-block; border: none; max-width: 90%; word-wrap: break-word; }\n      .flowConsole \u003E .message \u003E .time { margin-right: 10px; }\n      .flowConsole \u003E .message.Success \u003E .message { color: green; }\n      .flowConsole \u003E .message.Info \u003E .message { color: green; }\n      .flowConsole \u003E .message.Debug \u003E .message { color: blue; }\n      .flowConsole \u003E .message.Warning \u003E .message { color: #D8A700; }\n      .flowConsole \u003E .message.Error \u003E .message { color: red; }\n      .flowConsole \u003E .message.Fatal \u003E .message { color: red; }\n   \u003C/style\u003E\n   \u003Cdiv class=\u0027flowConsole\u0027\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/script\u003E\n\n\u003Cstyle\u003E\n   .execution \u003E .options { margin-left: 20px; }\n   .execution \u003E .options li { margin-bottom: 10px; }\n   .component[name=FlowEditor], \n    .component[name=FlowEditor]\u003E[name=splitter] { margin: 0; margin-bottom: -10px; border: none; box-shadow: none; width: 100%;  height: 100%; }\n\t.component[name=FlowEditor]\u003E[name=splitter]\u003E.panel { height: 100%; }\n   \n   .flowmenu{ overflow: auto; background: #eae8e8; }\n   .flowmenu \u003E .actions { margin: 10px; margin-bottom: 5px; padding-bottom: 10px; border-bottom: solid 2px #E2721D; }\n   .flowmenu .btn { margin: 8px 2px; }\n   .categorytypes { padding: 8px; }\n   .categorytypes \u003E li { background: #193855; color: #fff; cursor: pointer; }\n   .categorytypes .k-icon { color: #E2721D; }\n   .categorytypes .subtypes { background: #193855; border: 1px solid #000; }\n   .categorytypes .subtypes \u003E li            { margin: 5px; margin-left: -3px; color: #fff; transition: all 0.3s; cursor: grab; }\n   .categorytypes .subtypes \u003E li .k-icon { color: #1c7add; }\n   .categorytypes .subtypes \u003E li:hover  { background: #E2721D; }\n   [data-role=listview] \u003E li                \t{ border-bottom: 1px solid #cbcbcb; }\n\u003C/style\u003E",
